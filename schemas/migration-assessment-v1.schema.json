{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqc-scan.local/schemas/migration-assessment-v1.schema.json",
  "title": "Saved-evidence local migration decision assessment v1",
  "description": "Adopted D1/D2/D4 output. Shape is not authenticity, policy usefulness or whole-system safety. Actual input/context/target/claim/source/candidate binding is additionally validated by core.",
  "$defs": {
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "construction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "standardization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "quantum": {
          "enum": [
            "vulnerable",
            "designed_resistant",
            "generic_search",
            "unknown"
          ]
        },
        "purpose": {
          "enum": [
            "key_establishment",
            "signature",
            "encryption",
            "hash",
            "unknown"
          ]
        },
        "parameters_known": {
          "type": "boolean"
        },
        "classical_concerns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 16
        },
        "attack_models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attack": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "exponent_numerator": {
                "type": "integer",
                "minimum": 1
              },
              "exponent_denominator": {
                "type": "integer",
                "minimum": 1
              },
              "assumption": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "attack",
              "exponent_numerator",
              "exponent_denominator",
              "assumption"
            ]
          },
          "maxItems": 4
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "assessment": {
                "$ref": "#/$defs/algorithm"
              }
            },
            "required": [
              "role",
              "assessment"
            ]
          },
          "maxItems": 4
        },
        "combiner_assessment": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "identifier",
        "construction",
        "standardization",
        "quantum",
        "purpose",
        "parameters_known",
        "classical_concerns",
        "attack_models",
        "components",
        "combiner_assessment",
        "source_ids"
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "enum": [
            "operator_claim",
            "external_review_claim"
          ]
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "asserted_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "reference_id": {
          "type": "string",
          "pattern": "^[!-~]{1,128}$"
        }
      },
      "required": [
        "source_kind",
        "actor_id",
        "asserted_at"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^migration_claim-v1-[0-9a-f]{64}$"
        },
        "context_pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "field": {
          "enum": [
            "applicability",
            "use_case",
            "usage_state",
            "business_critical",
            "confidential",
            "historical_ciphertext",
            "confidentiality_until",
            "signature_verification_until",
            "migration_lead_seconds",
            "deadline",
            "support.runtime",
            "support.provider",
            "support.parameters",
            "support.peer",
            "support.protocol",
            "support.jose",
            "support.verifiers",
            "support.pki",
            "migration_target",
            "migration_goal_month"
          ]
        },
        "state": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "value": {},
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "freshness": {
          "enum": [
            "active",
            "stale",
            "not_yet_effective",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "context_pointer",
        "field",
        "state",
        "provenance",
        "freshness"
      ],
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "known"
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "properties": {
            "state": {
              "const": "unknown"
            }
          },
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "const": "applicability"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "applicable",
                  "not_applicable"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "use_case"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "key_establishment",
                  "signature",
                  "jwt",
                  "pki",
                  "encryption",
                  "hashing"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "usage_state"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "active",
                  "planned",
                  "test_only",
                  "unused"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "business_critical"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "confidential"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "historical_ciphertext"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "confidentiality_until"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "signature_verification_until"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "migration_lead_seconds"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 315576000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "deadline"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "none"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "at"
                      },
                      "at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "reference_id": {
                        "type": "string",
                        "pattern": "^[!-~]{1,128}$"
                      },
                      "scope_reason": {
                        "enum": [
                          "organization_policy",
                          "contractual_requirement"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "at",
                      "reference_id",
                      "scope_reason"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "support.runtime"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "support.provider"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "support.parameters"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "support.peer"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "support.protocol"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "support.jose"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "support.verifiers"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "support.pki"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "migration_target"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/configuration"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "migration_goal_month"
              },
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                "not": {
                  "pattern": "^0000-"
                }
              }
            }
          }
        }
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use_case": {
          "enum": [
            "signature",
            "jwt",
            "pki",
            "key_establishment",
            "encryption",
            "hashing"
          ]
        },
        "algorithm": {
          "enum": [
            "ML-DSA",
            "ML-KEM",
            "AES",
            "SHA-256"
          ]
        },
        "parameters": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "use_case",
        "algorithm",
        "parameters"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pqc-scan.migration-assessment"
    },
    "version": {
      "const": 1
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "inventory-v1",
            "tls-v1",
            "ssh-offers-v1",
            "ssh-kex-v1"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "const": 1
        },
        "collection_time": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "type": "string",
          "pattern": "^scan-v1-[0-9a-f]{64}$"
        },
        "attempt_id": {
          "const": 1
        },
        "protocol": {
          "enum": [
            "tls",
            "ssh_offers",
            "ssh_kex"
          ]
        }
      },
      "required": [
        "format",
        "sha256",
        "schema_version",
        "collection_time"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "inventory-v1"
              }
            }
          },
          "then": {
            "required": [
              "run_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "attempt_id"
                  ]
                },
                {
                  "required": [
                    "protocol"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "attempt_id",
              "protocol"
            ],
            "not": {
              "required": [
                "run_id"
              ]
            }
          }
        }
      ]
    },
    "context": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "pqc-scan.migration-context"
            },
            "version": {
              "const": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "format",
            "version",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "migration-facts-v1"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "migration-decision-v1"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "decision_table"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^migration_target-v1-[0-9a-f]{64}$"
          },
          "source_ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^scan-v1-[0-9a-f]{64}$"
              },
              "observation_id": {
                "type": "string",
                "pattern": "^observation-v1-[0-9a-f]{64}$"
              },
              "root_asset_id": {
                "type": "string",
                "pattern": "^asset-v1-[0-9a-f]{64}$"
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "attempt_id": {
                "const": 1
              },
              "detail_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "certificate_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "spki_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "dependency_provenance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "protocol_version": {
                "$ref": "#/$defs/registry"
              },
              "cipher_suite": {
                "$ref": "#/$defs/registry"
              },
              "key_exchange_group": {
                "$ref": "#/$defs/registry"
              },
              "not_before_unix": {
                "type": "integer"
              },
              "not_after_unix": {
                "type": "integer"
              }
            },
            "required": [
              "role"
            ]
          },
          "technical": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "identifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "construction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "standardization": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "quantum": {
                "enum": [
                  "vulnerable",
                  "designed_resistant",
                  "generic_search",
                  "unknown"
                ]
              },
              "purpose": {
                "enum": [
                  "key_establishment",
                  "signature",
                  "encryption",
                  "hash",
                  "unknown"
                ]
              },
              "parameters_known": {
                "type": "boolean"
              },
              "classical_concerns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "maxItems": 16
              },
              "attack_models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "attack": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "exponent_numerator": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "exponent_denominator": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "assumption": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "attack",
                    "exponent_numerator",
                    "exponent_denominator",
                    "assumption"
                  ]
                },
                "maxItems": 4
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "assessment": {
                      "$ref": "#/$defs/algorithm"
                    }
                  },
                  "required": [
                    "role",
                    "assessment"
                  ]
                },
                "maxItems": 4
              },
              "combiner_assessment": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "encoding_assurance": {
                "enum": [
                  "known",
                  "unknown"
                ]
              },
              "protocol_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "identifier",
              "construction",
              "standardization",
              "quantum",
              "purpose",
              "parameters_known",
