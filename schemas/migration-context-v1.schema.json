          }
        },
        "required": [
          "target_id",
          "system_id"
        ]
      }
    },
    "organization_defaults": {
      "$ref": "#/$defs/claims"
    },
    "references": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
