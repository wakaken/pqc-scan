{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "TLS_VERSION_1_0",
              "shortDescription": {
                "text": "TLS"
              },
              "fullDescription": {
                "text": "TLS 1.0 name referenced; effective configuration and runtime use are not established."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "TLS_VERSION_1_0",
          "level": "error",
          "message": {
            "text": "TLS 1.0 name referenced; effective configuration and runtime use are not established. | migration_hint=Prefer TLS 1.3; restrict to TLS 1.3 when all peers support it. Retain securely configured TLS 1.2 only for a documented interoperability need. Disable TLS 1.0 and 1.1. | next_actions=Review the TLS reference before changing effective settings (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tls.conf"
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Prefer TLS 1.3; restrict to TLS 1.3 when all peers support it. Retain securely configured TLS 1.2 only for a documented interoperability need. Disable TLS 1.0 and 1.1.",
            "recommended_actions": [
