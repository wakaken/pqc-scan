          "level": "warning",
          "message": {
            "text": "OpenSSL dependency detected. | migration_hint=Review the OpenSSL PQC roadmap. | next_actions=Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
