        {
          "ruleId": "DEP_OPENSSL",
          "level": "warning",
          "message": {
            "text": "OpenSSL dependency detected. | migration_hint=Review the OpenSSL PQC roadmap. | next_actions=Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Cargo.lock"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Review the OpenSSL PQC roadmap.",
            "recommended_actions": [
              "Track PQC readiness of dependent libraries (planned)"
            ]
          }
        },
        {
          "ruleId": "DEP_RUST_OPENSSL",
          "level": "warning",
          "message": {
            "text": "Rust TLS/crypto dependency detected. | migration_hint=Track PQC migration options for Rust openssl/rustls crypto stacks. | next_actions=Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Cargo.lock"
                },
                "region": {
