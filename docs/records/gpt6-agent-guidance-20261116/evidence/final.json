  "validatorSource": "import difflib\nimport hashlib\nimport html\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport re\nimport subprocess\nimport sys\nfrom urllib.parse import unquote, urlsplit\n\nROOT = Path.cwd()\nRECORD = Path('docs/records/gpt6-agent-guidance-20261116')\nOUT = RECORD / 'evidence' / (sys.argv[1] + '.json')\nBASE = '929caed4caf36461ee6d7fc9a81491807b2fdcb4'\nGUIDANCE = ['AGENTS.md', 'docs/agent/VERIFICATION.md', 'prompts/REVIEWER.md']\nUNCHANGED = ['docs/agent/REVIEWS.md', 'docs/agent/REPORTS.md',\n             'docs/TASK-LIFECYCLE.md', 'docs/BEST-PRACTICES.md',\n             'docs/PATTERNS.md', 'docs/MISTAKES.md', 'tasks/README.md',\n             'docs/DECISIONS.md', 'docs/RESTART-LOOP.md', 'README.md',\n             'README.ja.md', 'docs/architecture.md', 'docs/rules-reference.md',\n             '.github/workflows/pqc-scan.yml', '.github/workflows/release.yml',\n             'rust-toolchain.toml', 'scripts/package-release.py',\n             'tests/quality/README.md', 'tests/quality/run.py',\n             'shell/prepare-code-scanning.cjs']\nerrors = []\ndef check(condition, message):\n    if not condition:\n        errors.append(message)\ndef git(*args):\n    return subprocess.check_output(['git', *args], text=True)\ndef baseline(name):\n    return subprocess.check_output(['git', 'show', BASE + ':' + name])\ndef digest(data):\n    return hashlib.sha256(data).hexdigest()\ndef without_fences(text):\n    return re.sub(r'^(`{3,}|~{3,})[^\\n]*\\n.*?^\\1\\s*$', '', text,\n                  flags=re.MULTILINE | re.DOTALL)\ndef anchors(text):\n    text = without_fences(text)\n    result = set(re.findall(r'\\bid=[\"\\']([^\"\\']+)[\"\\']', text))\n    seen = {}\n    for line in text.splitlines():\n        m = re.match(r'^#{1,6}\\s+(.+?)(?:\\s+#+)?\\s*$', line)\n        if not m:\n            continue\n        title = html.unescape(re.sub(r'<[^>]+>', '', m[1])).lower()\n        slug = re.sub(r'[^\\w\\- ]', '', title).replace(' ', '-')\n        n = seen.get(slug, 0)\n        seen[slug] = n + 1\n        result.add(slug + (f'-{n}' if n else ''))\n    return result\ndef resolve_link(source, link):\n    parsed = urlsplit(link)\n    if parsed.scheme or parsed.netloc:\n        return None\n    target = (source.parent / unquote(parsed.path)).resolve() if parsed.path else source.resolve()\n    if not target.exists():\n        return 'missing target'\n    if parsed.fragment and (not target.is_file() or\n       unquote(parsed.fragment) not in anchors(target.read_text())):\n        return 'missing anchor'\n    return None\n\n# Validator controls use real repository files and in-memory heading examples.\ncontrols = {\n    'missing_target_rejected': resolve_link(ROOT / 'AGENTS.md', 'absent-guidance-test-file.md') == 'missing target',\n    'missing_anchor_rejected': resolve_link(ROOT / 'AGENTS.md', 'README.md#absent-guidance-test-anchor') == 'missing anchor',\n    'explicit_html_anchor_accepted': resolve_link(ROOT / 'AGENTS.md', 'README.md#features') is None,\n    'japanese_readme_anchor_accepted': resolve_link(ROOT / 'AGENTS.md', 'README.ja.md#features') is None,\n    'duplicate_heading_anchor': anchors('# Same\\n## Same\\n') == {'same', 'same-1'},\n    'fenced_heading_excluded': anchors('```md\\n# Example\\n```\\n# Actual\\n') == {'actual'},\n}\nfor name, passed in controls.items():\n    check(passed, 'validator control: ' + name)\n\nbindings = {}\nmetrics = {}\nfor name in GUIDANCE + UNCHANGED:\n    before = baseline(name)\n    after = Path(name).read_bytes()\n    bindings[name] = {'beforeSha256': digest(before), 'afterSha256': digest(after)}\n    if name in GUIDANCE:\n        metrics[name] = {'beforeLines': len(before.splitlines()),\n                         'afterLines': len(after.splitlines()),\n                         'beforeBytes': len(before), 'afterBytes': len(after)}\n        removed = [line for line in difflib.ndiff(before.decode().splitlines(), after.decode().splitlines())\n                   if line.startswith('- ')]\n        check(not removed, 'original lines removed: ' + name)\n        check(re.findall(r'^#{1,6} .+$', before.decode(), re.M) ==\n              re.findall(r'^#{1,6} .+$', after.decode(), re.M), 'headings changed: ' + name)\n        check(re.findall(r'```.*?```', before.decode(), re.S) ==\n              re.findall(r'```.*?```', after.decode(), re.S), 'command fences changed: ' + name)\n    else:\n        check(before == after, 'preserved file changed: ' + name)\n\nold = baseline('AGENTS.md').decode()\nnew = Path('AGENTS.md').read_text()\nfor title in ['Required References by Activity', 'Workflow and Review Limits',\n              'Security and Compatibility', 'Documentation']:\n    pattern = r'(?ms)^## ' + re.escape(title) + r'\\n.*?(?=^## |\\Z)'\n    check(re.search(pattern, old).group() == re.search(pattern, new).group(),\n          'core block changed: ' + title)\n\nchanged = git('diff', '--name-only', BASE).splitlines()\nuntracked = git('ls-files', '--others', '--exclude-standard').splitlines()\nfor name in changed + untracked:\n    check(name in GUIDANCE or name.startswith(RECORD.as_posix() + '/'),\n          'out-of-scope file: ' + name)\ncheck(git('branch', '--show-current').strip() == 'codex/gpt6-agent-guidance', 'wrong branch')\ncheck(git('rev-parse', 'HEAD').strip() == BASE, 'baseline HEAD changed')\n\n# Seed this run's output so report links can be checked before writing results.\nOUT.write_text('{}\\n')\nfiles = GUIDANCE + [p for p in UNCHANGED if p.endswith('.md')]\nfiles += [p.as_posix() for p in RECORD.rglob('*.md')]\nlinks = []\nfor name in files:\n    text = without_fences(Path(name).read_text())\n    for match in re.finditer(r'\\[[^\\]]*\\]\\(([^)]+)\\)', text):\n        link = match[1]\n        parsed = urlsplit(link)\n        if parsed.scheme or parsed.netloc:\n            continue\n        issue = resolve_link(ROOT / name, link)\n        links.append({'file': name, 'target': link, 'result': issue or 'pass'})\n        check(issue is None, f'{name}: {link}: {issue}')\n\ndiff_check = subprocess.run(['git', 'diff', '--check'], capture_output=True, text=True)\ncheck(diff_check.returncode == 0, 'git diff --check: ' + diff_check.stdout + diff_check.stderr)\nresult = {\n    'baseline': BASE, 'head': git('rev-parse', 'HEAD').strip(),\n    'branch': git('branch', '--show-current').strip(), 'workspace': str(ROOT),\n    'python': platform.python_version(), 'platform': platform.platform(),\n    'command': ['python3', 'target/agent-guidance-validation/check.py', sys.argv[1]],\n    'validatorSha256': digest(Path(__file__).read_bytes()),\n    'validatorSource': Path(__file__).read_text(),\n    'sourceBindings': bindings, 'metrics': metrics, 'validatorControls': controls,\n    'changedTracked': changed, 'untracked': untracked,\n    'linksChecked': len(links), 'links': links,\n    'diffCheck': {'command': ['git', 'diff', '--check'], 'exitCode': diff_check.returncode,\n                  'stdout': diff_check.stdout, 'stderr': diff_check.stderr},\n    'guidanceDiffSha256': digest(git('diff', BASE, '--', *GUIDANCE).encode()),\n    'errors': errors, 'exitCode': int(bool(errors)),\n    'scope': 'Structural checks only; semantic scenario assessment is in REPORT.md; no runtime performance claims',\n}\nOUT.write_text(json.dumps(result, indent=2, ensure_ascii=False) + '\\n')\nprint(json.dumps({k: result[k] for k in ['linksChecked', 'metrics', 'validatorControls', 'errors', 'exitCode']}, indent=2))\nsys.exit(result['exitCode'])\n",
