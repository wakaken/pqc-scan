+                 '.tsx': 'TSX', '.py': 'Python', '.rs': 'Rust', '.rb': 'Ruby',
+                 '.swift': 'Unsupported Swift', '.php': 'PHP', '.phtml': 'PHP',
+                 '.inc': 'Unresolved INC', '.cs': 'C#', '.c': 'C', '.cc': 'C++',
+                 '.cpp': 'C++', '.cxx': 'C++', '.hpp': 'C++', '.hxx': 'C++',
