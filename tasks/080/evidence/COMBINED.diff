+        "private=PRIVATE080",
+        "X-Wing",
+        "https://user:secret@invalid.example",
+    ] {
+        assert!(C::tls_groups(value).is_none());
+        assert!(C::provider(value).is_none());
+        assert!(C::property(value).is_none());
+    }
+}
