diff --git a/crates/pqc_scan_detectors/src/source_facts/csharp.rs b/crates/pqc_scan_detectors/src/source_facts/csharp.rs
new file mode 100644
index 0000000..c01fcb5
--- /dev/null
+++ b/crates/pqc_scan_detectors/src/source_facts/csharp.rs
@@ -0,0 +1,470 @@
+//! Bounded C# API identities and operations; all captured facts remain references.
+mod names;
+mod values;
+use super::{builtin, context::Context, Facts};
+use names::{in_error, Names};
+use pqc_scan_rules::RuleSet;
+use tree_sitter::Node;
+use values::Values;
+const API: &str = "CSHARP_CRYPTO_API";
+const PQC: &str = "CSHARP_PQC_API";
+const REFERENCE: &str = "CSHARP_CRYPTO_REFERENCE";
+const STD: &str = "System.Security.Cryptography.";
+const BC: &str = "Org.BouncyCastle.Crypto.";
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Kind {
+    Classical(&'static str),
+    Pqc(&'static str),
+    Construction(&'static str),
+    Generator(&'static str),
+    Engine(&'static str),
+    Encap,
+    Decap,
+    Signer(&'static str),
+    OfficialWrapper,
+    CommunityWrapper,
+    BcTls,
+}
+#[derive(Clone, Debug)]
+struct Key {
+    kind: Kind,
+    algorithm: String,
+}
+impl Kind {
+    fn family(self) -> Option<&'static str> {
+        match self {
+            Self::Classical(a)
+            | Self::Pqc(a)
+            | Self::Construction(a)
+            | Self::Generator(a)
+            | Self::Engine(a)
+            | Self::Signer(a) => Some(a),
+            Self::Encap | Self::Decap => Some("ML-KEM"),
+            Self::OfficialWrapper | Self::CommunityWrapper | Self::BcTls => None,
+        }
+    }
+    fn id(self) -> &'static str {
+        if matches!(
+            self,
+            Self::OfficialWrapper | Self::CommunityWrapper | Self::BcTls
+        ) {
+            REFERENCE
+        } else if self.family().is_some_and(|s| {
+            s.starts_with("ML-")
+                || s.starts_with("SLH-")
+                || matches!(s, "CompositeMLKem" | "CompositeMLDsa" | "HPKE")
+        }) {
+            PQC
+        } else {
+            API
+        }
+    }
+    fn key(self) -> Option<Key> {
+        Some(Key {
+            kind: self,
+            algorithm: self.family()?.into(),
+        })
+    }
+}
+fn class_info(name: &str) -> Option<Kind> {
+    if name == "dotnetOQS" || name.starts_with("dotnetOQS.") {
+        return Some(Kind::OfficialWrapper);
+    }
+    if name == "OpenForge.Cryptography.LibOqs" || name.starts_with("OpenForge.Cryptography.LibOqs.")
+    {
+        return Some(Kind::CommunityWrapper);
+    }
+    if name == "Org.BouncyCastle.Tls" || name.starts_with("Org.BouncyCastle.Tls.") {
+        return Some(Kind::BcTls);
+    }
+    if let Some(name) = name.strip_prefix(STD) {
+        return Some(match name {
+            "RSA" | "RSACryptoServiceProvider" | "RSACng" | "RSAOpenSsl" => Kind::Classical("RSA"),
+            "DSA" | "DSACryptoServiceProvider" | "DSACng" | "DSAOpenSsl" => Kind::Classical("DSA"),
+            "ECDsa" | "ECDsaCng" | "ECDsaOpenSsl" => Kind::Classical("EC"),
+            "ECDiffieHellman" | "ECDiffieHellmanCng" | "ECDiffieHellmanOpenSsl" => {
+                Kind::Classical("ECDH")
+            }
+            "MLKem" => Kind::Pqc("ML-KEM"),
+            "MLDsa" => Kind::Pqc("ML-DSA"),
+            "SlhDsa" => Kind::Pqc("SLH-DSA"),
+            "CompositeMLKem" => Kind::Construction("CompositeMLKem"),
+            "CompositeMLDsa" => Kind::Construction("CompositeMLDsa"),
+            "Hpke" => Kind::Construction("HPKE"),
+            _ => return None,
+        });
+    }
+    Some(match name.strip_prefix(BC)? {
+        "Generators.RsaKeyPairGenerator" => Kind::Generator("RSA"),
+        "Generators.DsaKeyPairGenerator" => Kind::Generator("DSA"),
+        "Generators.ECKeyPairGenerator" => Kind::Generator("EC"),
+        "Generators.MLKemKeyPairGenerator" => Kind::Generator("ML-KEM"),
+        "Generators.MLDsaKeyPairGenerator" => Kind::Generator("ML-DSA"),
+        "Generators.SlhDsaKeyPairGenerator" => Kind::Generator("SLH-DSA"),
+        "Engines.RsaEngine" => Kind::Engine("RSA"),
+        "Signers.DsaSigner" => Kind::Signer("DSA"),
+        "Signers.ECDsaSigner" => Kind::Signer("EC"),
+        "Agreement.ECDHBasicAgreement" => Kind::Engine("ECDH"),
+        "Kems.MLKemEncapsulator" => Kind::Encap,
+        "Kems.MLKemDecapsulator" => Kind::Decap,
+        "Signers.MLDsaSigner" => Kind::Signer("ML-DSA"),
+        "Signers.SlhDsaSigner" => Kind::Signer("SLH-DSA"),
+        _ => return None,
+    })
+}
+fn parameter(name: &str) -> Option<String> {
+    let (kind, value, bc) = if let Some(s) = name.strip_prefix(STD) {
+        let (k, v) = s.split_once('.')?;
+        (k, v, false)
+    } else {
+        let s = name.strip_prefix(BC)?.strip_prefix("Parameters.")?;
+        let (k, v) = s.split_once('.')?;
+        (k, v, true)
+    };
+    let family = match kind {
+        "MLKemAlgorithm" if !bc => "ML-KEM",
+        "MLKemParameters" if bc => "ML-KEM",
+        "MLDsaAlgorithm" if !bc => "ML-DSA",
+        "MLDsaParameters" if bc => "ML-DSA",
+        "SlhDsaAlgorithm" if !bc => "SLH-DSA",
+        "SlhDsaParameters" if bc => "SLH-DSA",
+        _ => return None,
+    };
+    let set = if bc {
+        match family {
+            "ML-KEM" => value.strip_prefix("ml_kem_")?,
+            "ML-DSA" => value.strip_prefix("ml_dsa_")?,
+            _ => value.strip_prefix("slh_dsa_")?,
+        }
+    } else {
+        match family {
+            "ML-KEM" => value.strip_prefix("MLKem")?,
+            "ML-DSA" => value.strip_prefix("MLDsa")?,
+            _ => value.strip_prefix("SlhDsa")?,
+        }
+    };
+    let name = match family {
+        "ML-KEM" if matches!(set, "512" | "768" | "1024") => format!("ML-KEM-{set}"),
+        "ML-DSA" if matches!(set, "44" | "65" | "87") => format!("ML-DSA-{set}"),
+        "SLH-DSA" => {
+            let (hash, set) = if bc {
+                set.strip_prefix("sha2_")
+                    .map(|s| ("SHA2", s))
+                    .or_else(|| set.strip_prefix("shake_").map(|s| ("SHAKE", s)))?
+            } else {
+                set.strip_prefix("Sha2_")
+                    .map(|s| ("SHA2", s))
+                    .or_else(|| set.strip_prefix("Shake").map(|s| ("SHAKE", s)))?
+            };
+            if !matches!(set, "128s" | "128f" | "192s" | "192f" | "256s" | "256f") {
+                return None;
+            }
+            format!("SLH-DSA-{hash}-{set}")
+        }
+        _ => return None,
+    };
+    Some(name)
+}
+fn parameter_family(name: &str) -> Option<&'static str> {
+    let (typ, _) = name.rsplit_once('.')?;
+    match typ {
+        "System.Security.Cryptography.MLKemAlgorithm"
+        | "Org.BouncyCastle.Crypto.Parameters.MLKemParameters" => Some("ML-KEM"),
+        "System.Security.Cryptography.MLDsaAlgorithm"
+        | "Org.BouncyCastle.Crypto.Parameters.MLDsaParameters" => Some("ML-DSA"),
+        "System.Security.Cryptography.SlhDsaAlgorithm"
+        | "Org.BouncyCastle.Crypto.Parameters.SlhDsaParameters" => Some("SLH-DSA"),
+        _ => None,
+    }
+}
+fn compatible(family: &str, selected: &str) -> bool {
+    selected == family
+        || selected
+            .strip_prefix(family)
+            .is_some_and(|s| s.starts_with('-'))
+}
+fn factory_method(kind: Kind, method: &str) -> bool {
+    match kind {
+        Kind::Classical(_) => matches!(
+            method,
+            "Create" | "CreateFromPem" | "CreateFromEncryptedPem"
+        ),
+        Kind::Pqc(_) => matches!(
+            method,
+            "GenerateKey"
+                | "ImportFromPem"
+                | "ImportFromEncryptedPem"
+                | "ImportSubjectPublicKeyInfo"
+                | "ImportPkcs8PrivateKey"
+                | "ImportEncryptedPkcs8PrivateKey"
+                | "ImportPrivateSeed"
+                | "ImportDecapsulationKey"
+                | "ImportEncapsulationKey"
+                | "ImportMLDsaPrivateKey"
+                | "ImportMLDsaPublicKey"
+                | "ImportSlhDsaPrivateKey"
+                | "ImportSlhDsaPublicKey"
+        ),
+        Kind::Construction(_) => true,
+        _ => false,
+    }
+}
+fn operation(kind: Kind, method: &str) -> bool {
+    match kind {
+        Kind::Classical("RSA") => matches!(
+            method,
+            "SignData" | "VerifyData" | "SignHash" | "VerifyHash" | "Encrypt" | "Decrypt"
+        ),
+        Kind::Classical("EC" | "DSA") => matches!(
+            method,
+            "SignData"
+                | "VerifyData"
+                | "SignHash"
+                | "VerifyHash"
+                | "CreateSignature"
+                | "VerifySignature"
+        ),
+        Kind::Classical("ECDH") => matches!(
+            method,
+            "DeriveKeyMaterial"
+                | "DeriveKeyFromHash"
+                | "DeriveKeyFromHmac"
+                | "DeriveRawSecretAgreement"
+        ),
+        Kind::Pqc("ML-KEM") => matches!(method, "Encapsulate" | "Decapsulate"),
+        Kind::Pqc(_) => matches!(method, "SignData" | "VerifyData"),
+        Kind::Generator(_) => method == "GenerateKeyPair",
+        Kind::Signer(_) => matches!(method, "GenerateSignature" | "VerifySignature"),
+        Kind::Encap => method == "Encapsulate",
+        Kind::Decap => method == "Decapsulate",
+        Kind::Engine("RSA") => method == "ProcessBlock",
+        Kind::Engine("ECDH") => method == "CalculateAgreement",
+        _ => false,
+    }
+}
+fn crypto_operation_name(method: &str) -> bool {
+    matches!(
+        method,
+        "SignData"
+            | "VerifyData"
+            | "SignHash"
+            | "VerifyHash"
+            | "Encrypt"
+            | "Decrypt"
+            | "Encapsulate"
+            | "Decapsulate"
+            | "GenerateSignature"
+            | "VerifySignature"
+            | "GenerateKeyPair"
+            | "DeriveKeyMaterial"
+            | "DeriveRawSecretAgreement"
+            | "CalculateAgreement"
+    )
+}
+fn emit(
+    facts: &mut Facts,
+    rules: &RuleSet,
+    node: Node<'_>,
+    kind: Kind,
+    algorithm: Option<&str>,
+    reason: &'static str,
+) {
+    if !rules.get(kind.id()).is_some_and(builtin) {
+        return;
+    }
+    let names: Vec<_> = algorithm.into_iter().collect();
+    facts.source_api(
+        kind.id(),
+        node,
+        reason,
+        &names,
+        match kind {
+            Kind::OfficialWrapper => "C# obsolete official dotnetOQS wrapper reference",
+            Kind::CommunityWrapper => "C# OpenForge community OQS wrapper reference",
+            Kind::BcTls => "C# Bouncy Castle TLS library reference",
+            _ => "C# cryptographic source reference",
+        },
+    );
+}
+pub(super) fn inspect(ctx: &Context<'_, '_>, facts: &mut Facts, rules: &RuleSet) {
+    let names = Names::new(ctx);
+    if ctx.truncated.get() {
+        return;
+    }
+    let values = Values::new(&names);
+    if ctx.truncated.get() {
+        return;
+    }
+    for (node, target) in &names.references {
+        if !names.external_path(target) {
+            continue;
+        }
+        if let Some(kind) = class_info(target) {
+            emit(
+                facts,
+                rules,
+                *node,
+                kind,
+                kind.family(),
+                "qualified_type_or_wrapper_reference",
+            );
+        }
+    }
+    for n in &ctx.nodes {
+        if !names.charge() {
+            break;
+        }
+        if in_error(*n, ctx) {
+            continue;
+        }
+        match n.kind() {
+            "object_creation_expression" => {
+                if let Some(key) = values.key(*n) {
+                    emit(
+                        facts,
+                        rules,
+                        *n,
+                        key.kind,
+                        Some(&key.algorithm),
+                        "qualified_constructor_reference",
+                    );
+                } else if let Some(kind) = n
+                    .child_by_field_name("type")
+                    .and_then(|t| unique_kind(&names, t, true))
+                    .filter(|k| k.family().is_none())
+                {
+                    emit(facts, rules, *n, kind, None, "qualified_library_reference");
+                }
+            }
+            "invocation_expression" => {
+                let Some(function) = n.child_by_field_name("function") else {
+                    continue;
+                };
+                if let Some(key) = values.factory(*n, 0) {
+                    emit(
+                        facts,
+                        rules,
+                        *n,
+                        key.kind,
+                        Some(&key.algorithm),
+                        "qualified_factory_or_import_reference",
+                    );
+                    continue;
+                }
+                if function.kind() == "member_access_expression" {
+                    let (Some(object), Some(method)) = (
+                        function.child_by_field_name("expression"),
+                        function.child_by_field_name("name"),
+                    ) else {
+                        continue;
+                    };
+                    let Some(method) = names.path(method) else {
+                        names.partial.set(true);
+                        continue;
+                    };
+                    if let Some(key) = values.key(object) {
+                        if operation(key.kind, &method) {
+                            emit(
+                                facts,
+                                rules,
+                                *n,
+                                key.kind,
+                                Some(&key.algorithm),
+                                "bounded_local_receiver_reference",
+                            );
+                        } else if crypto_operation_name(&method) {
+                            names.partial.set(true);
+                        }
+                    } else if crypto_operation_name(&method) {
+                        names.partial.set(true);
+                    }
+                } else if !matches!(
+                    function.kind(),
+                    "identifier" | "qualified_name" | "alias_qualified_name"
+                ) {
+                    names.partial.set(true);
+                }
+            }
+            "member_access_expression" => {
+                if inside_call(*n, ctx) {
+                    continue;
+                }
+                let paths = names.resolve(*n, false);
+                let mut selected: Vec<_> = paths.iter().filter_map(|s| parameter(s)).collect();
+                selected.sort();
+                selected.dedup();
+                let mut families: Vec<_> =
+                    paths.iter().filter_map(|s| parameter_family(s)).collect();
+                families.sort();
+                families.dedup();
+                if selected.len() == 1 {
+                    emit(
+                        facts,
+                        rules,
+                        *n,
+                        Kind::Pqc(families.first().copied().unwrap_or("ML-KEM")),
+                        Some(&selected[0]),
+                        "qualified_parameter_reference",
+                    );
+                } else if families.len() == 1 {
+                    names.partial.set(true);
+                    emit(
+                        facts,
+                        rules,
+                        *n,
+                        Kind::Pqc(families[0]),
+                        Some(families[0]),
+                        "unresolved_parameter_reference",
+                    );
+                }
+            }
+            "parameter" | "variable_declaration" => {
+                if let Some(typ) = n.child_by_field_name("type") {
+                    if let Some(kind) = unique_kind(&names, typ, true) {
+                        emit(
+                            facts,
+                            rules,
+                            typ,
+                            kind,
+                            kind.family(),
+                            "qualified_type_reference",
+                        );
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    facts.partial |= names.partial.get();
+}
+fn unique_kind(names: &Names<'_, '_, '_>, node: Node<'_>, ignore_vars: bool) -> Option<Kind> {
+    let mut found: Vec<_> = names
+        .resolve(node, ignore_vars)
+        .iter()
+        .filter_map(|s| class_info(s))
+        .collect();
+    found.dedup();
+    (found.len() == 1).then(|| found[0])
+}
+fn inside_call(mut node: Node<'_>, ctx: &Context<'_, '_>) -> bool {
+    for _ in 0..64 {
+        let Some(p) = node.parent() else {
+            return false;
+        };
+        if matches!(
+            p.kind(),
+            "invocation_expression" | "object_creation_expression"
+        ) {
+            return true;
+        }
+        if matches!(
+            p.kind(),
+            "expression_statement" | "variable_declarator" | "return_statement" | "block"
+        ) {
+            return false;
+        }
+        node = p;
+    }
+    ctx.limit("csharp_ancestor_depth", 64, 64);
+    true
+}
diff --git a/crates/pqc_scan_detectors/src/source_facts/csharp/names.rs b/crates/pqc_scan_detectors/src/source_facts/csharp/names.rs
new file mode 100644
index 0000000..c06ce51
--- /dev/null
+++ b/crates/pqc_scan_detectors/src/source_facts/csharp/names.rs
@@ -0,0 +1,413 @@
+//! Case-sensitive, file-local C# names. No project-wide lookup or using expansion.
+use super::super::context::{children, Context};
+use std::{cell::Cell, collections::HashSet};
+use tree_sitter::Node;
+struct Import {
+    scope: usize,
+    at: usize,
+    alias: Option<String>,
+    target: String,
+    static_: bool,
+}
+pub(super) struct Names<'a, 's, 'c> {
+    pub ctx: &'c Context<'a, 's>,
+    imports: Vec<Import>,
+    types: HashSet<String>,
+    shadows: HashSet<(usize, String)>,
+    vars: HashSet<(usize, String)>,
+    file_namespace: Option<(usize, String)>,
+    remaining: Cell<usize>,
+    pub partial: Cell<bool>,
+    pub references: Vec<(Node<'a>, String)>,
+}
+impl<'a, 's, 'c> Names<'a, 's, 'c> {
+    pub fn new(ctx: &'c Context<'a, 's>) -> Self {
+        let mut out = Self {
+            ctx,
+            imports: vec![],
+            types: HashSet::new(),
+            shadows: HashSet::new(),
+            vars: HashSet::new(),
+            file_namespace: None,
+            remaining: Cell::new(ctx.budget.max_ast_candidates),
+            partial: Cell::new(false),
+            references: vec![],
+        };
+        for n in &ctx.nodes {
+            if !out.charge() {
+                return out;
+            }
+            if n.kind().starts_with("preproc_if") || n.kind() == "preproc_else" {
+                out.partial.set(true);
+            }
+            if in_error(*n, ctx) {
+                continue;
+            }
+            if matches!(
+                n.kind(),
+                "declaration_pattern"
+                    | "var_pattern"
+                    | "recursive_pattern"
+                    | "list_pattern"
+                    | "parenthesized_variable_designation"
+                    | "tuple_pattern"
+            ) {
+                let mut cursor = n.walk();
+                for name in n.children_by_field_name("name", &mut cursor) {
+                    if let Some(name) = out.path(name) {
+                        out.vars.insert((ctx.scope(*n), name));
+                    }
+                }
+            }
+            if n.kind() == "implicit_parameter" {
+                if let Some(name) = out.path(*n) {
+                    out.vars.insert((ctx.scope(*n), name));
+                }
+            }
+            if n.kind() == "assignment_expression" {
+                if let Some(left) = n.child_by_field_name("left") {
+                    let mut stack = vec![left];
+                    while let Some(node) = stack.pop() {
+                        if !out.charge() {
+                            return out;
+                        }
+                        if node.kind() == "identifier" {
+                            if let Some(name) = out.path(node) {
+                                out.vars.insert((ctx.scope(*n), name));
+                            }
+                        } else if matches!(
+                            node.kind(),
+                            "tuple_expression" | "tuple_pattern" | "argument"
+                        ) {
+                            stack.extend(children(node));
+                        }
+                    }
+                }
+            }
+            match n.kind() {
+                "file_scoped_namespace_declaration" => {
+                    if let Some(name) = n.child_by_field_name("name").and_then(|n| out.path(n)) {
+                        out.file_namespace = Some((n.end_byte(), name));
+                    }
+                }
+                "class_declaration"
+                | "struct_declaration"
+                | "interface_declaration"
+                | "record_declaration"
+                | "enum_declaration"
+                | "delegate_declaration" => {
+                    if let Some(name) = n.child_by_field_name("name").and_then(|n| out.path(n)) {
+                        out.types
+                            .insert(format!("{}{}", out.namespace(*n, true), name));
+                        out.shadows.insert((ctx.parent_scope(*n), name));
+                    }
+                }
+                "type_parameter" => {
+                    if let Some(name) = n.child_by_field_name("name").and_then(|n| out.path(n)) {
+                        out.shadows.insert((ctx.scope(*n), name));
+                    }
+                }
+                "property_declaration" | "event_declaration" => {
+                    if let Some(name) = n.child_by_field_name("name").and_then(|n| out.path(n)) {
+                        out.vars.insert((ctx.scope(*n), name));
+                    }
+                }
+                "variable_declarator"
+                | "parameter"
+                | "catch_declaration"
+                | "declaration_expression" => {
+                    if let Some(name) = n.child_by_field_name("name").and_then(|n| out.path(n)) {
+                        out.vars.insert((ctx.scope(*n), name));
+                    }
+                }
+                "foreach_statement" => {
+                    if let Some(name) = n.child_by_field_name("left").and_then(|n| out.path(n)) {
+                        out.vars.insert((ctx.scope(*n), name));
+                    }
+                }
+                "method_declaration" | "local_function_statement" => {
+                    if let Some(name) = n.child_by_field_name("name").and_then(|n| out.path(n)) {
+                        out.shadows.insert((ctx.parent_scope(*n), name));
+                    }
+                }
+                "using_directive" => {
+                    let alias_node = n.child_by_field_name("name");
+                    let target = children(*n)
+                        .into_iter()
+                        .rfind(|c| alias_node.is_none_or(|a| a.id() != c.id()));
+                    if let Some(target_node) = target {
+                        if let Some(target) = out.path(target_node) {
+                            let alias = alias_node.and_then(|n| out.path(n));
+                            out.references.push((target_node, target.clone()));
+                            if out.imports.len() >= 64 {
+                                ctx.limit("csharp_import_entries", 64, 64);
+                                return out;
+                            }
+                            out.imports.push(Import {
+                                scope: ctx.scope(*n),
+                                at: n.end_byte(),
+                                alias,
+                                target,
+                                static_: ctx.source(*n).split_whitespace().any(|s| s == "static"),
+                            });
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        out
+    }
+    pub fn charge(&self) -> bool {
+        let n = self.remaining.get();
+        if n == 0 {
+            self.ctx.limit(
+                "csharp_source_candidates",
+                self.ctx.budget.max_ast_candidates,
+                self.ctx.budget.max_ast_candidates,
+            );
+            false
+        } else {
+            self.remaining.set(n - 1);
+            true
+        }
+    }
+    pub fn path(&self, node: Node<'_>) -> Option<String> {
+        if !matches!(
+            node.kind(),
+            "identifier"
+                | "implicit_parameter"
+                | "qualified_name"
+                | "alias_qualified_name"
+                | "member_access_expression"
+                | "predefined_type"
+        ) {
+            return None;
+        }
+        let raw = self.ctx.source(node);
+        if raw.len() > 512 {
+            self.ctx.limit("csharp_identifier_bytes", 512, 512);
+            return None;
+        }
+        if raw.contains('\\') {
+            self.partial.set(true);
+            return None;
+        }
+        let raw: String = raw.chars().filter(|c| !c.is_whitespace()).collect();
+        if raw.is_empty()
+            || !raw
+                .chars()
+                .all(|c| c.is_alphanumeric() || "_.:@".contains(c))
+        {
+            return None;
+        }
+        let raw = if let Some(rest) = raw.strip_prefix("global::") {
+            rest.to_owned()
+        } else if let Some((alias, rest)) = raw.split_once("::") {
+            if alias.contains('.') || rest.contains(':') {
+                return None;
+            }
+            format!("{alias}.{rest}")
+        } else {
+            raw
+        };
+        if raw.contains(':') {
+            return None;
+        }
+        Some(
+            raw.split('.')
+                .map(|s| s.strip_prefix('@').unwrap_or(s))
+                .collect::<Vec<_>>()
+                .join("."),
+        )
+    }
+    pub fn visible(&self, outer: usize, mut inner: usize) -> bool {
+        for _ in 0..64 {
+            if inner == outer {
+                return true;
+            }
+            let Some(p) = self.ctx.scope_parent(inner) else {
+                return false;
+            };
+            inner = p;
+        }
+        self.ctx.limit("csharp_scope_depth", 64, 64);
+        false
+    }
+    fn namespace(&self, node: Node<'_>, classes: bool) -> String {
+        let mut parts = vec![];
+        let mut p = node.parent();
+        for _ in 0..64 {
+            let Some(n) = p else {
+                break;
+            };
+            if n.kind() == "namespace_declaration"
+                || (classes
+                    && matches!(
+                        n.kind(),
+                        "class_declaration" | "struct_declaration" | "record_declaration"
+                    ))
+            {
+                if let Some(name) = n.child_by_field_name("name").and_then(|n| self.path(n)) {
+                    parts.push(name);
+                }
+            }
+            p = n.parent();
+        }
+        if p.is_some() {
+            self.ctx.limit("csharp_namespace_depth", 64, 64);
+            return String::new();
+        }
+        parts.reverse();
+        // A file-scoped namespace is a preceding sibling, not an AST ancestor.
+        if let Some((at, name)) = &self.file_namespace {
+            if *at <= node.start_byte() {
+                parts.insert(0, name.clone());
+            }
+        }
+        if parts.is_empty() {
+            String::new()
+        } else {
+            format!("{}.", parts.join("."))
+        }
+    }
+    pub fn resolve(&self, node: Node<'_>, ignore_vars: bool) -> Vec<String> {
+        if !self.charge() {
+            return vec![];
+        }
+        let Some(raw) = self.path(node) else {
+            return vec![];
+        };
+        let compact: String = self
+            .ctx
+            .source(node)
+            .chars()
+            .filter(|c| !c.is_whitespace())
+            .collect();
+        let global = compact.starts_with("global::");
+        let alias_qualified = !global && compact.contains("::");
+        let first = raw.split('.').next().unwrap_or("");
+        let scope = self.ctx.scope(node);
+        if !global && !alias_qualified {
+            let mut current = Some(scope);
+            for _ in 0..64 {
+                let Some(s) = current else {
+                    break;
+                };
+                if self.shadows.contains(&(s, first.to_owned()))
+                    || (!ignore_vars && self.vars.contains(&(s, first.to_owned())))
+                {
+                    return vec![];
+                }
+                current = self.ctx.scope_parent(s);
+            }
+            if current.is_some() {
+                self.ctx.limit("csharp_scope_depth", 64, 64);
+                return vec![];
+            }
+        }
+        let mut result = vec![];
+        if global {
+            result.push(raw);
+        } else {
+            let mut current = Some(scope);
+            let mut alias_found = false;
+            for _ in 0..64 {
+                let Some(s) = current else {
+                    break;
+                };
+                let aliases: Vec<_> = self
+                    .imports
+                    .iter()
+                    .filter(|i| i.scope == s && i.alias.as_deref() == Some(first))
+                    .collect();
+                if !aliases.is_empty() {
+                    alias_found = true;
+                    if aliases.len() != 1 || node.start_byte() < aliases[0].at {
+                        self.partial.set(true);
+                        return vec![];
+                    }
+                    if alias_qualified
+                        && (super::class_info(&aliases[0].target)
+                            .is_some_and(|k| k.family().is_some())
+                            || super::parameter_family(&format!("{}._", aliases[0].target))
+                                .is_some()
+                            || self.types.contains(&aliases[0].target))
+                    {
+                        self.partial.set(true);
+                        return vec![];
+                    }
+                    let suffix = &raw[first.len()..];
+                    result.push(format!("{}{suffix}", aliases[0].target));
+                    break;
+                }
+                current = self.ctx.scope_parent(s);
+            }
+            if !alias_found && current.is_some() {
+                self.ctx.limit("csharp_scope_depth", 64, 64);
+                return vec![];
+            }
+            if alias_qualified && !alias_found {
+                self.partial.set(true);
+                return vec![];
+            }
+            if !alias_found {
+                result.push(raw.clone());
+                result.push(format!("{}{}", self.namespace(node, false), raw));
+                for import in &self.imports {
+                    if import.alias.is_none()
+                        && self.visible(import.scope, scope)
+                        && import.at <= node.start_byte()
+                    {
+                        result.push(format!("{}.{}", import.target, raw));
+                    }
+                }
+            }
+        }
+        result.retain(|n| self.external_path(n));
+        result.sort();
+        result.dedup();
+        result
+    }
+    pub fn external_path(&self, name: &str) -> bool {
+        !self.types.contains(name)
+            && !name
+                .char_indices()
+                .filter(|(_, c)| *c == '.')
+                .any(|(i, _)| self.types.contains(&name[..i]))
+    }
+    pub fn static_candidates(&self, node: Node<'_>) -> Vec<String> {
+        let mut out = self.resolve(node, false);
+        if out.is_empty() {
+            return out;
+        }
+        if node.kind() == "identifier" {
+            if let Some(raw) = self.path(node) {
+                for i in &self.imports {
+                    if i.static_
+                        && i.at <= node.start_byte()
+                        && self.visible(i.scope, self.ctx.scope(node))
+                    {
+                        out.push(format!("{}.{}", i.target, raw));
+                    }
+                }
+            }
+        }
+        out.sort();
+        out.dedup();
+        out
+    }
+}
+pub(super) fn in_error(mut node: Node<'_>, ctx: &Context<'_, '_>) -> bool {
+    for _ in 0..64 {
+        if node.kind() == "ERROR" {
+            return true;
+        }
+        let Some(p) = node.parent() else {
+            return false;
+        };
+        node = p;
+    }
+    ctx.limit("csharp_ancestor_depth", 64, 64);
+    true
+}
diff --git a/crates/pqc_scan_detectors/src/source_facts/csharp/values.rs b/crates/pqc_scan_detectors/src/source_facts/csharp/values.rs
