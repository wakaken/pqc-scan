index 0000000..e3c55c5
--- /dev/null
+++ b/crates/pqc_scan_detectors/src/source_facts/csharp/values.rs
@@ -0,0 +1,607 @@
+//! Local lexical values, immutable parameter symbols and conservative write barriers.
+use super::super::context::children;
+use super::names::Names;
+use super::{class_info, compatible, factory_method, parameter, unique_kind, Key, Kind};
+use std::collections::HashMap;
+use tree_sitter::Node;
+#[derive(Clone)]
+struct Binding<'a> {
+    end: usize,
+    value: Option<Node<'a>>,
+    hint: Option<Kind>,
+    guard: Option<(usize, usize)>,
+    known: Option<Key>,
+}
+pub(super) struct Values<'a, 's, 'n, 'c> {
+    names: &'n Names<'a, 's, 'c>,
+    bindings: HashMap<(usize, String), Vec<Binding<'a>>>,
+    overflows: HashMap<(usize, String), usize>,
+    barriers: HashMap<usize, Vec<usize>>,
+    has_error: bool,
+}
+impl<'a, 's, 'n, 'c> Values<'a, 's, 'n, 'c> {
+    pub fn new(names: &'n Names<'a, 's, 'c>) -> Self {
+        let mut out = Self {
+            names,
+            bindings: HashMap::new(),
+            overflows: HashMap::new(),
+            barriers: HashMap::new(),
+            has_error: names.ctx.nodes.iter().any(|n| n.kind() == "ERROR"),
+        };
+        for n in &names.ctx.nodes {
+            if !names.charge() {
+                return out;
+            }
+            if matches!(
+                n.kind(),
+                "declaration_pattern"
+                    | "var_pattern"
+                    | "recursive_pattern"
+                    | "list_pattern"
+                    | "parenthesized_variable_designation"
+                    | "tuple_pattern"
+            ) {
+                let mut cursor = n.walk();
+                for name in n.children_by_field_name("name", &mut cursor) {
+                    out.add(names.ctx.scope(*n), name, None, None, n.end_byte(), None);
+                }
+            }
+            match n.kind() {
+                "implicit_parameter" => {
+                    out.add(names.ctx.scope(*n), *n, None, None, n.end_byte(), None)
+                }
+                "variable_declarator" => {
+                    if let Some(name) = n.child_by_field_name("name") {
+                        let value = children(*n).into_iter().find(|c| c.id() != name.id());
+                        let field = n
+                            .parent()
+                            .and_then(|p| p.parent())
+                            .is_some_and(|p| p.kind() == "field_declaration");
+                        let hint = if !field {
+                            n.parent()
+                                .and_then(|p| p.child_by_field_name("type"))
+                                .and_then(|t| out.hint(t))
+                        } else {
+                            None
+                        };
+                        out.add(
+                            names.ctx.scope(*n),
+                            name,
+                            if field { None } else { value },
+                            hint,
+                            if field { 0 } else { n.end_byte() },
+                            None,
+                        );
+                    }
+                }
+                "parameter" | "catch_declaration" | "declaration_expression" => {
+                    if let Some(name) = n.child_by_field_name("name") {
+                        let hint = if n.kind() == "parameter" {
+                            n.child_by_field_name("type").and_then(|t| out.hint(t))
+                        } else {
+                            None
+                        };
+                        out.add(names.ctx.scope(*n), name, None, hint, n.end_byte(), None);
+                    }
+                }
+                "foreach_statement" => {
+                    if let Some(name) = n.child_by_field_name("left") {
+                        out.invalidate(name, name.end_byte(), 0);
+                    }
+                }
+                _ => {}
+            }
+        }
+        // Collect source writes after declarations so a nested block writes the
+        // nearest existing local rather than inventing a new inner binding.
+        for n in &names.ctx.nodes {
+            if !names.charge() {
+                return out;
+            }
+            match n.kind() {
+                "assignment_expression" => {
+                    if let (Some(left), Some(right)) = (
+                        n.child_by_field_name("left"),
+                        n.child_by_field_name("right"),
+                    ) {
+                        let plain = n
+                            .child_by_field_name("operator")
+                            .is_some_and(|n| names.ctx.source(n) == "=");
+                        if left.kind() == "identifier" {
+                            let scope = out.declaration_scope(left);
+                            out.add(
+                                scope,
+                                left,
+                                plain.then_some(right),
+                                None,
+                                n.end_byte(),
+                                None,
+                            );
+                        } else {
+                            out.invalidate(left, n.end_byte(), 0);
+                        }
+                    }
+                }
+                "postfix_unary_expression" | "prefix_unary_expression" => {
+                    let raw = names.ctx.source(*n);
+                    if raw.contains("++") || raw.contains("--") {
+                        if let Some(child) = n.named_child(0) {
+                            out.invalidate(child, n.end_byte(), 0);
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        for n in &names.ctx.nodes {
+            if !names.charge() {
+                return out;
+            }
+            if n.kind() != "invocation_expression" {
+                continue;
+            }
+            let Some(function) = n.child_by_field_name("function") else {
+                continue;
+            };
+            let mut initialized = None;
+            let mut known = false;
+            let mut mutating = false;
+            if function.kind() == "member_access_expression" {
+                if let (Some(object), Some(method)) = (
+                    function.child_by_field_name("expression"),
+                    function.child_by_field_name("name"),
+                ) {
+                    let method = names.path(method).unwrap_or_default();
+                    if let Some(mut key) = out.key(object) {
+                        known = super::operation(key.kind, &method);
+                        if method == "Init"
+                            && matches!(
+                                key.kind,
+                                Kind::Generator(_)
+                                    | Kind::Signer(_)
+                                    | Kind::Engine(_)
+                                    | Kind::Encap
+                                    | Kind::Decap
+                            )
+                        {
+                            if matches!(key.kind, Kind::Generator(_)) {
+                                let selected = argument(*n, 0, "parameters", names.ctx.text)
+                                    .and_then(|n| out.selector_in(n, 0))
+                                    .filter(|s| compatible(key.kind.family().unwrap_or(""), s));
+                                key.algorithm = selected.unwrap_or_else(|| {
+                                    names.partial.set(true);
+                                    key.kind.family().unwrap_or("").into()
+                                });
+                            }
+                            // Signer/KEM constructor parameters are immutable;
+                            // Init selects a key/mode, not a different suite.
+                            initialized = Some((object, key));
+                            known = true;
+                            mutating = true;
+                        }
+                        if !known {
+                            out.invalidate(object, n.end_byte(), 0);
+                        }
+                    }
+                }
+            }
+            known |= out.factory(*n, 0).is_some();
+            if !known || mutating {
+                let scope = names.ctx.function_scope(names.ctx.scope(*n));
+                let list = out.barriers.entry(scope).or_default();
+                let at = list.partition_point(|v| *v <= n.end_byte());
+                list.insert(at, n.end_byte());
+            }
+            for argument in arguments(*n) {
+                let raw = argument.parent().map(|p| names.ctx.source(p)).unwrap_or("");
+                if raw.split_whitespace().any(|s| matches!(s, "ref" | "out")) || !known {
+                    out.invalidate(argument, n.end_byte(), 0);
+                }
+            }
+            if let Some((object, key)) = initialized {
+                if object.kind() == "identifier" {
+                    let scope = out.declaration_scope(object);
+                    out.add(scope, object, None, None, n.end_byte(), Some(key));
+                }
+            }
+        }
+        out
+    }
+    fn hint(&self, mut node: Node<'a>) -> Option<Kind> {
+        for _ in 0..8 {
+            if let Some(kind) = unique_kind(self.names, node, true) {
+                return Some(kind);
+            }
+            if node.kind() != "nullable_type" {
+                return None;
+            }
+            node = node.named_child(0)?;
+        }
+        self.names.ctx.limit("csharp_type_hint_depth", 8, 8);
+        None
+    }
+    fn add(
+        &mut self,
+        scope: usize,
+        name: Node<'a>,
+        value: Option<Node<'a>>,
+        hint: Option<Kind>,
+        end: usize,
+        known: Option<Key>,
+    ) {
+        if !self.names.charge() {
+            return;
+        }
+        let Some(raw) = self.names.path(name) else {
+            return;
+        };
+        if raw.len() > 256 {
+            self.names.ctx.limit("csharp_variable_bytes", 256, 256);
+            return;
+        }
+        let key = (scope, raw);
+        let list = self.bindings.entry(key.clone()).or_default();
+        if list.len() >= 64 {
+            self.overflows
+                .entry(key)
+                .and_modify(|n| *n = (*n).min(end))
+                .or_insert(end);
+            self.names.ctx.limit("csharp_same_name_bindings", 64, 64);
+            return;
+        }
+        let position = list.partition_point(|b| b.end <= end);
+        list.insert(
+            position,
+            Binding {
+                end,
+                value,
+                hint,
+                guard: guard(self.names, name),
+                known,
+            },
+        );
+    }
+    fn declaration_scope(&self, name: Node<'a>) -> usize {
+        let Some(raw) = self.names.path(name) else {
+            return self.names.ctx.scope(name);
+        };
+        let mut current = Some(self.names.ctx.scope(name));
+        let boundary = self.names.ctx.function_scope(self.names.ctx.scope(name));
+        for _ in 0..64 {
+            let Some(s) = current else {
+                break;
+            };
+            if self.bindings.contains_key(&(s, raw.clone())) {
+                return s;
+            }
+            if s == boundary {
+                return self.names.ctx.scope(name);
+            }
+            current = self.names.ctx.scope_parent(s);
+        }
+        if current.is_some() {
+            self.names.ctx.limit("csharp_scope_depth", 64, 64);
+        }
+        self.names.ctx.scope(name)
+    }
+    fn invalidate(&mut self, node: Node<'a>, end: usize, depth: usize) {
+        if depth >= 64 {
+            self.names.ctx.limit("csharp_write_depth", 64, 64);
+            return;
+        }
+        if !self.names.charge() {
+            return;
+        }
+        match node.kind() {
+            "identifier" => {
+                let scope = self.declaration_scope(node);
+                self.add(scope, node, None, None, end, None);
+            }
+            "member_access_expression" => {
+                if let Some(base) = node.child_by_field_name("expression") {
+                    self.invalidate(base, end, depth + 1);
+                }
+            }
+            "element_access_expression" | "parenthesized_expression" => {
+                if let Some(base) = node.named_child(0) {
+                    self.invalidate(base, end, depth + 1);
+                }
+            }
+            "declaration_expression" => {
+                if let Some(name) = node.child_by_field_name("name") {
+                    self.invalidate(name, end, depth + 1);
+                }
+            }
+            "argument" => {
+                if let Some(base) = node.named_child(0) {
+                    self.invalidate(base, end, depth + 1);
+                }
+            }
+            "tuple_expression" | "tuple_pattern" => {
+                for child in children(node) {
+                    self.invalidate(child, end, depth + 1);
+                }
+            }
+            _ => {}
+        }
+    }
+    fn binding(&self, node: Node<'a>) -> Option<&Binding<'a>> {
+        if self.has_error {
+            return None;
+        }
+        let raw = self.names.path(node)?;
+        let mut current = Some(self.names.ctx.scope(node));
+        let boundary = self.names.ctx.function_scope(self.names.ctx.scope(node));
+        for _ in 0..64 {
+            let s = current?;
+            let key = (s, raw.clone());
+            if self
+                .overflows
+                .get(&key)
+                .is_some_and(|at| *at <= node.start_byte())
+            {
+                return None;
+            }
+            if let Some(values) = self.bindings.get(&key) {
+                let binding = values.get(
+                    values
+                        .partition_point(|v| v.end <= node.start_byte())
+                        .checked_sub(1)?,
+                )?;
+                if binding
+                    .guard
+                    .is_some_and(|(a, b)| node.start_byte() < a || node.end_byte() > b)
+                {
+                    self.names.partial.set(true);
+                    return None;
+                }
+                let function = self.names.ctx.function_scope(self.names.ctx.scope(node));
+                if self.barriers.get(&function).is_some_and(|v| {
+                    let last = v.partition_point(|at| *at <= node.start_byte());
+                    last > 0 && binding.end < v[last - 1]
+                }) {
+                    self.names.partial.set(true);
+                    return None;
+                }
+                return Some(binding);
+            }
+            if s == boundary {
+                return None;
+            }
+            current = self.names.ctx.scope_parent(s);
+        }
+        self.names.ctx.limit("csharp_scope_depth", 64, 64);
+        None
+    }
+    fn step(&self, depth: usize) -> bool {
+        if depth > 8 {
+            self.names.ctx.limit("source_alias_depth", 8, 8);
+            false
+        } else {
+            self.names.charge()
+        }
+    }
+    pub fn key(&self, node: Node<'a>) -> Option<Key> {
+        self.value(node, 0)
+    }
+    fn value(&self, node: Node<'a>, depth: usize) -> Option<Key> {
+        if !self.step(depth) {
+            return None;
+        }
+        match node.kind() {
+            "identifier" => {
+                let b = self.binding(node)?;
+                if let Some(key) = &b.known {
+                    return Some(key.clone());
+                }
+                if let Some(rhs) = b.value {
+                    let value = self.value(rhs, depth + usize::from(rhs.kind() == "identifier"));
+                    if let (Some(hint), Some(value)) = (b.hint, value.as_ref()) {
+                        if hint.family() != value.kind.family() {
+                            self.names.partial.set(true);
+                            return None;
+                        }
+                    }
+                    return value.or_else(|| b.hint.and_then(Kind::key));
+                }
+                b.hint?.key()
+            }
+            "parenthesized_expression" => self.value(node.named_child(0)?, depth + 1),
+            "object_creation_expression" => {
+                let kind = unique_kind(self.names, node.child_by_field_name("type")?, true)?;
+                let mut key = kind.key()?;
+                if matches!(
+                    kind,
+                    Kind::Encap | Kind::Decap | Kind::Signer("ML-DSA" | "SLH-DSA")
+                ) {
+                    if let Some(selected) = argument(node, 0, "parameters", self.names.ctx.text)
+                        .and_then(|n| self.selector(n, 0))
+                        .filter(|s| compatible(kind.family().unwrap_or(""), s))
+                    {
+                        key.algorithm = selected;
+                    } else {
+                        self.names.partial.set(true);
+                    }
+                }
+                Some(key)
+            }
+            "invocation_expression" => self.factory(node, depth),
+            _ => None,
+        }
+    }
+    pub fn factory(&self, node: Node<'a>, depth: usize) -> Option<Key> {
+        if !self.step(depth) {
+            return None;
+        }
+        let function = node.child_by_field_name("function")?;
+        let mut found = vec![];
+        for full in self.names.static_candidates(function) {
+            let Some((class, method)) = full.rsplit_once('.') else {
+                continue;
+            };
+            let Some(kind) = class_info(class) else {
+                continue;
+            };
+            if !factory_method(kind, method) {
+                continue;
+            }
+            let mut key = kind.key()?;
+            if matches!(kind, Kind::Pqc(_)) {
+                let selected = argument(node, 0, "algorithm", self.names.ctx.text)
+                    .and_then(|n| self.selector(n, 0))
+                    .filter(|s| compatible(kind.family().unwrap_or(""), s));
+                if let Some(selected) = selected {
+                    key.algorithm = selected;
+                } else if method == "GenerateKey" {
+                    self.names.partial.set(true);
+                }
+            }
+            found.push(key);
+        }
+        if found.len() == 1 {
+            found.pop()
+        } else {
+            if found.len() > 1 {
+                self.names.partial.set(true);
+            }
+            None
+        }
+    }
+    pub fn selector(&self, node: Node<'a>, depth: usize) -> Option<String> {
+        if !self.step(depth) {
+            return None;
+        }
+        if node.kind() == "identifier" {
+            if let Some(binding) = self.binding(node) {
+                if let Some(rhs) = binding.value {
+                    return self.selector(rhs, depth + usize::from(rhs.kind() == "identifier"));
+                }
+                return None;
+            }
+        }
+        if node.kind() == "parenthesized_expression" {
+            return self.selector(node.named_child(0)?, depth + 1);
+        }
+        let mut found: Vec<_> = self
+            .names
+            .resolve(node, false)
+            .iter()
+            .filter_map(|s| parameter(s))
+            .collect();
+        found.sort();
+        found.dedup();
+        if found.len() == 1 {
+            found.pop()
+        } else {
+            None
+        }
+    }
+    fn selector_in(&self, node: Node<'a>, depth: usize) -> Option<String> {
+        if !self.step(depth) {
+            return None;
+        }
+        if node.kind() == "identifier" {
+            let binding = self.binding(node)?;
+            let rhs = binding.value?;
+            return self.selector_in(rhs, depth + usize::from(rhs.kind() == "identifier"));
+        }
+        if node.kind() != "object_creation_expression" {
+            return None;
+        }
+        let typ = node.child_by_field_name("type")?;
+        let families: Vec<_> = self
+            .names
+            .resolve(typ, true)
+            .iter()
+            .filter_map(
+                |s| match s.strip_prefix("Org.BouncyCastle.Crypto.Parameters.")? {
+                    "MLKemKeyGenerationParameters" => Some("ML-KEM"),
+                    "MLDsaKeyGenerationParameters" => Some("ML-DSA"),
+                    "SlhDsaKeyGenerationParameters" => Some("SLH-DSA"),
+                    _ => None,
+                },
+            )
+            .collect();
+        if families.len() != 1 {
+            return None;
+        }
+        let selected = self.selector(argument(node, 1, "parameters", self.names.ctx.text)?, 0)?;
+        compatible(families[0], &selected).then_some(selected)
+    }
+}
+fn argument<'a>(node: Node<'a>, index: usize, label: &str, text: &str) -> Option<Node<'a>> {
+    let args = node.child_by_field_name("arguments")?;
+    let mut positional = 0;
+    let mut found = None;
+    for arg in children(args)
+        .into_iter()
+        .filter(|n| n.kind() == "argument")
+    {
+        let name = arg.child_by_field_name("name");
+        let value = children(arg)
+            .into_iter()
+            .find(|n| name.is_none_or(|a| n.id() != a.id()))?;
+        let selects = if let Some(name) = name {
+            &text[name.byte_range()] == label
+        } else {
+            let select = positional == index;
+            positional += 1;
+            select
+        };
+        if selects {
+            if found.is_some() {
+                return None;
+            }
+            found = Some(value);
+        }
+    }
+    found
+}
+pub(super) fn arguments(node: Node<'_>) -> Vec<Node<'_>> {
+    node.child_by_field_name("arguments")
+        .map_or_else(Vec::new, |args| {
+            children(args)
+                .into_iter()
+                .filter(|n| n.kind() == "argument")
+                .filter_map(|n| {
+                    let name = n.child_by_field_name("name");
+                    children(n)
+                        .into_iter()
+                        .find(|c| name.is_none_or(|name| c.id() != name.id()))
+                })
+                .collect()
+        })
+}
+fn guard(names: &Names<'_, '_, '_>, mut node: Node<'_>) -> Option<(usize, usize)> {
+    for _ in 0..64 {
+        let p = node.parent()?;
+        if matches!(
+            p.kind(),
+            "method_declaration"
+                | "constructor_declaration"
+                | "local_function_statement"
+                | "lambda_expression"
+                | "anonymous_method_expression"
+                | "compilation_unit"
+        ) {
+            return None;
+        }
+        if matches!(
+            p.kind(),
+            "if_statement"
+                | "for_statement"
+                | "foreach_statement"
+                | "while_statement"
+                | "do_statement"
+                | "switch_section"
+                | "catch_clause"
+                | "preproc_if"
+                | "preproc_else"
+        ) {
+            return Some((p.start_byte(), p.end_byte()));
+        }
+        node = p;
+    }
+    names.ctx.limit("csharp_ancestor_depth", 64, 64);
+    None
+}
diff --git a/crates/pqc_scan_detectors/src/source_facts/php.rs b/crates/pqc_scan_detectors/src/source_facts/php.rs
new file mode 100644
index 0000000..d19960b
--- /dev/null
+++ b/crates/pqc_scan_detectors/src/source_facts/php.rs
@@ -0,0 +1,559 @@
+//! Exact PHP API identities over the shared bounded Tree-sitter context.
+mod names;
+mod values;
+use super::{
+    builtin,
+    context::{children, Context},
+    Facts,
+};
+use names::{Names, CLASS, FUNCTION};
+use pqc_scan_rules::RuleSet;
+use tree_sitter::Node;
+use values::{argument, Value, Values};
+const API: &str = "PHP_CRYPTO_API";
+const PQC: &str = "PHP_PQC_API";
+const REFERENCE: &str = "PHP_CRYPTO_REFERENCE";
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Role {
+    OpenSsl,
+    Encap,
+    Decap,
+    Sign,
+    Verify,
+    Reference,
+}
+#[derive(Clone, Copy)]
+struct Key {
+    algorithm: &'static str,
+    role: Role,
+}
+#[derive(Clone, Copy)]
+enum ClassInfo {
+    Factory(&'static str),
+    Key(Key),
+    Compat,
+    Reference(Option<&'static str>),
+}
+fn class_info(name: &str) -> Option<ClassInfo> {
+    match name {
+        "phpseclib3\\crypt\\rsa" => return Some(ClassInfo::Reference(Some("RSA"))),
+        "phpseclib3\\crypt\\ec" => return Some(ClassInfo::Reference(Some("EC"))),
+        "phpseclib3\\crypt\\dh" => return Some(ClassInfo::Reference(Some("DH"))),
+        "oqs_keyencapsulation" | "oqs_signature" | "oqs\\oqskem" | "oqs\\oqssig" => {
+            return Some(ClassInfo::Reference(None))
+        }
+        _ => {}
+    }
+    let (rest, native) = if let Some(n) = name.strip_prefix("pqcrypto\\") {
+        (n, true)
+    } else {
+        (name.strip_prefix("paragonie\\pqcrypto\\")?, false)
+    };
+    if rest == "compat" && !native {
+        return Some(ClassInfo::Compat);
+    }
+    if rest == "slhdsa" && native {
+        return Some(ClassInfo::Reference(Some("SLH-DSA")));
+    }
+    let (family, tail) = rest.split_once('\\').unwrap_or((rest, ""));
+    let algorithm = match family {
+        "mlkem512" => "ML-KEM-512",
+        "mlkem768" => "ML-KEM-768",
+        "mlkem1024" => "ML-KEM-1024",
+        "mldsa44" => "ML-DSA-44",
+        "mldsa65" => "ML-DSA-65",
+        "mldsa87" => "ML-DSA-87",
+        "xwing" => "X-Wing",
+        _ => return None,
+    };
+    if tail.is_empty() {
+        return Some(ClassInfo::Factory(algorithm));
+    }
+    let role = if algorithm.starts_with("ML-DSA") {
+        match tail {
+            "signingkey" => Role::Sign,
+            "verifyingkey" if native => Role::Verify,
+            "verificationkey" if !native => Role::Verify,
+            _ => return None,
+        }
+    } else {
+        match tail {
+            "encapsulationkey" => Role::Encap,
+            "decapsulationkey" => Role::Decap,
+            _ => return None,
+        }
+    };
+    Some(ClassInfo::Key(Key { algorithm, role }))
+}
+fn compat_method(method: &str) -> Option<(&'static str, &str)> {
+    let (algorithm, operation) = method.split_once('_')?;
+    let algorithm = match algorithm {
+        "mlkem512" => "ML-KEM-512",
+        "mlkem768" => "ML-KEM-768",
+        "mlkem1024" => "ML-KEM-1024",
+        "mldsa44" => "ML-DSA-44",
+        "mldsa65" => "ML-DSA-65",
+        "mldsa87" => "ML-DSA-87",
+        "xwing" => "X-Wing",
+        _ => return None,
+    };
+    let valid = if algorithm.starts_with("ML-DSA") {
+        matches!(operation, "keygen" | "sign" | "verify")
+    } else {
+        matches!(operation, "keygen" | "encaps" | "decaps")
+    };
+    valid.then_some((algorithm, operation))
+}
+fn sodium(name: &str) -> Option<(&'static str, bool)> {
+    let suffix = name.strip_prefix("sodium_crypto_")?;
+    if let Some(kem) = suffix.strip_prefix("kem_") {
+        let (algorithm, operation) = kem
+            .strip_prefix("mlkem768_")
+            .map_or(("X-Wing", kem), |op| ("ML-KEM-768", op));
+        return matches!(
+            operation,
+            "keypair" | "seed_keypair" | "secretkey" | "publickey" | "enc" | "dec"
+        )
+        .then_some((algorithm, true));
+    }
+    let algorithm = match suffix {
+        "sign"
+        | "sign_detached"
+        | "sign_verify_detached"
+        | "sign_keypair"
+        | "sign_seed_keypair"
+        | "sign_open"
+        | "sign_publickey"
+        | "sign_secretkey"
+        | "sign_publickey_from_secretkey"
+        | "sign_keypair_from_secretkey_and_publickey" => "Ed25519",
+        "scalarmult"
+        | "scalarmult_base"
+        | "box"
+        | "box_open"
+        | "box_keypair"
+        | "box_seed_keypair"
+        | "box_keypair_from_secretkey_and_publickey"
+        | "box_publickey"
+        | "box_publickey_from_secretkey"
+        | "box_secretkey"
+        | "box_seal"
+        | "box_seal_open"
+        | "kx_keypair"
+        | "kx_seed_keypair"
+        | "kx_publickey"
+        | "kx_secretkey"
+        | "kx_client_session_keys"
+        | "kx_server_session_keys" => "X25519",
+        _ => return None,
+    };
+    Some((algorithm, false))
+}
+fn known_function(name: &str) -> bool {
+    sodium(name).is_some()
+        || matches!(
+            name,
+            "openssl_pkey_new"
+                | "openssl_pkey_derive"
+                | "openssl_public_encrypt"
+                | "openssl_private_decrypt"
+                | "openssl_private_encrypt"
+                | "openssl_public_decrypt"
+                | "openssl_sign"
+                | "openssl_verify"
+        )
+}
+fn emit(
+    facts: &mut Facts,
+    rules: &RuleSet,
+    id: &'static str,
+    node: Node<'_>,
+    algorithm: Option<&'static str>,
+    reason: &'static str,
+    label: &'static str,
+) {
+    if !rules.get(id).is_some_and(builtin) {
+        return;
+    }
+    let refs = algorithm.into_iter().collect::<Vec<_>>();
+    facts.source_api(id, node, reason, &refs, label);
+}
+pub(super) fn inspect(ctx: &Context<'_, '_>, facts: &mut Facts, rules: &RuleSet) {
+    let names = Names::new(ctx);
+    if ctx.truncated.get() {
+        return;
+    }
+    let values = Values::new(&names);
+    if ctx.truncated.get() {
+        return;
+    }
+    for (node, target) in &names.import_references {
+        if let Some(ClassInfo::Reference(algorithm)) = class_info(target) {
+            emit_reference(facts, rules, *node, target, algorithm);
+        }
+    }
+    for n in &ctx.nodes {
+        if !names.charge() {
+            break;
+        }
+        if in_error(*n, ctx) {
+            continue;
+        }
+        match n.kind() {
+            "class_constant_access_expression" => {
+                let parts = children(*n);
+                if parts.len() == 2 && ctx.source(parts[1]).eq_ignore_ascii_case("class") {
+                    if let Some(class) = names.resolve(parts[0], CLASS) {
+                        if let Some(ClassInfo::Reference(algorithm)) = class_info(&class) {
+                            emit_reference(facts, rules, *n, &class, algorithm);
+                        }
+                    }
+                }
+            }
+            "function_call_expression" => {
+                let Some(function) = n.child_by_field_name("function") else {
+                    continue;
+                };
+                if !matches!(function.kind(), "name" | "qualified_name" | "relative_name") {
+                    names.partial.set(true);
+                    continue;
+                }
+                let Some(name) = names.resolve(function, FUNCTION) else {
+                    continue;
+                };
+                if let Some((algorithm, pqc)) = sodium(&name) {
+                    emit(
+                        facts,
+                        rules,
+                        if pqc { PQC } else { API },
+                        *n,
+                        Some(algorithm),
+                        "explicit_fixed_primitive_request",
+                        "PHP Sodium API request",
+                    );
+                } else if name == "openssl_pkey_new" {
+                    let key = values.value(*n, 0).and_then(|v| match v {
+                        Value::Key(k) => Some(k),
+                        _ => None,
+                    });
+                    if key.is_none() {
+                        names.partial.set(true);
+                    }
+                    emit(
+                        facts,
+                        rules,
+                        API,
+                        *n,
+                        key.map(|k| k.algorithm),
+                        if key.is_some() {
+                            "explicit_key_type_request"
+                        } else {
+                            "unresolved_key_type"
+                        },
+                        "PHP OpenSSL key request",
+                    );
+                } else if matches!(
+                    name.as_str(),
+                    "openssl_public_encrypt"
+                        | "openssl_private_decrypt"
+                        | "openssl_private_encrypt"
+                        | "openssl_public_decrypt"
+                ) {
+                    emit(
+                        facts,
+                        rules,
+                        API,
+                        *n,
+                        Some("RSA"),
+                        "rsa_only_api_request",
+                        "PHP OpenSSL RSA operation",
+                    );
+                } else if matches!(name.as_str(), "openssl_sign" | "openssl_verify") {
+                    let label = if name == "openssl_sign" {
+                        "private_key"
+                    } else {
+                        "public_key"
+                    };
+                    let key = argument(*n, 2, label, ctx.text)
+                        .and_then(|n| values.key(n))
+                        .filter(|k| k.role == Role::OpenSsl);
+                    emit(
+                        facts,
+                        rules,
+                        API,
+                        *n,
+                        key.map(|k| k.algorithm),
+                        if key.is_some() {
+                            "locally_typed_signature_request"
+                        } else {
+                            "unknown_signature_key_type"
+                        },
+                        "PHP OpenSSL signature operation",
+                    );
+                } else if name == "openssl_pkey_derive" {
+                    let a = argument(*n, 0, "public_key", ctx.text).and_then(|n| values.key(n));
+                    let b = argument(*n, 1, "private_key", ctx.text).and_then(|n| values.key(n));
+                    let algorithm = match (a, b) {
+                        (Some(a), Some(b))
+                            if a.role == Role::OpenSsl
+                                && b.role == Role::OpenSsl
+                                && a.algorithm == b.algorithm =>
+                        {
+                            match a.algorithm {
+                                "DH" => Some("DH"),
+                                "EC" => Some("ECDH"),
+                                _ => None,
+                            }
+                        }
+                        _ => None,
+                    };
+                    emit(
+                        facts,
+                        rules,
+                        API,
+                        *n,
+                        algorithm,
+                        if algorithm.is_some() {
+                            "locally_typed_key_agreement_request"
+                        } else {
+                            "unknown_key_agreement_type"
+                        },
+                        "PHP OpenSSL key agreement",
+                    );
+                } else if matches!(
+                    name.as_str(),
+                    "call_user_func"
+                        | "call_user_func_array"
+                        | "forward_static_call"
+                        | "forward_static_call_array"
+                ) {
+                    names.partial.set(true);
+                }
+            }
+            "scoped_call_expression" => {
+                let (Some(scope), Some(method)) = (
+                    n.child_by_field_name("scope"),
+                    n.child_by_field_name("name"),
+                ) else {
+                    continue;
+                };
+                if !matches!(scope.kind(), "name" | "qualified_name" | "relative_name")
+                    || method.kind() != "name"
+                {
+                    names.partial.set(true);
+                    continue;
+                }
+                let (Some(class), Some(method)) =
+                    (names.resolve(scope, CLASS), names.token(method, FUNCTION))
+                else {
+                    continue;
+                };
+                if class == "ffi" {
+                    names.partial.set(true);
+                    continue;
+                }
+                match class_info(&class) {
+                    Some(ClassInfo::Factory(algorithm)) if method == "generatekeypair" => emit(
+                        facts,
+                        rules,
+                        PQC,
+                        *n,
+                        Some(algorithm),
+                        "explicit_pqc_keypair_request",
+                        "PHP ParagonIE key generation",
+                    ),
+                    Some(ClassInfo::Key(key)) if method == "frombytes" => emit(
+                        facts,
+                        rules,
+                        PQC,
+                        *n,
+                        Some(key.algorithm),
+                        "qualified_key_import_reference",
+                        "PHP ParagonIE key import",
+                    ),
+                    Some(ClassInfo::Compat) => {
+                        if let Some((algorithm, _)) = compat_method(&method) {
+                            emit(
+                                facts,
+                                rules,
+                                PQC,
+                                *n,
+                                Some(algorithm),
+                                "qualified_compat_request",
+                                "PHP ParagonIE Compat request",
+                            );
+                        }
+                    }
+                    Some(ClassInfo::Reference(algorithm)) => {
+                        let id = if algorithm == Some("SLH-DSA") {
+                            PQC
+                        } else if algorithm.is_some() {
+                            API
+                        } else {
+                            wrapper_id(&class)
+                        };
+                        emit(
+                            facts,
+                            rules,
+                            id,
+                            *n,
+                            algorithm,
+                            "qualified_library_reference",
+                            if algorithm.is_none() {
+                                wrapper_label(&class)
+                            } else {
+                                "PHP qualified library reference"
+                            },
+                        );
+                    }
+                    _ => {}
+                }
+            }
+            "object_creation_expression" => {
+                let class = children(*n)
+                    .into_iter()
+                    .find(|n| matches!(n.kind(), "name" | "qualified_name" | "relative_name"));
+                let Some(class) = class else {
+                    if children(*n).iter().any(|n| n.kind() == "variable_name") {
+                        names.partial.set(true);
+                    }
+                    continue;
+                };
+                let Some(class) = names.resolve(class, CLASS) else {
+                    continue;
+                };
+                if class.starts_with("reflection") {
+                    names.partial.set(true);
+                }
+                if let Some(ClassInfo::Reference(algorithm)) = class_info(&class) {
+                    if let Some(arguments) = n.child_by_field_name("arguments") {
+                        facts.sensitive_ranges.push(arguments.byte_range());
+                    }
+                    let id = if algorithm == Some("SLH-DSA") {
+                        PQC
+                    } else if algorithm.is_some() {
+                        API
+                    } else {
+                        wrapper_id(&class)
+                    };
+                    emit(
+                        facts,
+                        rules,
+                        id,
+                        if algorithm.is_none() {
+                            children(*n)
+                                .into_iter()
+                                .find(|n| {
+                                    matches!(n.kind(), "name" | "qualified_name" | "relative_name")
+                                })
+                                .expect("resolved class node")
+                        } else {
+                            *n
+                        },
+                        algorithm,
+                        "qualified_library_reference",
+                        if algorithm.is_none() {
+                            wrapper_label(&class)
+                        } else {
+                            "PHP qualified library reference"
+                        },
+                    );
+                }
+            }
+            "member_call_expression" | "nullsafe_member_call_expression" => {
+                let (Some(object), Some(method)) = (
+                    n.child_by_field_name("object"),
+                    n.child_by_field_name("name"),
+                ) else {
+                    continue;
+                };
+                let Some(method) = names.token(method, FUNCTION) else {
+                    names.partial.set(true);
+                    continue;
+                };
+                if !matches!(
+                    method.as_str(),
+                    "sign" | "verify" | "encapsulate" | "decapsulate"
+                ) {
+                    continue;
+                }
+                let key = values.key(object);
+                let expected = match method.as_str() {
+                    "sign" => Role::Sign,
+                    "verify" => Role::Verify,
+                    "encapsulate" => Role::Encap,
+                    _ => Role::Decap,
+                };
+                if let Some(key) = key.filter(|k| k.role == expected) {
+                    emit(
+                        facts,
+                        rules,
+                        PQC,
+                        *n,
+                        Some(key.algorithm),
+                        "bounded_key_receiver_request",
+                        "PHP ParagonIE key operation",
+                    );
+                } else {
+                    names.partial.set(true);
+                }
+            }
+            _ => {}
+        }
+    }
+    facts.partial |= names.partial.get();
+}
+fn in_error(mut node: Node<'_>, ctx: &Context<'_, '_>) -> bool {
+    for _ in 0..64 {
+        if node.kind() == "ERROR" {
+            return true;
+        }
+        let Some(parent) = node.parent() else {
+            return false;
+        };
+        node = parent;
+    }
+    ctx.limit("php_ancestor_depth", 64, 64);
+    true
+}
+
+fn emit_reference(
+    facts: &mut Facts,
+    rules: &RuleSet,
+    node: Node<'_>,
+    class: &str,
+    algorithm: Option<&'static str>,
+) {
+    let id = match algorithm {
+        Some("SLH-DSA") => PQC,
+        Some(_) => API,
+        None => wrapper_id(class),
+    };
+    emit(
+        facts,
+        rules,
+        id,
+        node,
+        algorithm,
+        "qualified_library_reference",
+        if algorithm.is_none() {
+            wrapper_label(class)
+        } else {
+            "PHP qualified library reference"
+        },
+    );
+}
+fn wrapper_id(name: &str) -> &'static str {
+    if matches!(name, "oqs_signature" | "oqs\\oqssig") {
+        API
+    } else {
+        REFERENCE
+    }
+}
+fn wrapper_label(name: &str) -> &'static str {
+    if name.starts_with("oqs\\") {
+        "mir-evgenii/liboqs-php FFI wrapper reference"
+    } else {
+        "Muzosh oqsphp wrapper reference"
+    }
+}
diff --git a/crates/pqc_scan_detectors/src/source_facts/php/names.rs b/crates/pqc_scan_detectors/src/source_facts/php/names.rs
