diff --git a/crates/pqc_scan_detectors/src/source_facts/c_family.rs b/crates/pqc_scan_detectors/src/source_facts/c_family.rs
new file mode 100644
index 0000000..628fddb
--- /dev/null
+++ b/crates/pqc_scan_detectors/src/source_facts/c_family.rs
@@ -0,0 +1,525 @@
+//! Bounded C/C++ source references. No preprocessing, linking or crypto executes.
+mod values;
+use super::{
+    builtin,
+    context::{children, Context},
+    Facts,
+};
+use pqc_scan_rules::RuleSet;
+use tree_sitter::Node;
+use values::{Role, Values};
+const API: &str = "C_FAMILY_CRYPTO_API";
+const PQC: &str = "C_FAMILY_PQC_API";
+const TLS: &str = "C_FAMILY_TLS_REFERENCE";
+fn rule_id(algorithm: Option<&str>) -> &'static str {
+    if algorithm.is_some_and(|a| a.starts_with("ML-") || a.starts_with("SLH-")) {
+        PQC
+    } else {
+        API
+    }
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum SelectorKind {
+    EvpId,
+    EvpName,
+    OqsKem,
+    OqsSig,
+}
+fn exact_algorithm(value: &str) -> Option<String> {
+    if !(matches!(value, "RSA" | "DSA" | "DH" | "EC")
+        || value.starts_with("ML-KEM-")
+        || value.starts_with("ML-DSA-")
+        || value.starts_with("SLH-DSA-")
+        || value.starts_with("Kyber")
+        || value.starts_with("Dilithium"))
+    {
+        return None;
+    }
+    pqc_scan_core::observation::AlgorithmSpec::source_api(value, &Default::default())
+        .map(|_| value.into())
+}
+fn selected_literal(value: &str, kind: SelectorKind) -> Option<String> {
+    if kind == SelectorKind::EvpId {
+        return None;
+    }
+    let mapped = if kind == SelectorKind::OqsSig && value.starts_with("SLH_DSA_PURE_") {
+        let (hash, set) = value.strip_prefix("SLH_DSA_PURE_")?.split_once('_')?;
+        if !matches!(hash, "SHA2" | "SHAKE")
+            || !matches!(set, "128S" | "128F" | "192S" | "192F" | "256S" | "256F")
+        {
+            return None;
+        }
+        format!("SLH-DSA-{hash}-{}", set.to_ascii_lowercase())
+    } else {
+        if kind == SelectorKind::OqsSig && value.starts_with("SLH-DSA-") {
+            return None;
+        }
+        value.into()
+    };
+    let algorithm = exact_algorithm(&mapped)?;
+    match kind {
+        SelectorKind::OqsKem
+            if !algorithm.starts_with("ML-KEM-") && !algorithm.starts_with("Kyber") =>
+        {
+            None
+        }
+        SelectorKind::OqsSig
+            if !algorithm.starts_with("ML-DSA-")
+                && !algorithm.starts_with("SLH-DSA-")
+                && !algorithm.starts_with("Dilithium") =>
+        {
+            None
+        }
+        _ => Some(algorithm),
+    }
+}
+fn low_level(name: &str) -> Option<&'static str> {
+    Some(match name {
+        "RSA_new"
+        | "RSA_generate_key_ex"
+        | "RSA_public_encrypt"
+        | "RSA_private_decrypt"
+        | "RSA_private_encrypt"
+        | "RSA_public_decrypt"
+        | "RSA_sign"
+        | "RSA_verify" => "RSA",
+        "DSA_new"
+        | "DSA_generate_key"
+        | "DSA_generate_parameters_ex"
+        | "DSA_sign"
+        | "DSA_verify" => "DSA",
+        "DH_new" | "DH_generate_key" | "DH_generate_parameters_ex" | "DH_compute_key" => "DH",
+        "EC_KEY_new" | "EC_KEY_new_by_curve_name" | "EC_KEY_generate_key" => "EC",
+        "ECDSA_sign" | "ECDSA_verify" => "EC",
+        "ECDH_compute_key" => "ECDH",
+        _ => return None,
+    })
+}
+fn context_constructor(name: &str) -> bool {
+    matches!(
+        name,
+        "EVP_PKEY_CTX_new_id"
+            | "EVP_PKEY_CTX_new_from_name"
+            | "EVP_PKEY_CTX_new"
+            | "EVP_PKEY_CTX_new_from_pkey"
+            | "EVP_PKEY_CTX_dup"
+    )
+}
+fn context_operation(name: &str) -> bool {
+    matches!(
+        name,
+        "EVP_PKEY_keygen_init"
+            | "EVP_PKEY_keygen"
+            | "EVP_PKEY_generate"
+            | "EVP_PKEY_paramgen_init"
+            | "EVP_PKEY_paramgen"
+            | "EVP_PKEY_encapsulate_init"
+            | "EVP_PKEY_encapsulate"
+            | "EVP_PKEY_decapsulate_init"
+            | "EVP_PKEY_decapsulate"
+            | "EVP_PKEY_sign_init"
+            | "EVP_PKEY_sign"
+            | "EVP_PKEY_verify_init"
+            | "EVP_PKEY_verify"
+            | "EVP_PKEY_encrypt_init"
+            | "EVP_PKEY_encrypt"
+            | "EVP_PKEY_decrypt_init"
+            | "EVP_PKEY_decrypt"
+            | "EVP_PKEY_derive_init"
+            | "EVP_PKEY_derive"
+    )
+}
+fn digest_operation(name: &str) -> bool {
+    matches!(
+        name,
+        "EVP_DigestSignInit"
+            | "EVP_DigestVerifyInit"
+            | "EVP_DigestSignInit_ex"
+            | "EVP_DigestVerifyInit_ex"
+    )
+}
+fn configuration(name: &str) -> bool {
+    matches!(
+        name,
+        "OSSL_PROVIDER_load"
+            | "OSSL_PROVIDER_load_ex"
+            | "EVP_set_default_properties"
+            | "SSL_CTX_set1_groups_list"
+            | "SSL_set1_groups_list"
+    )
+}
+fn known(name: &str) -> bool {
+    low_level(name).is_some()
+        || context_constructor(name)
+        || context_operation(name)
+        || digest_operation(name)
+        || configuration(name)
+        || matches!(
+            name,
+            "OQS_KEM_new"
+                | "OQS_SIG_new"
+                | "OQS_KEM_keypair"
+                | "OQS_KEM_encaps"
+                | "OQS_KEM_decaps"
+                | "OQS_SIG_keypair"
+                | "OQS_SIG_sign"
+                | "OQS_SIG_verify"
+                | "oqs::KeyEncapsulation"
+                | "oqs::Signature"
+        )
+}
+fn function_name(ctx: &Context<'_, '_>, node: Node<'_>) -> Option<String> {
+    let raw = ctx.source(node);
+    if raw.len() > 512 {
+        ctx.limit("c_family_api_identifier_bytes", 512, 512);
+        return None;
+    }
+    Some(raw.split_whitespace().collect())
+}
+fn args(node: Node<'_>) -> Vec<Node<'_>> {
+    let arg = if matches!(node.kind(), "argument_list" | "initializer_list") {
+        Some(node)
+    } else {
+        node.child_by_field_name("arguments")
+    };
+    arg.map(children)
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|n| !n.kind().contains("comment"))
+        .collect()
+}
+fn conditional(mut node: Node<'_>) -> bool {
+    for _ in 0..64 {
+        if matches!(
+            node.kind(),
+            "preproc_if"
+                | "preproc_ifdef"
+                | "preproc_elif"
+                | "preproc_else"
+                | "if_statement"
+                | "conditional_expression"
+                | "switch_statement"
+                | "while_statement"
+                | "for_statement"
+                | "template_declaration"
+        ) {
+            return true;
+        }
+        let Some(parent) = node.parent() else {
+            return false;
+        };
+        node = parent;
+    }
+    true
+}
+fn emit(
+    facts: &mut Facts,
+    rules: &RuleSet,
+    node: Node<'_>,
+    id: &'static str,
+    algorithm: Option<&str>,
+    reason: &'static str,
+) {
+    if rules.get(id).is_some_and(builtin) {
+        let names: Vec<_> = algorithm.into_iter().collect();
+        facts.source_api(
+            id,
+            node,
+            reason,
+            &names,
+            if id == TLS {
+                "C/C++ TLS or cryptographic include reference"
+            } else {
+                "C/C++ cryptographic source reference"
+            },
+        );
+    }
+}
+pub(super) fn inspect(ctx: &Context<'_, '_>, facts: &mut Facts, rules: &RuleSet) {
+    let values = Values::new(ctx);
+    for node in &ctx.nodes {
+        if !values.charge() {
+            break;
+        }
+        if node.kind().starts_with("preproc_")
+            && !matches!(node.kind(), "preproc_include" | "preproc_arg")
+        {
+            facts.partial = true;
+        }
+        if node.kind() == "preproc_include" {
+            if let Some(path) = node.child_by_field_name("path") {
+                let raw = ctx.bounded_source(path);
+                if matches!(
+                    raw,
+                    "<openssl/evp.h>"
+                        | "<openssl/rsa.h>"
+                        | "<openssl/dsa.h>"
+                        | "<openssl/dh.h>"
+                        | "<openssl/ec.h>"
+                        | "<openssl/ssl.h>"
+                        | "<openssl/provider.h>"
+                        | "<oqs/oqs.h>"
+                        | "<oqs_cpp.hpp>"
+                        | "\"oqs_cpp.hpp\""
+                ) {
+                    let before = facts.hits.get(TLS).map_or(0, Vec::len);
+                    emit(
+                        facts,
+                        rules,
+                        *node,
+                        TLS,
+                        None,
+                        "include_reference_not_linked_or_enabled",
+                    );
+                    if let Some(hit) = facts.hits.get_mut(TLS).and_then(|h| h.get_mut(before)) {
+                        let label = if raw.contains("oqs_cpp") {
+                            "C/C++ liboqs-cpp include reference"
+                        } else if raw.contains("oqs/oqs") {
+                            "C/C++ liboqs include reference"
+                        } else {
+                            "C/C++ OpenSSL include reference"
+                        };
+                        hit.safe_preview = Some(label.into());
+                        hit.source_library =
+                            pqc_scan_core::observation::SourceLibraryReference::from_label(label);
+                    }
+                }
+            }
+            continue;
+        }
+        if node.kind() == "declaration" {
+            if let Some(ty) = node.child_by_field_name("type") {
+                let name = ctx.bounded_source(ty).replace(' ', "");
+                if matches!(name.as_str(), "oqs::KeyEncapsulation" | "oqs::Signature")
+                    && !values.oqs_shadowed()
+                {
+                    if !values.api_available(&name, ty) {
+                        facts.partial = true;
+                        continue;
+                    }
+                    let mut cursor = node.walk();
+                    for (i, decl) in node
+                        .children_by_field_name("declarator", &mut cursor)
+                        .enumerate()
+                    {
+                        if let Some(arguments) = decl
+                            .child_by_field_name("value")
+                            .filter(|n| matches!(n.kind(), "argument_list" | "initializer_list"))
+                        {
+                            let role = if name == "oqs::KeyEncapsulation" {
+                                Role::CppKem
+                            } else {
+                                Role::CppSig
+                            };
+                            let algorithm =
+                                values.cpp_constructor(arguments, role).map(|k| k.algorithm);
+                            if algorithm.is_none() || conditional(*node) {
+                                facts.partial = true;
+                            }
+                            let id = rule_id(algorithm.as_deref());
+                            if rules.get(id).is_some_and(builtin) {
+                                let start = if i == 0 {
+                                    ty.start_byte()
+                                } else {
+                                    decl.start_byte()
+                                };
+                                let names: Vec<_> = algorithm.as_deref().into_iter().collect();
+                                facts.source_api_range(
+                                    id,
+                                    start..decl.end_byte(),
+                                    "qualified_cpp_constructor",
+                                    &names,
+                                    "C/C++ cryptographic source reference",
+                                );
+                                facts.sensitive_ranges.push(arguments.byte_range());
+                            }
+                        }
+                    }
+                }
+            }
+            continue;
+        }
+        if node.kind() == "new_expression" {
+            if node.child_by_field_name("type").is_some_and(|t| {
+                matches!(
+                    ctx.bounded_source(t).replace(' ', "").as_str(),
+                    "oqs::KeyEncapsulation" | "oqs::Signature"
+                )
+            }) {
+                if values.oqs_shadowed() {
+                    facts.partial = true;
+                    continue;
+                }
+                let key = values.constructor(*node, 0);
+                if key.is_none() || conditional(*node) {
+                    facts.partial = true;
+                }
+                let algorithm = key.as_ref().map(|k| k.algorithm.as_str());
+                emit(
+                    facts,
+                    rules,
+                    *node,
+                    rule_id(algorithm),
+                    algorithm,
+                    "qualified_cpp_new_reference_pointer_flow_unresolved",
+                );
+            }
+            continue;
+        }
+        if node.kind() != "call_expression" {
+            continue;
+        }
+        let Some(function) = node.child_by_field_name("function") else {
+            continue;
+        };
+        let arguments = args(*node);
+        let Some(name) = function_name(ctx, function) else {
+            continue;
+        };
+        let name = name.strip_prefix("::").unwrap_or(&name);
+        if let Some((receiver, method)) = values.receiver(function) {
+            if let Some(key) = values.key(receiver, node.start_byte(), 0) {
+                let allowed = match key.role {
+                    Role::CppKem => {
+                        matches!(method, "generate_keypair" | "encap_secret" | "decap_secret")
+                    }
+                    Role::CppSig => matches!(method, "generate_keypair" | "sign" | "verify"),
+                    _ => false,
+                };
+                if allowed {
+                    emit(
+                        facts,
+                        rules,
+                        *node,
+                        rule_id(Some(&key.algorithm)),
+                        Some(&key.algorithm),
+                        "bounded_cpp_receiver",
+                    );
+                }
+            } else if values.was_bound(receiver) {
+                facts.partial = true;
+            }
+            continue;
+        }
+        if !known(name) {
+            continue;
+        }
+        if !values.api_available(name, function) {
+            facts.partial = true;
+            continue;
+        }
+        if conditional(*node) {
+            facts.partial = true
+        }
+        if let Some(algorithm) = low_level(name) {
+            emit(
+                facts,
+                rules,
+                *node,
+                API,
+                Some(algorithm),
+                "explicit_low_level_api",
+            );
+            continue;
+        }
+        if configuration(name) {
+            let before = facts.hits.get(API).map_or(0, Vec::len);
+            emit(
+                facts,
+                rules,
+                *node,
+                API,
+                None,
+                "configuration_reference_not_activation_or_negotiation",
+            );
+            let reference = arguments
+                .get(1)
+                .and_then(|n| values.literal(*n, node.start_byte(), 0))
+                .and_then(|v| {
+                    use pqc_scan_core::observation::SourceConfigurationReference as C;
+                    if name.starts_with("OSSL_PROVIDER_") {
+                        C::provider(&v)
+                    } else if name == "EVP_set_default_properties" {
+                        C::property(&v)
+                    } else {
+                        C::tls_groups(&v)
+                    }
+                });
+            if reference.is_none() {
+                facts.partial = true;
+            }
+            if let Some(hit) = facts.hits.get_mut(API).and_then(|h| h.get_mut(before)) {
+                if let Some(reference) = &reference {
+                    hit.safe_preview = Some(reference.label());
+                }
+                hit.source_configuration = reference;
+            }
+            continue;
+        }
+        if context_constructor(name)
+            || matches!(
+                name,
+                "OQS_KEM_new" | "OQS_SIG_new" | "oqs::KeyEncapsulation" | "oqs::Signature"
+            )
+        {
+            let key = values.constructor(*node, 0);
+            if key.is_none() {
+                facts.partial = true
+            }
+            let algorithm = key.as_ref().map(|k| k.algorithm.as_str());
+            emit(
+                facts,
+                rules,
+                *node,
+                rule_id(algorithm),
+                algorithm,
+                "explicit_algorithm_or_unresolved_selector",
+            );
+            continue;
+        }
+        let (key_node, role) = if digest_operation(name) {
+            (
+                arguments
+                    .get(if name.ends_with("_ex") { 5 } else { 4 })
+                    .copied(),
+                Role::Key,
+            )
+        } else if context_operation(name) {
+            (arguments.first().copied(), Role::Context)
+        } else {
+            (
+                arguments.first().copied(),
+                if name.starts_with("OQS_KEM_") {
+                    Role::OqsKem
+                } else {
+                    Role::OqsSig
+                },
+            )
+        };
+        let mut key = key_node
+            .and_then(|n| values.key(n, node.start_byte(), 0))
+            .filter(|k| k.role == role);
+        if let Some(key) = &mut key {
+            if name.starts_with("EVP_PKEY_derive") && key.algorithm == "EC" {
+                key.algorithm = "ECDH".into();
+            }
+        }
+        if key.is_none() && key_node.is_some_and(|n| values.was_bound(n)) {
+            facts.partial = true;
+        }
+        let algorithm = key.as_ref().map(|k| k.algorithm.as_str());
+        let id = if name.starts_with("OQS_") && algorithm.is_none() {
+            PQC
+        } else {
+            rule_id(algorithm)
+        };
+        emit(
+            facts,
+            rules,
+            *node,
+            id,
+            algorithm,
+            "bounded_key_or_context_operation",
+        );
+    }
+}
diff --git a/crates/pqc_scan_detectors/src/source_facts/c_family/values.rs b/crates/pqc_scan_detectors/src/source_facts/c_family/values.rs
new file mode 100644
index 0000000..65a7102
--- /dev/null
+++ b/crates/pqc_scan_detectors/src/source_facts/c_family/values.rs
@@ -0,0 +1,828 @@
+use super::{
+    args, conditional, context_constructor, function_name, known, low_level, selected_literal,
+    SelectorKind,
+};
+use crate::source_facts::context::{children, Context};
+use std::{
+    cell::Cell,
+    collections::{BTreeSet, HashMap, HashSet},
+};
+use tree_sitter::Node;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Role {
+    Context,
+    Key,
+    LowLevelKey,
+    OqsKem,
+    OqsSig,
+    CppKem,
+    CppSig,
+}
+#[derive(Clone, Debug)]
+pub(super) struct Key {
+    pub role: Role,
+    pub algorithm: String,
+}
+#[derive(Clone, Copy)]
+enum Value<'a> {
+    Node(Node<'a>),
+    Generated(Node<'a>),
+    ContextFromKey(Node<'a>),
+    Cpp(Node<'a>, Role),
+    Unknown,
+}
+#[derive(Clone, Copy)]
+struct Binding<'a> {
+    at: usize,
+    value: Value<'a>,
+}
+pub(super) struct Values<'a, 's, 'c> {
+    ctx: &'c Context<'a, 's>,
+    bindings: HashMap<(usize, String), Vec<Binding<'a>>>,
+    overflows: HashMap<(usize, String), usize>,
+    globals: HashSet<String>,
+    symbols: HashMap<usize, HashMap<String, usize>>,
+    macros: HashSet<String>,
+    oqs_shadow: bool,
+    barriers: HashMap<usize, BTreeSet<usize>>,
+    scalar_barriers: HashMap<usize, BTreeSet<usize>>,
+    work: Cell<usize>,
+    names_incomplete: Cell<bool>,
+}
+impl<'a, 's, 'c> Values<'a, 's, 'c> {
+    pub fn new(ctx: &'c Context<'a, 's>) -> Self {
+        let mut out = Self {
+            ctx,
+            bindings: HashMap::new(),
+            overflows: HashMap::new(),
+            globals: HashSet::new(),
+            symbols: HashMap::new(),
+            macros: HashSet::new(),
+            oqs_shadow: false,
+            barriers: HashMap::new(),
+            scalar_barriers: HashMap::new(),
+            work: Cell::new(0),
+            names_incomplete: Cell::new(false),
+        };
+        for node in &ctx.nodes {
+            if !out.charge() {
+                break;
+            }
+            if matches!(
+                node.kind(),
+                "preproc_def" | "preproc_function_def" | "preproc_undef"
+            ) {
+                if let Some(n) = node.child_by_field_name("name").or_else(|| {
+                    children(*node)
+                        .into_iter()
+                        .find(|n| n.kind() == "identifier")
+                }) {
+                    out.macros.insert(ctx.bounded_source(n).into());
+                }
+            }
+            if matches!(
+                node.kind(),
+                "namespace_definition"
+                    | "namespace_alias_definition"
+                    | "class_specifier"
+                    | "struct_specifier"
+            ) && node
+                .child_by_field_name("name")
+                .is_some_and(|n| ctx.bounded_source(n) == "oqs")
+            {
+                out.oqs_shadow = true;
+            }
+            if matches!(
+                node.kind(),
+                "type_parameter_declaration"
+                    | "optional_type_parameter_declaration"
+                    | "variadic_type_parameter_declaration"
+            ) {
+                if let Some(name) = node.child_by_field_name("name").or_else(|| {
+                    children(*node)
+                        .into_iter()
+                        .find(|n| n.kind() == "type_identifier")
+                }) {
+                    out.add_symbol(ctx.scope(*node), name, node.end_byte());
+                }
+            }
+            if node.kind().ends_with("parameter_declaration")
+                && node
+                    .parent()
+                    .is_some_and(|p| p.kind() == "template_parameter_list")
+            {
+                if let Some(name) = node
+                    .child_by_field_name("declarator")
+                    .and_then(|n| out.declarator(n))
+                {
+                    out.add_symbol(ctx.scope(*node), name, node.end_byte());
+                }
+            }
+            if node.kind() == "using_declaration" {
+                if let Some(qualified) = children(*node)
+                    .into_iter()
+                    .find(|n| n.kind() == "qualified_identifier")
+                {
+                    if let Some(name) = qualified.child_by_field_name("name") {
+                        out.add_symbol(ctx.scope(*node), name, node.end_byte());
+                    }
+                }
+            }
+            if node.kind() == "function_definition" {
+                if let Some(name) = node
+                    .child_by_field_name("declarator")
+                    .and_then(|n| out.declarator(n))
+                {
+                    out.globals.insert(ctx.bounded_source(name).into());
+                }
+            }
+            if node.kind() == "enumerator" {
+                if let Some(name) = node.child_by_field_name("name") {
+                    out.add(ctx.scope(*node), name, node.end_byte(), Value::Unknown);
+                    if ctx.function_scope(ctx.scope(*node)) == 0 {
+                        out.globals.insert(ctx.bounded_source(name).into());
+                    }
+                }
+            }
+            if matches!(
+                node.kind(),
+                "type_definition"
+                    | "alias_declaration"
+                    | "class_specifier"
+                    | "struct_specifier"
+                    | "enum_specifier"
+            ) {
+                if let Some(name) = node.child_by_field_name("name").or_else(|| {
+                    node.child_by_field_name("declarator")
+                        .and_then(|n| out.declarator(n))
+                }) {
+                    out.add(ctx.scope(*node), name, node.end_byte(), Value::Unknown);
+                    if ctx.function_scope(ctx.scope(*node)) == 0 {
+                        out.globals.insert(ctx.bounded_source(name).into());
+                    }
+                }
+            }
+            if matches!(
+                node.kind(),
+                "declaration"
+                    | "parameter_declaration"
+                    | "optional_parameter_declaration"
+                    | "field_declaration"
+            ) {
+                let mut cursor = node.walk();
+                for decl in node.children_by_field_name("declarator", &mut cursor) {
+                    let Some(name) = out.declarator(decl) else {
+                        continue;
+                    };
+                    let mut value = decl
+                        .child_by_field_name("value")
+                        .map(Value::Node)
+                        .unwrap_or(Value::Unknown);
+                    if let Some(ty) = node.child_by_field_name("type") {
+                        let role = match ctx.bounded_source(ty).replace(' ', "").as_str() {
+                            "oqs::KeyEncapsulation" => Some(Role::CppKem),
+                            "oqs::Signature" => Some(Role::CppSig),
+                            _ => None,
+                        };
+                        if let (Some(role), Some(arguments)) = (
+                            role,
+                            decl.child_by_field_name("value").filter(|n| {
+                                matches!(n.kind(), "argument_list" | "initializer_list")
+                            }),
+                        ) {
+                            value = Value::Cpp(arguments, role);
+                        }
+                    }
+                    if conditional(*node) || ctx.function_scope(ctx.scope(*node)) == 0 {
+                        value = Value::Unknown;
+                    }
+                    out.add(ctx.scope(*node), name, node.end_byte(), value);
+                    if node.kind() == "declaration" && ctx.function_scope(ctx.scope(*node)) == 0 {
+                        out.globals.insert(ctx.bounded_source(name).into());
+                    }
+                }
+            }
+        }
+        for node in &ctx.nodes {
+            if !out.charge() {
+                break;
+            }
+            if node.kind() == "assignment_expression" {
+                if let (Some(left), Some(right)) = (
+                    node.child_by_field_name("left"),
+                    node.child_by_field_name("right"),
+                ) {
+                    if left.kind() == "identifier" {
+                        let scope = out
+                            .binding_scope(left, node.start_byte())
+                            .unwrap_or(ctx.scope(*node));
+                        let plain = node
+                            .child_by_field_name("operator")
+                            .is_some_and(|n| ctx.source(n) == "=");
+                        out.add(
+                            scope,
+                            left,
+                            node.end_byte(),
+                            if plain && !conditional(*node) {
+                                Value::Node(right)
+                            } else {
+                                Value::Unknown
+                            },
+                        );
+                    } else {
+                        out.invalidate_all(*node);
+                    }
+                }
+            }
+            if node.kind() == "update_expression" {
+                if let Some(n) = node
+                    .child_by_field_name("argument")
+                    .filter(|n| n.kind() == "identifier")
+                {
+                    let scope = out
+                        .binding_scope(n, node.start_byte())
+                        .unwrap_or(ctx.scope(*node));
+                    out.add(scope, n, node.end_byte(), Value::Unknown);
+                }
+            }
+            if node.kind() == "call_expression" {
+                let Some(function) = node.child_by_field_name("function") else {
+                    continue;
+                };
+                let Some(name) = function_name(ctx, function) else {
+                    continue;
+                };
+                let name = name.strip_prefix("::").unwrap_or(&name);
+                let arguments = args(*node);
+                let output_indices: &[usize] = match name {
+                    "OQS_KEM_keypair" | "OQS_KEM_encaps" | "OQS_SIG_keypair" | "OQS_SIG_sign" => {
+                        &[1, 2]
+                    }
+                    "OQS_KEM_decaps" => &[1],
+                    "EVP_PKEY_encapsulate" => &[1, 2, 3, 4],
+                    "EVP_PKEY_decapsulate"
+                    | "EVP_PKEY_encrypt"
+                    | "EVP_PKEY_decrypt"
+                    | "EVP_PKEY_sign"
+                    | "EVP_PKEY_derive" => &[1, 2],
+                    "RSA_public_encrypt"
+                    | "RSA_private_encrypt"
+                    | "RSA_public_decrypt"
+                    | "RSA_private_decrypt" => &[2],
+                    "RSA_sign" | "DSA_sign" | "ECDSA_sign" => &[3, 4],
+                    "DH_compute_key" | "ECDH_compute_key" => &[0],
+                    _ => &[],
+                };
+                if !output_indices.is_empty()
+                    && out.api_available(name, function)
+                    && output_indices.iter().any(|i| {
+                        arguments
+                            .get(*i)
+                            .is_some_and(|n| !matches!(ctx.source(*n), "NULL" | "nullptr" | "0"))
+                    })
+                {
+                    out.scalar_barriers
+                        .entry(ctx.function_scope(ctx.scope(*node)))
+                        .or_default()
+                        .insert(node.end_byte());
+                }
+                if matches!(
+                    name,
+                    "EVP_PKEY_keygen" | "EVP_PKEY_generate" | "EVP_PKEY_paramgen"
+                ) && out.api_available(name, function)
+                {
+                    if let Some(output) = arguments.get(1).and_then(|n| out.addressed(*n)) {
+                        let scope = out
+                            .binding_scope(output, node.start_byte())
+                            .unwrap_or(ctx.scope(*node));
+                        let value = if conditional(*node) {
+                            Value::Unknown
+                        } else {
+                            arguments
+                                .first()
+                                .copied()
+                                .map(Value::Generated)
+                                .unwrap_or(Value::Unknown)
+                        };
+                        out.add(scope, output, node.end_byte(), value);
+                    } else {
+                        out.invalidate_all(*node);
+                    }
+                } else if super::digest_operation(name) && out.api_available(name, function) {
+                    if let Some(output) = arguments.get(1).and_then(|n| out.addressed(*n)) {
+                        let scope = out
+                            .binding_scope(output, node.start_byte())
+                            .unwrap_or(ctx.scope(*node));
+                        let key = arguments
+                            .get(if name.ends_with("_ex") { 5 } else { 4 })
+                            .copied();
+                        let value = if conditional(*node) {
+                            Value::Unknown
+                        } else {
+                            key.map(Value::ContextFromKey).unwrap_or(Value::Unknown)
+                        };
+                        out.add(scope, output, node.end_byte(), value);
+                    } else if !arguments
+                        .get(1)
+                        .is_some_and(|n| matches!(ctx.source(*n), "NULL" | "nullptr" | "0"))
+                    {
+                        out.invalidate_all(*node);
+                    }
+                } else {
+                    let safe_c = known(name) && out.api_available(name, function);
+                    let safe_cpp = out
+                        .receiver(function)
+                        .and_then(|(receiver, method)| {
+                            out.key(receiver, node.start_byte(), 0)
+                                .map(|key| (key.role, method))
+                        })
+                        .is_some_and(|(role, method)| match role {
+                            Role::CppKem => matches!(
+                                method,
+                                "generate_keypair" | "encap_secret" | "decap_secret"
+                            ),
+                            Role::CppSig => {
+                                matches!(method, "generate_keypair" | "sign" | "verify")
+                            }
+                            _ => false,
+                        });
+                    if !safe_c && !safe_cpp {
+                        out.invalidate_all(*node);
+                    }
+                }
+            }
+        }
+        out
+    }
+    fn invalidate_all(&mut self, node: Node<'_>) {
+        let barriers = self
+            .barriers
+            .entry(self.ctx.function_scope(self.ctx.scope(node)))
+            .or_default();
+        barriers.insert(node.end_byte());
+    }
+
+    pub fn charge(&self) -> bool {
+        let n = self.work.get();
+        let limit = self.ctx.budget.max_ast_nodes.saturating_mul(8);
+        if n >= limit {
+            self.names_incomplete.set(true);
+            self.ctx.limit("c_family_resolution_work", limit, n);
+            return false;
+        }
+        self.work.set(n + 1);
+        true
+    }
+    fn identifier(&self, node: Node<'_>) -> Option<String> {
+        let value = self.ctx.bounded_source(node);
+        if value.len() > 256 {
+            self.ctx.limit("c_family_identifier_bytes", 256, 256);
+            return None;
+        }
+        (matches!(
+            node.kind(),
+            "identifier" | "type_identifier" | "namespace_identifier"
+        ) && !value.is_empty())
+        .then(|| value.into())
+    }
+    fn declarator(&self, mut node: Node<'a>) -> Option<Node<'a>> {
+        for _ in 0..8 {
+            if matches!(node.kind(), "identifier" | "type_identifier") {
+                return Some(node);
+            }
+            node = if node.kind() == "parenthesized_declarator" {
+                *children(node).first()?
+            } else {
+                node.child_by_field_name("declarator")?
+            };
+        }
+        self.ctx.limit("c_family_declarator_depth", 8, 8);
+        self.names_incomplete.set(true);
+        None
+    }
+    fn add(&mut self, scope: usize, node: Node<'a>, at: usize, value: Value<'a>) {
+        let Some(name) = self.identifier(node) else {
+            return;
+        };
+        let key = (scope, name);
+        let bindings = self.bindings.entry(key.clone()).or_default();
+        if bindings.len() >= 64 {
+            self.ctx.limit("c_family_same_name_bindings", 64, 64);
+            self.overflows
+                .entry(key)
+                .and_modify(|old| *old = (*old).min(at))
+                .or_insert(at);
+            return;
+        }
+        let index = bindings.partition_point(|b| b.at <= at);
+        bindings.insert(index, Binding { at, value });
+    }
+
+    fn binding_scope(&self, node: Node<'_>, at: usize) -> Option<usize> {
+        let name = self.identifier(node)?;
+        let function = self.ctx.function_scope(self.ctx.scope(node));
+        let mut scope = Some(self.ctx.scope(node));
+        for _ in 0..64 {
+            if !self.charge() {
+                return None;
+            }
+            let s = scope?;
+            if self.ctx.function_scope(s) != function {
+                return None;
+            }
+            if self
+                .bindings
+                .get(&(s, name.clone()))
+                .is_some_and(|b| b.first().is_some_and(|v| v.at <= at))
+            {
+                return Some(s);
+            }
+            scope = self.ctx.scope_parent(s);
+        }
+        self.ctx.limit("c_family_scope_depth", 64, 64);
+        self.names_incomplete.set(true);
+        None
+    }
+    fn binding(&self, node: Node<'_>, at: usize) -> Option<Binding<'a>> {
+        if !self.charge() {
+            return None;
+        }
+        let name = self.identifier(node)?;
+        let scope = self.binding_scope(node, at)?;
+        let key = (scope, name);
+        let entries = self.bindings.get(&key)?;
+        let index = entries.partition_point(|b| b.at <= at).checked_sub(1)?;
+        let binding = entries[index];
+        let function = self.ctx.function_scope(self.ctx.scope(node));
+        let mutated = self.barriers.get(&function).is_some_and(|bs| {
+            bs.range(..=at)
+                .next_back()
+                .is_some_and(|last| *last > binding.at)
+        });
+        if mutated || self.overflows.get(&key).is_some_and(|first| at >= *first) {
+            return Some(Binding {
+                at: binding.at,
+                value: Value::Unknown,
+            });
+        }
+        Some(binding)
+    }
+    fn scalar_binding(&self, node: Node<'_>, at: usize) -> Option<Binding<'a>> {
+        let binding = self.binding(node, at)?;
+        let function = self.ctx.function_scope(self.ctx.scope(node));
+        if self.scalar_barriers.get(&function).is_some_and(|barriers| {
+            barriers
+                .range(..=at)
+                .next_back()
+                .is_some_and(|last| *last > binding.at)
+        }) {
+            Some(Binding {
+                at: binding.at,
+                value: Value::Unknown,
+            })
+        } else {
+            Some(binding)
+        }
+    }
+    fn add_symbol(&mut self, scope: usize, node: Node<'_>, at: usize) {
+        if let Some(name) = self.identifier(node) {
+            self.symbols
+                .entry(scope)
+                .or_default()
+                .entry(name)
+                .and_modify(|old| *old = (*old).min(at))
+                .or_insert(at);
+        }
+    }
+    fn symbol_shadowed(&self, name: &str, node: Node<'_>, at: usize) -> bool {
+        if self.symbols.is_empty() {
+            return false;
+        }
+        if self.ctx.source(node).trim_start().starts_with("::") {
+            return self
+                .symbols
+                .get(&0)
+                .and_then(|s| s.get(name))
+                .is_some_and(|start| *start <= at);
+        }
+        let mut scope = Some(self.ctx.scope(node));
+        for _ in 0..64 {
+            if !self.charge() {
+                return true;
+            }
+            let Some(s) = scope else { return false };
+            if self
+                .symbols
+                .get(&s)
+                .and_then(|m| m.get(name))
+                .is_some_and(|start| *start <= at)
+            {
+                return true;
+            }
+            scope = self.ctx.scope_parent(s);
+        }
+        self.ctx.limit("c_family_symbol_scope_depth", 64, 64);
+        self.names_incomplete.set(true);
+        true
+    }
+    pub fn api_available(&self, name: &str, node: Node<'_>) -> bool {
+        if name.len() > 512 {
+            self.ctx.limit("c_family_api_identifier_bytes", 512, 512);
+            return false;
+        }
+        let shadowed = self.binding(node, node.start_byte()).is_some()
+            || self.symbol_shadowed(name, node, node.start_byte())
+            || (name.starts_with("oqs::")
+                && (self.symbol_shadowed("oqs", node, node.start_byte())
+                    || (!self.ctx.source(node).trim_start().starts_with("::")
+                        && node.child_by_field_name("scope").is_some_and(|scope| {
+                            self.binding(scope, node.start_byte()).is_some()
+                        }))));
+        !self.names_incomplete.get()
+            && !self.macros.contains(name)
+            && !self.globals.contains(name)
+            && (!name.starts_with("oqs::") || !self.oqs_shadowed())
+            && !shadowed
+    }
+    pub fn oqs_shadowed(&self) -> bool {
+        self.names_incomplete.get()
+            || self.oqs_shadow
+            || self.macros.contains("oqs")
+            || self.globals.contains("oqs")
+    }
+    pub fn was_bound(&self, node: Node<'_>) -> bool {
+        self.binding_scope(node, node.start_byte()).is_some()
+    }
+    pub fn receiver(&self, node: Node<'a>) -> Option<(Node<'a>, &'s str)> {
+        if node.kind() != "field_expression" {
+            return None;
+        }
+        let receiver = node.child_by_field_name("argument")?;
+        if receiver.kind() != "identifier" {
+            return None;
+        }
+        let field = node.child_by_field_name("field")?;
+        Some((receiver, self.ctx.bounded_source(field)))
+    }
+    fn addressed(&self, node: Node<'a>) -> Option<Node<'a>> {
+        if node.kind() == "pointer_expression"
+            && node
+                .child_by_field_name("operator")
+                .is_some_and(|n| self.ctx.source(n) == "&")
+        {
+            node.child_by_field_name("argument")
+                .filter(|n| n.kind() == "identifier")
+        } else {
+            None
+        }
+    }
+    pub fn literal(&self, node: Node<'a>, at: usize, depth: usize) -> Option<String> {
+        if depth > 8 {
+            self.ctx.limit("c_family_alias_depth", 8, 8);
+            return None;
+        }
+        if !self.charge() {
+            return None;
+        }
+        if node.kind() == "string_literal" {
+            let raw = self.ctx.bounded_source(node);
+            return raw
+                .strip_prefix('"')
+                .and_then(|s| s.strip_suffix('"'))
+                .filter(|s| s.len() <= 512 && !s.contains(['\\', '"']))
+                .map(str::to_owned);
+        }
+        if let Some(binding) = self.scalar_binding(node, at) {
+            if let Value::Node(value) = binding.value {
+                return self.literal(
+                    value,
+                    value.start_byte(),
+                    depth + usize::from(value.kind() != "string_literal"),
+                );
+            }
+        }
+        None
+    }
+    fn selector(
+        &self,
+        node: Option<Node<'a>>,
+        at: usize,
+        depth: usize,
+        kind: SelectorKind,
+    ) -> Option<String> {
+        let n = node?;
+        if depth > 8 {
+            self.ctx.limit("c_family_alias_depth", 8, 8);
+            return None;
+        }
+        if !self.charge() {
+            return None;
+        }
+        if n.kind() == "string_literal" {
+            let raw = self.ctx.bounded_source(n);
+            return raw
+                .strip_prefix('"')
+                .and_then(|s| s.strip_suffix('"'))
+                .filter(|s| !s.contains(['\\', '"']))
+                .and_then(|value| selected_literal(value, kind));
+        }
+        if n.kind() == "identifier" {
+            if let Some(binding) = self.scalar_binding(n, at) {
+                return match binding.value {
+                    Value::Node(value) => self.selector(
+                        Some(value),
+                        value.start_byte(),
+                        depth + usize::from(value.kind() != "string_literal"),
+                        kind,
+                    ),
+                    _ => None,
+                };
+            }
+            let name = self.ctx.bounded_source(n);
+            if self.macros.contains(name)
+                || self.globals.contains(name)
+                || self.symbol_shadowed(name, n, at)
+            {
+                return None;
+            }
+            if kind == SelectorKind::EvpId {
+                return name
+                    .strip_prefix("EVP_PKEY_")
+                    .filter(|s| matches!(*s, "RSA" | "DSA" | "DH" | "EC"))
+                    .map(str::to_owned);
+            }
+            if let Some(s) = name.strip_prefix("OQS_KEM_alg_ml_kem_") {
+                return selected_literal(&format!("ML-KEM-{s}"), kind);
+            }
+            if let Some(s) = name.strip_prefix("OQS_SIG_alg_ml_dsa_") {
+                return selected_literal(&format!("ML-DSA-{s}"), kind);
+            }
+            if let Some(s) = name.strip_prefix("OQS_SIG_alg_slh_dsa_pure_") {
+                let (hash, set) = s.split_once('_')?;
+                if !matches!(hash, "sha2" | "shake")
+                    || !matches!(set, "128s" | "128f" | "192s" | "192f" | "256s" | "256f")
+                {
+                    return None;
+                }
+                return selected_literal(
+                    &format!(
+                        "SLH_DSA_PURE_{}_{}",
+                        hash.to_ascii_uppercase(),
+                        set.to_ascii_uppercase()
+                    ),
+                    kind,
+                );
+            }
+        }
+        None
+    }
+    pub fn constructor(&self, node: Node<'a>, depth: usize) -> Option<Key> {
+        let function = node
+            .child_by_field_name("function")
+            .or_else(|| node.child_by_field_name("type"))?;
+        let name = function_name(self.ctx, function)?;
+        let name = name.strip_prefix("::").unwrap_or(&name);
+        if !self.api_available(name, function) {
+            return None;
+        }
+        let arguments = args(node);
+        let at = node.start_byte();
+        let (role, selector) = match name {
+            "EVP_PKEY_CTX_new_id" => (Role::Context, arguments.first().copied()),
+            "EVP_PKEY_CTX_new_from_name" => (Role::Context, arguments.get(1).copied()),
+            "OQS_KEM_new" => (Role::OqsKem, arguments.first().copied()),
+            "OQS_SIG_new" => (Role::OqsSig, arguments.first().copied()),
+            "oqs::KeyEncapsulation" => (Role::CppKem, arguments.first().copied()),
+            "oqs::Signature" => (Role::CppSig, arguments.first().copied()),
+            _ => {
+                if context_constructor(name) {
+                    let offset = usize::from(name == "EVP_PKEY_CTX_new_from_pkey");
+                    let mut key = self.key(*arguments.get(offset)?, at, depth + 1)?;
+                    let required = if name == "EVP_PKEY_CTX_dup" {
+                        Role::Context
+                    } else {
+                        Role::Key
+                    };
+                    if key.role != required {
+                        return None;
+                    }
+                    key.role = Role::Context;
+                    return Some(key);
+                }
+                let algorithm = low_level(name)?;
+                if !matches!(
+                    name,
+                    "RSA_new" | "DSA_new" | "DH_new" | "EC_KEY_new" | "EC_KEY_new_by_curve_name"
+                ) {
+                    return None;
+                }
+                return Some(Key {
+                    role: Role::LowLevelKey,
+                    algorithm: algorithm.into(),
+                });
+            }
+        };
+        let kind = if name == "EVP_PKEY_CTX_new_id" {
+            SelectorKind::EvpId
+        } else {
+            match role {
+                Role::OqsKem | Role::CppKem => SelectorKind::OqsKem,
+                Role::OqsSig | Role::CppSig => SelectorKind::OqsSig,
+                _ => SelectorKind::EvpName,
+            }
+        };
+        let algorithm = self.selector(selector, at, 0, kind)?;
+        Self::valid_role(role, &algorithm).then_some(Key { role, algorithm })
+    }
+    fn valid_role(role: Role, algorithm: &str) -> bool {
+        match role {
+            Role::OqsKem | Role::CppKem => {
+                algorithm.starts_with("ML-KEM") || algorithm.starts_with("Kyber")
+            }
+            Role::OqsSig | Role::CppSig => {
+                algorithm.starts_with("ML-DSA")
+                    || algorithm.starts_with("SLH-")
+                    || algorithm.starts_with("Dilithium")
+            }
+            _ => true,
+        }
+    }
+    pub fn cpp_constructor(&self, arguments: Node<'a>, role: Role) -> Option<Key> {
+        if self.oqs_shadowed() {
+            return None;
+        }
+        if let Some(ty) = arguments
+            .parent()
+            .and_then(|p| p.parent())
+            .and_then(|p| p.child_by_field_name("type"))
+        {
+            let name = if role == Role::CppKem {
+                "oqs::KeyEncapsulation"
+            } else {
+                "oqs::Signature"
+            };
+            if !self.api_available(name, ty) {
+                return None;
+            }
+        }
+        let kind = if role == Role::CppKem {
+            SelectorKind::OqsKem
+        } else {
+            SelectorKind::OqsSig
+        };
+        let algorithm = self.selector(
+            args(arguments).first().copied(),
+            arguments.start_byte(),
+            0,
+            kind,
+        )?;
+        Self::valid_role(role, &algorithm).then_some(Key { role, algorithm })
+    }
+
+    pub fn key(&self, node: Node<'a>, at: usize, depth: usize) -> Option<Key> {
+        if depth > 8 {
+            self.ctx.limit("c_family_alias_depth", 8, 8);
+            return None;
+        }
+        if !self.charge() {
+            return None;
+        }
+        if node.kind() == "call_expression" {
+            return self.constructor(node, depth);
+        }
+        if node.kind() == "parenthesized_expression" {
+            return self.key(*children(node).first()?, at, depth + 1);
+        }
+        let binding = self.binding(node, at)?;
+        match binding.value {
+            Value::Node(value) => {
+                if conditional(value) {
+                    return None;
+                }
+                if value.kind() == "call_expression" {
+                    self.constructor(value, depth)
+                } else {
+                    self.key(value, value.start_byte(), depth + 1)
+                }
+            }
+            Value::Generated(context) => {
+                let mut key = self.key(context, context.start_byte(), depth + 1)?;
+                if key.role != Role::Context {
+                    return None;
+                }
+                key.role = Role::Key;
+                Some(key)
+            }
+            Value::ContextFromKey(key_node) => {
+                let mut key = self.key(key_node, key_node.start_byte(), depth + 1)?;
+                if key.role != Role::Key {
+                    return None;
+                }
+                key.role = Role::Context;
+                Some(key)
+            }
+            Value::Cpp(arguments, role) => self.cpp_constructor(arguments, role),
+            Value::Unknown => None,
+        }
+    }
+}
