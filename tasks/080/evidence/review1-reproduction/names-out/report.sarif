{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "API_OPENSSL_RSA_NEW",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "OpenSSL low-level RSA API usage detected."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C_FAMILY_CRYPTO_API",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "C/C++ cryptographic API or configuration reference; effective primitive and runtime use require verification."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C_FAMILY_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "C/C++ PQC source reference; requested parameter sets do not prove enabled mechanisms or active protection."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
