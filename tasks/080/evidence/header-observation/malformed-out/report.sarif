{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "C_FAMILY_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "C/C++ PQC source reference; requested parameter sets do not prove enabled mechanisms or active protection."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "C_FAMILY_PQC_API",
          "level": "note",
          "message": {
            "text": "C/C++ PQC source reference; requested parameter sets do not prove enabled mechanisms or active protection. | migration_hint=Verify the exact standard or draft parameter set, linked OQS/OpenSSL version and build flags. Requested algorithms are not proof of enabled or active protection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "case.h"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Verify the exact standard or draft parameter set, linked OQS/OpenSSL version and build flags. Requested algorithms are not proof of enabled or active protection."
          }
        }
      ]
    }
  ]
}