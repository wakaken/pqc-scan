{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "API_EVP_PKEY_RSA",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "EVP_PKEY configured for RSA detected."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "API_OPENSSL_RSA_NEW",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "OpenSSL low-level RSA API usage detected."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CSHARP_CRYPTO_API",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "C# cryptographic API or qualified library reference; effective key use requires verification."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CSHARP_CRYPTO_REFERENCE",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "C# TLS library or OQS wrapper reference; identity and runtime capability require separate checks."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "CSHARP_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "C# PQC or composite/HPKE reference; source alone does not establish platform support or active protection."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C_FAMILY_CRYPTO_API",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "C/C++ cryptographic API or configuration reference; effective primitive and runtime use require verification."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C_FAMILY_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "C/C++ PQC source reference; requested parameter sets do not prove enabled mechanisms or active protection."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "OPENSSL_RSA_API",
              "shortDescription": {
                "text": "TLS"
              },
              "fullDescription": {
                "text": "OpenSSL RSA API call detected."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PHP_CRYPTO_API",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "PHP cryptographic API or library reference; key type may be unresolved."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PHP_CRYPTO_REFERENCE",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "PHP OQS KEM wrapper reference; installation and selected algorithm are unresolved."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PHP_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "PHP PQC algorithm or X-Wing reference; runtime support requires verification."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
