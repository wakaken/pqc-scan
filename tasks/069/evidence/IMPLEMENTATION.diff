+impl MigrationAssessment {
+    pub fn input(&self) -> &InputReference {
+        &self.input
+    }
+    pub fn context(&self) -> Option<&ContextDescriptor> {
+        self.context.as_ref()
+    }
+    pub fn as_of(&self) -> &str {
