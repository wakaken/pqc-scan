+          "type": "array",
+          "items": {
+            "type": "string",
+            "minLength": 1,
+            "maxLength": 128
+          },
+          "maxItems": 16
+        },
+        "attack_models": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
