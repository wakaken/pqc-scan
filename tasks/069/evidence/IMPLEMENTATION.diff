+    let cb = ctx::parse(&ctx::context(&e, ctx::ordinary_signing()));
+    let a = evaluate(&e, Some(&ca), ctx::AS_OF).unwrap();
+    let b = evaluate(&e, Some(&cb), ctx::AS_OF).unwrap();
+    let repeat = evaluate(&e, Some(&ca), ctx::AS_OF).unwrap();
+    assert_eq!(
