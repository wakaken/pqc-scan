diff --git a/crates/pqc_scan_cli/src/assess_command.rs b/crates/pqc_scan_cli/src/assess_command.rs
new file mode 100644
index 0000000..4e9d051
--- /dev/null
+++ b/crates/pqc_scan_cli/src/assess_command.rs
@@ -0,0 +1,44 @@
+use clap::Args;
+use pqc_scan_core::migration::{evaluate, Error, InputFormat, MigrationContext, SavedEvidence};
+use std::{io::Write, path::PathBuf};
+
+#[derive(Debug, Args)]
+pub(crate) struct AssessArgs {
+    /// One saved JSON file; never scanned or executed.
+    input: PathBuf,
+    /// Explicit inventory-v1, tls-v1, ssh-offers-v1 or ssh-kex-v1.
+    #[arg(long)]
+    input_format: String,
+    /// Explicit evaluation instant with UTC offset and whole seconds.
+    #[arg(long)]
+    as_of: String,
+    /// Scoped migration-context-v1 file; old assessment context is separate.
+    #[arg(long)]
+    context: Option<PathBuf>,
+    #[arg(long)]
+    out_dir: PathBuf,
+}
+pub(crate) fn run(args: AssessArgs, stdout: &mut impl Write) -> anyhow::Result<()> {
+    let format: InputFormat = args.input_format.parse()?;
+    let evidence = SavedEvidence::read(&args.input, format)?;
+    let context = args
+        .context
+        .as_deref()
+        .map(MigrationContext::read)
+        .transpose()
+        .map_err(|e| match e {
+            Error::InvalidInput | Error::InvalidContextBinding => {
+                anyhow::anyhow!("invalid_context")
+            }
+            other => anyhow::Error::from(other),
+        })?;
+    let report = evaluate(&evidence, context.as_ref(), &args.as_of)?;
+    pqc_scan_report::write_migration_assessment_json(
+        &report,
+        &evidence,
+        context.as_ref(),
+        &args.out_dir,
+    )?;
+    writeln!(stdout, "written {}", pqc_scan_report::MIGRATION_JSON)?;
+    Ok(())
+}
diff --git a/crates/pqc_scan_cli/tests/migration_assess.rs b/crates/pqc_scan_cli/tests/migration_assess.rs
new file mode 100644
index 0000000..3c2abeb
--- /dev/null
+++ b/crates/pqc_scan_cli/tests/migration_assess.rs
@@ -0,0 +1,262 @@
+#[path = "../../pqc_scan_core/tests/support/migration/context.rs"]
+mod ctx;
+#[path = "../../pqc_scan_core/tests/support/migration/mod.rs"]
+mod fixture;
+use pqc_scan_core::migration::{InputFormat, SavedEvidence};
+use serde_json::{json, Value};
+use std::{
+    path::{Path, PathBuf},
+    process::{Command, Output},
+    sync::atomic::{AtomicU64, Ordering},
+};
+struct Files(PathBuf);
+impl Files {
+    fn new() -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let p = std::env::temp_dir().join(format!(
+            "pqc-assess069-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir_all(&p).unwrap();
+        Self(p)
+    }
+    fn put(&self, name: &str, value: &Value) -> PathBuf {
+        let p = self.0.join(name);
+        std::fs::write(&p, serde_json::to_vec(value).unwrap()).unwrap();
+        p
+    }
+    fn run(
+        &self,
+        input: &Path,
+        format: &str,
+        context: Option<&Path>,
+        out: &Path,
+        clock: &str,
+    ) -> Output {
+        let mut c = Command::new(env!("CARGO_BIN_EXE_pqc-scan"));
+        c.arg("assess")
+            .arg(input)
+            .args(["--input-format", format, "--as-of", clock, "--out-dir"])
+            .arg(out);
+        if let Some(context) = context {
+            c.arg("--context").arg(context);
+        }
+        c.output().unwrap()
+    }
+}
+impl Drop for Files {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+fn rsa() -> Value {
+    let mut v = fixture::inventory("RSA");
+    v["assets"][0]["attributes"]["parameters"] = json!({"key_bits":"2048"});
+    v
+}
+fn report(out: &Path) -> Value {
+    serde_json::from_slice(&std::fs::read(out.join("migration.assessment.v1.json")).unwrap())
+        .unwrap()
+}
+fn assert_ok(output: &Output) {
+    assert_eq!(
+        output.status.code(),
+        Some(0),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(output.stderr.is_empty());
+}
+fn assert_error(output: &Output, code: &str) {
+    assert_eq!(output.status.code(), Some(1));
+    assert!(
+        String::from_utf8_lossy(&output.stderr).contains(code),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+#[test]
+fn actual_cli_reassesses_same_input_with_paired_contexts_and_validates_full_schema() {
+    let f = Files::new();
+    let input = f.put("saved.inventory.json", &rsa());
+    let bytes = std::fs::read(&input).unwrap();
+    let evidence = SavedEvidence::from_bytes(&bytes, InputFormat::InventoryV1).unwrap();
+    let mut critical = ctx::critical_signing();
+    critical["support"] = ctx::support();
+    let mut ordinary = ctx::ordinary_signing();
+    ordinary["support"] = ctx::support();
+    let a = f.put("context-a.json", &ctx::context(&evidence, critical));
+    let b = f.put("context-b.json", &ctx::context(&evidence, ordinary));
+    for (context, name, urgency, action) in [
+        (&a, "a", "urgent", "migrate"),
+        (&b, "b", "plan", "plan"),
+        (&a, "repeat", "urgent", "migrate"),
+    ] {
+        let out = f.0.join(name);
+        assert_ok(&f.run(&input, "inventory-v1", Some(context), &out, ctx::AS_OF));
+        let value = report(&out);
+        assert_eq!(value["decisions"][0]["urgency"], urgency);
+        assert_eq!(value["decisions"][0]["action"]["kind"], action);
+        assert_eq!(value["input"]["sha256"], evidence.input().sha256);
+        let schema: Value = serde_json::from_str(include_str!(
+            "../../../schemas/migration-assessment-v1.schema.json"
+        ))
+        .unwrap();
+        let validator = jsonschema::validator_for(&schema).unwrap();
+        let errors = validator
+            .iter_errors(&value)
+            .map(|e| e.to_string())
+            .collect::<Vec<_>>();
+        assert!(errors.is_empty(), "{errors:?}");
+        assert!(!out.join("report.json").exists());
+        assert!(!out.join("report.html").exists());
+        assert!(!out.join("cbom.json").exists());
+        let mut bad = value.clone();
+        bad["decisions"][0]["readiness"] = "verified_safe".into();
+        assert!(!validator.is_valid(&bad));
+        let mut bad = value.clone();
+        bad["policy"]["version"] = "2.0.0".into();
+        assert!(!validator.is_valid(&bad));
+        let mut bad = value;
+        bad["claims"][0]["SECRET_CANARY_069"] = true.into();
+        assert!(!validator.is_valid(&bad));
+    }
+    assert_eq!(report(&f.0.join("a")), report(&f.0.join("repeat")));
+    assert_ne!(
+        report(&f.0.join("a"))["context"]["sha256"],
+        report(&f.0.join("b"))["context"]["sha256"]
+    );
+    assert_eq!(std::fs::read(&input).unwrap(), bytes);
+}
+#[test]
+fn each_saved_format_works_in_the_actual_static_or_featured_binary_without_probing() {
+    let f = Files::new();
+    for (i, value, format) in [
+        (0, fixture::inventory("RSA"), "inventory-v1"),
+        (1, fixture::tls(), "tls-v1"),
+        (2, fixture::failed_tls(), "tls-v1"),
+        (3, fixture::offers(), "ssh-offers-v1"),
+        (4, fixture::kex(), "ssh-kex-v1"),
+    ] {
+        let input = f.put(&format!("input{i}.json"), &value);
+        let out = f.0.join(format!("out{i}"));
+        assert_ok(&f.run(&input, format, None, &out, ctx::AS_OF));
+        assert_eq!(report(&out)["input"]["format"], format);
+        let expected = fixture::ingest(&value, format.parse().unwrap()).unwrap();
+        assert_eq!(report(&out)["input"]["sha256"], expected.input().sha256);
+    }
+}
+#[test]
+fn invalid_context_versions_references_content_and_clock_fail_before_new_reports() {
+    let f = Files::new();
+    let input = f.put("input.json", &rsa());
+    let e = SavedEvidence::read(&input, InputFormat::InventoryV1).unwrap();
+    let original = ctx::context(&e, ctx::critical_signing());
+    let mut wrong_digest = original.clone();
+    wrong_digest["input"]["sha256"] = "a".repeat(64).into();
+    let mut unknown = original.clone();
+    unknown["bindings"][0]["target_id"] =
+        pqc_scan_core::identity::native_id("migration_target", &["missing"]).into();
+    let mut duplicate = original.clone();
+    let row = duplicate["bindings"][0].clone();
+    duplicate["bindings"].as_array_mut().unwrap().push(row);
+    let mut invalid = original.clone();
+    invalid["SECRET_CANARY_069"] = "SECRET_CANARY_069".into();
+    let mut lead = original.clone();
+    lead["bindings"][0]["claims"]["migration_lead_seconds"] = ctx::claim(json!(315576001));
+    for (i, value, code) in [
+        (0, wrong_digest, "input_binding_mismatch"),
+        (1, unknown, "invalid_reference"),
+        (2, duplicate, "ambiguous_binding"),
+        (3, invalid, "invalid_context"),
+        (4, lead, "invalid_context"),
+    ] {
+        let context = f.put(&format!("context{i}-SECRET_CANARY_069.json"), &value);
+        let out = f.0.join(format!("bad{i}"));
+        let output = f.run(&input, "inventory-v1", Some(&context), &out, ctx::AS_OF);
+        assert_error(&output, code);
+        assert!(!out.exists());
+        assert!(!String::from_utf8_lossy(&output.stderr).contains("CANARY"));
+    }
+    let out = f.0.join("clock");
+    assert_error(
+        &f.run(&input, "inventory-v1", None, &out, "2026-11-16T00:00:00Z"),
+        "invalid_time",
+    );
+    assert!(!out.exists());
+    let out = f.0.join("format");
+    assert_error(
+        &f.run(&input, "SECRET_CANARY_069", None, &out, ctx::AS_OF),
+        "unsupported_format",
+    );
+    assert!(!out.exists());
+}
+#[test]
+fn input_context_and_hardlink_aliases_are_rejected_without_mutation() {
+    let f = Files::new();
+    let out = f.0.join("alias");
+    std::fs::create_dir_all(&out).unwrap();
+    let input = out.join("migration.assessment.v1.json");
+    let bytes = serde_json::to_vec(&rsa()).unwrap();
+    std::fs::write(&input, &bytes).unwrap();
+    assert_error(
+        &f.run(&input, "inventory-v1", None, &out, ctx::AS_OF),
+        "unsafe_output",
+    );
+    assert_eq!(std::fs::read(&input).unwrap(), bytes);
+    let input = f.put("input.json", &rsa());
+    let e = SavedEvidence::read(&input, InputFormat::InventoryV1).unwrap();
+    let context = out.join("migration.assessment.v1.json");
+    let context_bytes = serde_json::to_vec(&ctx::context(&e, ctx::critical_signing())).unwrap();
+    std::fs::write(&context, &context_bytes).unwrap();
+    assert_error(
+        &f.run(&input, "inventory-v1", Some(&context), &out, ctx::AS_OF),
+        "unsafe_output",
+    );
+    assert_eq!(std::fs::read(&context).unwrap(), context_bytes);
+    std::fs::remove_file(&context).unwrap();
+    std::fs::hard_link(&input, &context).unwrap();
+    let bytes = std::fs::read(&input).unwrap();
+    assert_error(
+        &f.run(&input, "inventory-v1", None, &out, ctx::AS_OF),
+        "unsafe_output",
+    );
+    assert_eq!(std::fs::read(&input).unwrap(), bytes);
+    assert_eq!(std::fs::read(&context).unwrap(), bytes);
+}
+#[test]
+fn no_endpoint_connection_no_input_execution_and_no_raw_metadata_output() {
+    let f = Files::new();
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let address = listener.local_addr().unwrap();
+    let mut value = fixture::tls();
+    value["target"]["host"] = "127.0.0.1".into();
+    value["target"]["port"] = address.port().into();
+    value["target"]["resolved_addresses"] = json!(["127.0.0.1"]);
+    value["target"]["pinned_address"] = address.to_string().into();
+    value["target"]["connected_peer"] = address.to_string().into();
+    let input = f.put("saved-tls.json", &value);
+    let out = f.0.join("tls-out");
+    assert_ok(&f.run(&input, "tls-v1", None, &out, ctx::AS_OF));
+    assert_eq!(
+        listener.accept().unwrap_err().kind(),
+        std::io::ErrorKind::WouldBlock
+    );
+    let mut v = rsa();
+    let marker = f.0.join("NEVER_EXECUTE_069");
+    v["arbitrary_metadata"] = json!({"secret":"SECRET_CANARY_069","command":format!("/usr/bin/touch {}", marker.display())});
+    let input = f.put("untrusted.json", &v);
+    let out = f.0.join("untrusted-out");
+    let output = f.run(&input, "inventory-v1", None, &out, ctx::AS_OF);
+    assert_ok(&output);
+    assert!(
+        !std::fs::read_to_string(out.join("migration.assessment.v1.json"))
+            .unwrap()
+            .contains("CANARY")
+    );
+    assert!(!f.0.join("NEVER_EXECUTE_069").exists());
+    assert!(!String::from_utf8_lossy(&output.stdout).contains("CANARY"));
+}
diff --git a/crates/pqc_scan_core/src/migration/bounded.rs b/crates/pqc_scan_core/src/migration/bounded.rs
new file mode 100644
index 0000000..1f2a65a
--- /dev/null
+++ b/crates/pqc_scan_core/src/migration/bounded.rs
@@ -0,0 +1,154 @@
+//! Bounded, duplicate-aware JSON ingestion shared by the saved-only readers.
+use super::{Error, Result};
+use serde::de::{DeserializeSeed, MapAccess, SeqAccess, Visitor};
+use serde_json::{Map, Number, Value};
+use std::{fmt, fs::File, io::Read, path::Path};
+
+pub(crate) const MAX_DEPTH: usize = 16;
+pub(crate) const MAX_FIELDS: usize = 64;
+pub(crate) const MAX_STRING: usize = 1024;
+pub(crate) const MAX_ARRAY: usize = 65536;
+
+pub(crate) fn read(path: &Path, limit: usize) -> Result<(Vec<u8>, File)> {
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    let mut file = options.open(path).map_err(|_| Error::InputUnavailable)?;
+    let metadata = file.metadata().map_err(|_| Error::InputUnavailable)?;
+    if !metadata.is_file() {
+        return Err(Error::InputUnavailable);
+    }
+    if metadata.len() > limit as u64 {
+        return Err(Error::ResourceLimit);
+    }
+    let mut bytes = Vec::new();
+    (&mut file)
+        .take(limit as u64 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|_| Error::InputUnavailable)?;
+    if bytes.len() > limit {
+        return Err(Error::ResourceLimit);
+    }
+    Ok((bytes, file))
+}
+
+pub(crate) fn parse(bytes: &[u8], limit: usize) -> Result<Value> {
+    if bytes.len() > limit {
+        return Err(Error::ResourceLimit);
+    }
+    // serde_json rejects BOM, malformed UTF-8, trailing input and nonfinite numbers.
+    let mut deserializer = serde_json::Deserializer::from_slice(bytes);
+    let value = Seed(0).deserialize(&mut deserializer).map_err(|e| {
+        if e.to_string().starts_with("resource_limit") {
+            Error::ResourceLimit
+        } else {
+            Error::InvalidInput
+        }
+    })?;
+    deserializer.end().map_err(|_| Error::InvalidInput)?;
+    Ok(value)
+}
+
+struct Seed(usize);
+impl<'de> DeserializeSeed<'de> for Seed {
+    type Value = Value;
+    fn deserialize<D: serde::Deserializer<'de>>(
+        self,
+        de: D,
+    ) -> std::result::Result<Value, D::Error> {
+        de.deserialize_any(self)
+    }
+}
+impl<'de> Visitor<'de> for Seed {
+    type Value = Value;
+    fn expecting(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("bounded JSON")
+    }
+    fn visit_bool<E: serde::de::Error>(self, v: bool) -> std::result::Result<Value, E> {
+        Ok(Value::Bool(v))
+    }
+    fn visit_i64<E: serde::de::Error>(self, v: i64) -> std::result::Result<Value, E> {
+        Ok(Value::Number(v.into()))
+    }
+    fn visit_u64<E: serde::de::Error>(self, v: u64) -> std::result::Result<Value, E> {
+        Ok(Value::Number(v.into()))
+    }
+    fn visit_f64<E: serde::de::Error>(self, v: f64) -> std::result::Result<Value, E> {
+        Number::from_f64(v)
+            .map(Value::Number)
+            .ok_or_else(|| E::custom("invalid_input"))
+    }
+    fn visit_str<E: serde::de::Error>(self, v: &str) -> std::result::Result<Value, E> {
+        if v.len() > MAX_STRING {
+            return Err(E::custom("resource_limit"));
+        }
+        Ok(Value::String(v.into()))
+    }
+    fn visit_unit<E: serde::de::Error>(self) -> std::result::Result<Value, E> {
+        Ok(Value::Null)
+    }
+    fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> std::result::Result<Value, A::Error> {
+        use serde::de::Error;
+        if self.0 >= MAX_DEPTH {
+            return Err(A::Error::custom("resource_limit"));
+        }
+        let mut values = Vec::new();
+        while let Some(value) = seq.next_element_seed(Seed(self.0 + 1))? {
+            if values.len() == MAX_ARRAY {
+                return Err(A::Error::custom("resource_limit"));
+            }
+            values.push(value);
+        }
+        Ok(Value::Array(values))
+    }
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> std::result::Result<Value, A::Error> {
+        use serde::de::Error;
+        if self.0 >= MAX_DEPTH {
+            return Err(A::Error::custom("resource_limit"));
+        }
+        let mut values = Map::new();
+        while let Some(key) = map.next_key::<String>()? {
+            if key.len() > MAX_STRING || values.len() == MAX_FIELDS {
+                return Err(A::Error::custom("resource_limit"));
+            }
+            if values.contains_key(&key) {
+                return Err(A::Error::custom("invalid_input"));
+            }
+            values.insert(key, map.next_value_seed(Seed(self.0 + 1))?);
+        }
+        Ok(Value::Object(values))
+    }
+}
+
+pub(crate) fn collection_timestamp(value: &str) -> Result<i64> {
+    use chrono::{Datelike, Timelike};
+    let date = chrono::DateTime::parse_from_rfc3339(value).map_err(|_| Error::InvalidInput)?;
+    if !(1970..=9999).contains(&date.year()) || date.nanosecond() >= 1_000_000_000 {
+        return Err(Error::InvalidInput);
+    }
+    let utc = date.with_timezone(&chrono::Utc);
+    if !(1970..=9999).contains(&utc.year()) {
+        return Err(Error::InvalidInput);
+    }
+    // Existing collectors emit subsecond collection times; retain the original
+    // string and round upward only for comparison to a whole-second as_of.
+    Ok(utc.timestamp() + i64::from(utc.nanosecond() != 0))
+}
+
+pub(crate) fn digest(bytes: &[u8]) -> String {
+    use sha2::{Digest, Sha256};
+    hex::encode(Sha256::digest(bytes))
+}
+
+pub(crate) fn vocabulary(value: &str, allowed: &[&str]) -> String {
+    if allowed.contains(&value) {
+        value
+    } else {
+        "unknown"
+    }
+    .into()
+}
diff --git a/crates/pqc_scan_core/src/migration/context.rs b/crates/pqc_scan_core/src/migration/context.rs
new file mode 100644
index 0000000..b26737f
--- /dev/null
+++ b/crates/pqc_scan_core/src/migration/context.rs
@@ -0,0 +1,726 @@
+//! Closed local claims and immutable target bindings; no policy decisions.
+use super::{bounded, Error, InputFormat, Result, SavedEvidence, Target};
+use crate::{assessment::Purpose, identity::native_id};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs::File,
+    path::Path,
+};
+
+const LIMIT: usize = 1024 * 1024;
+const FORMAT: &str = "pqc-scan.migration-context";
+pub(crate) const SUPPORT_NAMES: [&str; 8] = [
+    "runtime",
+    "provider",
+    "peer",
+    "protocol",
+    "parameters",
+    "jose",
+    "verifiers",
+    "pki",
+];
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct InputBinding {
+    format: InputFormat,
+    sha256: String,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+enum SourceKind {
+    OperatorClaim,
+    ExternalReviewClaim,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Provenance {
+    source_kind: SourceKind,
+    actor_id: String,
+    asserted_at: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    valid_until: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    reference_id: Option<String>,
+}
+impl Provenance {
+    pub fn source_kind(&self) -> &str {
+        match self.source_kind {
+            SourceKind::OperatorClaim => "operator_claim",
+            SourceKind::ExternalReviewClaim => "external_review_claim",
+        }
+    }
+    pub fn actor_id(&self) -> &str {
+        &self.actor_id
+    }
+    pub fn asserted_at(&self) -> &str {
+        &self.asserted_at
+    }
+    pub fn valid_until(&self) -> Option<&str> {
+        self.valid_until.as_deref()
+    }
+    pub fn reference_id(&self) -> Option<&str> {
+        self.reference_id.as_deref()
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "state", rename_all = "snake_case", deny_unknown_fields)]
+enum Claim<T> {
+    Known { value: T, provenance: Provenance },
+    Unknown { provenance: Provenance },
+}
+impl<T> Claim<T> {
+    fn provenance_mut(&mut self) -> &mut Provenance {
+        match self {
+            Self::Known { provenance, .. } | Self::Unknown { provenance } => provenance,
+        }
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum Applicability {
+    Applicable,
+    NotApplicable,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum UseCase {
+    KeyEstablishment,
+    Signature,
+    Jwt,
+    Pki,
+    Encryption,
+    Hashing,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum Usage {
+    Active,
+    Planned,
+    TestOnly,
+    Unused,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum DeadlineScope {
+    OrganizationPolicy,
+    ContractualRequirement,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+enum Deadline {
+    None {},
+    At {
+        at: String,
+        reference_id: String,
+        scope_reason: DeadlineScope,
+    },
+}
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Support {
+    runtime: Option<Claim<bool>>,
+    provider: Option<Claim<bool>>,
+    peer: Option<Claim<bool>>,
+    protocol: Option<Claim<bool>>,
+    parameters: Option<Claim<bool>>,
+    jose: Option<Claim<bool>>,
+    verifiers: Option<Claim<bool>>,
+    pki: Option<Claim<bool>>,
+}
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ClaimSet {
+    applicability: Option<Claim<Applicability>>,
+    use_case: Option<Claim<UseCase>>,
+    usage_state: Option<Claim<Usage>>,
+    business_critical: Option<Claim<bool>>,
+    confidential: Option<Claim<bool>>,
+    confidentiality_until: Option<Claim<String>>,
+    signature_verification_until: Option<Claim<String>>,
+    historical_ciphertext: Option<Claim<bool>>,
+    migration_lead_seconds: Option<Claim<u64>>,
+    deadline: Option<Claim<Deadline>>,
+    support: Option<Support>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct System {
+    id: String,
+    defaults: Option<ClaimSet>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Binding {
+    target_id: String,
+    system_id: String,
+    claims: Option<ClaimSet>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ContextReference {
+    pub id: String,
+    pub issuer_id: String,
+    pub document_id: String,
+    pub edition: String,
+    pub clause: String,
+    pub scope_id: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub https_uri: Option<String>,
+}
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Input {
+    format: String,
+    version: u32,
+    input: InputBinding,
+    organization_id: String,
+    systems: Vec<System>,
+    bindings: Vec<Binding>,
+    organization_defaults: Option<ClaimSet>,
+    #[serde(default)]
+    references: Vec<ContextReference>,
+}
+
+/// Validated context. No raw context or input path is serialized into results.
+#[derive(Debug)]
+pub struct MigrationContext {
+    input: Input,
+    sha256: String,
+    pub(crate) file: Option<File>,
+    path: Option<std::path::PathBuf>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ClaimFreshness {
+    Active,
+    Stale,
+    NotYetEffective,
+    Unknown,
+}
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+pub struct ResolvedClaim {
+    pub id: String,
+    pub context_pointer: String,
+    pub field: String,
+    pub state: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub value: Option<Value>,
+    pub provenance: Provenance,
+    pub freshness: ClaimFreshness,
+}
+impl ResolvedClaim {
+    pub fn active_value(&self) -> Option<&Value> {
+        (self.freshness == ClaimFreshness::Active)
+            .then_some(self.value.as_ref())
+            .flatten()
+    }
+}
+#[derive(Debug, Clone)]
+pub struct TargetContext {
+    pub system_id: String,
+    claims: BTreeMap<String, ResolvedClaim>,
+    pub purpose_conflicting: bool,
+}
+impl TargetContext {
+    pub fn claim(&self, field: &str) -> Option<&ResolvedClaim> {
+        self.claims.get(field)
+    }
+    pub fn claims(&self) -> impl Iterator<Item = &ResolvedClaim> {
+        self.claims.values()
+    }
+}
+#[derive(Debug)]
+pub struct BoundContext {
+    pub organization_id: String,
+    pub sha256: String,
+    targets: BTreeMap<String, TargetContext>,
+    references: Vec<ContextReference>,
+}
+impl BoundContext {
+    pub fn target(&self, id: &str) -> Option<&TargetContext> {
+        self.targets.get(id)
+    }
+    pub fn references(&self) -> &[ContextReference] {
+        &self.references
+    }
+}
+
+impl MigrationContext {
+    pub fn read(path: &Path) -> Result<Self> {
+        let (bytes, file) = bounded::read(path, LIMIT)?;
+        let mut result = Self::from_bytes(&bytes)?;
+        result.file = Some(file);
+        result.path = Some(super::absolute_path(path)?);
+        Ok(result)
+    }
+    pub fn from_bytes(bytes: &[u8]) -> Result<Self> {
+        if bytes.len() > LIMIT {
+            return Err(Error::ResourceLimit);
+        }
+        let sha256 = bounded::digest(bytes);
+        let value = bounded::parse(bytes, LIMIT)?;
+        if value["format"] != FORMAT || value["version"] != 1 {
+            return Err(Error::UnsupportedVersion);
+        }
+        // Serde Option alone treats null as absent; the contract forbids null at
+        // every context position, including optional claims and nested wrappers.
+        reject_null(&value)?;
+        let mut input: Input = serde_json::from_value(value).map_err(|_| Error::InvalidInput)?;
+        validate(&mut input)?;
+        Ok(Self {
+            input,
+            sha256,
+            file: None,
+            path: None,
+        })
+    }
+    pub fn sha256(&self) -> &str {
+        &self.sha256
+    }
+    pub(crate) fn aliases_output(&self, destination: &Path) -> bool {
+        super::aliases(destination, self.path.as_deref(), self.file.as_ref()).unwrap_or(true)
+    }
+    pub fn bind(&self, evidence: &SavedEvidence, as_of: &str) -> Result<BoundContext> {
+        let now = instant(as_of).map_err(|_| Error::InvalidTime)?;
+        if now < bounded::collection_timestamp(&evidence.input().collection_time)? {
+            return Err(Error::InvalidTime);
+        }
+        if self.input.input.format != evidence.input().format
+            || self.input.input.sha256 != evidence.input().sha256
+        {
+            return Err(Error::InputBindingMismatch);
+        }
+        let index: BTreeMap<_, _> = evidence
+            .targets()
+            .iter()
+            .map(|t| (t.id.as_str(), t))
+            .collect();
+        let systems: BTreeMap<_, _> = self
+            .input
+            .systems
+            .iter()
+            .enumerate()
+            .map(|(i, s)| (s.id.as_str(), (i, s)))
+            .collect();
+        let mut targets = BTreeMap::new();
+        for (i, binding) in self.input.bindings.iter().enumerate() {
+            let target = index
+                .get(binding.target_id.as_str())
+                .ok_or(Error::InvalidReference)?;
+            if !target.bindable {
+                return Err(Error::AmbiguousContextBinding);
+            }
+            let (system_index, system) = systems
+                .get(binding.system_id.as_str())
+                .ok_or(Error::InvalidContextBinding)?;
+            let mut claims = BTreeMap::new();
+            for (set, pointer) in [
+                (
+                    self.input.organization_defaults.as_ref(),
+                    "/organization_defaults".to_string(),
+                ),
+                (
+                    system.defaults.as_ref(),
+                    format!("/systems/{system_index}/defaults"),
+                ),
+                (binding.claims.as_ref(), format!("/bindings/{i}/claims")),
+            ] {
+                if let Some(set) = set {
+                    merge_claims(&mut claims, set, &pointer, &self.sha256, now)?;
+                }
+            }
+            let purpose_conflicting = claims
+                .get("use_case")
+                .and_then(ResolvedClaim::active_value)
+                .and_then(Value::as_str)
+                .is_some_and(|usage| purpose_conflict(target, usage));
+            if targets
+                .insert(
+                    binding.target_id.clone(),
+                    TargetContext {
+                        system_id: binding.system_id.clone(),
+                        claims,
+                        purpose_conflicting,
+                    },
+                )
+                .is_some()
+            {
+                return Err(Error::InvalidContextBinding);
+            }
+        }
+        Ok(BoundContext {
+            organization_id: self.input.organization_id.clone(),
+            sha256: self.sha256.clone(),
+            targets,
+            references: self.input.references.clone(),
+        })
+    }
+}
+
+pub fn parse_as_of(value: &str) -> Result<String> {
+    normalized(value)
+}
+fn instant(value: &str) -> Result<i64> {
+    use chrono::{Datelike, Timelike};
+    let date = chrono::DateTime::parse_from_rfc3339(value).map_err(|_| Error::InvalidInput)?;
+    let utc = date.with_timezone(&chrono::Utc);
+    if !(1970..=9999).contains(&date.year())
+        || !(1970..=9999).contains(&utc.year())
+        || date.nanosecond() != 0
+    {
+        return Err(Error::InvalidInput);
+    }
+    Ok(date.timestamp())
+}
+fn normalized(value: &str) -> Result<String> {
+    chrono::DateTime::from_timestamp(instant(value)?, 0)
+        .map(|d| d.to_rfc3339_opts(chrono::SecondsFormat::Secs, true))
+        .ok_or(Error::InvalidInput)
+}
+fn reject_null(value: &Value) -> Result<()> {
+    match value {
+        Value::Null => return Err(Error::InvalidInput),
+        Value::Object(m) => {
+            for v in m.values() {
+                reject_null(v)?;
+            }
+        }
+        Value::Array(a) => {
+            for v in a {
+                reject_null(v)?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+fn alias(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 64
+        && value.as_bytes()[0].is_ascii_lowercase()
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"._-".contains(&b))
+}
+fn identifier(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 128 && value.bytes().all(|b| (0x21..=0x7e).contains(&b))
+}
+fn sha(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn validate(input: &mut Input) -> Result<()> {
+    if input.format != FORMAT || input.version != 1 {
+        return Err(Error::UnsupportedVersion);
+    }
+    if input.organization_id.len() > 64 {
+        return Err(Error::ResourceLimit);
+    }
+    if !alias(&input.organization_id) || !sha(&input.input.sha256) {
+        return Err(Error::InvalidInput);
+    }
+    if input.systems.len() > 256 || input.bindings.len() > 4096 {
+        return Err(Error::ResourceLimit);
+    }
+    let mut refs = BTreeSet::new();
+    for r in &input.references {
+        if [
+            &r.id,
+            &r.issuer_id,
+            &r.document_id,
+            &r.edition,
+            &r.clause,
+            &r.scope_id,
+        ]
+        .iter()
+        .any(|s| s.len() > 128)
+        {
+            return Err(Error::ResourceLimit);
+        }
+        if ![
+            &r.id,
+            &r.issuer_id,
+            &r.document_id,
+            &r.edition,
+            &r.clause,
+            &r.scope_id,
+        ]
+        .iter()
+        .all(|s| identifier(s))
+            || !refs.insert(r.id.as_str())
+        {
+            return Err(Error::InvalidReference);
+        }
+        if let Some(uri) = &r.https_uri {
+            validate_uri(uri)?;
+        }
+    }
+    let mut systems = BTreeSet::new();
+    for s in &input.systems {
+        if s.id.len() > 64 {
+            return Err(Error::ResourceLimit);
+        }
+        if !alias(&s.id) || !systems.insert(s.id.as_str()) {
+            return Err(Error::InvalidContextBinding);
+        }
+    }
+    let mut bindings = BTreeSet::new();
+    for b in &input.bindings {
+        if b.system_id.len() > 64 {
+            return Err(Error::ResourceLimit);
+        }
+        if !crate::assessment::valid_id(&b.target_id, "migration_target")
+            || !systems.contains(b.system_id.as_str())
+        {
+            return Err(Error::InvalidReference);
+        }
+        if !bindings.insert(b.target_id.as_str()) {
+            return Err(Error::AmbiguousContextBinding);
+        }
+    }
+    if let Some(set) = &mut input.organization_defaults {
+        validate_set(set, &refs)?;
+    }
+    for s in &mut input.systems {
+        if let Some(set) = &mut s.defaults {
+            validate_set(set, &refs)?;
+        }
+    }
+    for b in &mut input.bindings {
+        if let Some(set) = &mut b.claims {
+            validate_set(set, &refs)?;
+        }
+    }
+    Ok(())
+}
+fn validate_uri(uri: &str) -> Result<()> {
+    if uri.len() > 1024 {
+        return Err(Error::ResourceLimit);
+    }
+    let rest = uri
+        .strip_prefix("https://")
+        .ok_or(Error::InvalidReference)?;
+    if uri.chars().any(char::is_control) || uri.contains(['@', '?', '\\', ' ']) {
+        return Err(Error::InvalidReference);
+    }
+    let authority = rest
+        .split(['/', '#'])
+        .next()
+        .ok_or(Error::InvalidReference)?;
+    let (host, port) = if let Some(rest) = authority.strip_prefix('[') {
+        let (host, suffix) = rest.split_once(']').ok_or(Error::InvalidReference)?;
+        (
+            host,
+            if suffix.is_empty() {
+                443
+            } else {
+                suffix
+                    .strip_prefix(':')
+                    .and_then(|s| s.parse::<u16>().ok())
+                    .ok_or(Error::InvalidReference)?
+            },
+        )
+    } else if let Some((host, port)) = authority.rsplit_once(':') {
+        (
+            host,
+            port.parse::<u16>().map_err(|_| Error::InvalidReference)?,
+        )
+    } else {
+        (authority, 443)
+    };
+    crate::target_policy::TargetRequest::new(host, port).map_err(|_| Error::InvalidReference)?;
+    Ok(())
+}
+fn provenance(p: &mut Provenance, refs: &BTreeSet<&str>) -> Result<()> {
+    if p.actor_id.len() > 64 {
+        return Err(Error::ResourceLimit);
+    }
+    if p.reference_id.as_ref().is_some_and(|id| id.len() > 128) {
+        return Err(Error::ResourceLimit);
+    }
+    if !alias(&p.actor_id) {
+        return Err(Error::InvalidInput);
+    }
+    p.asserted_at = normalized(&p.asserted_at)?;
+    if let Some(until) = &mut p.valid_until {
+        *until = normalized(until)?;
+        if instant(&p.asserted_at)? >= instant(until)? {
+            return Err(Error::InvalidInput);
+        }
+    }
+    if p.reference_id.as_deref().is_some_and(|r| !refs.contains(r)) {
+        return Err(Error::InvalidReference);
+    }
+    Ok(())
+}
+fn validate_claim<T>(claim: &mut Option<Claim<T>>, refs: &BTreeSet<&str>) -> Result<()> {
+    if let Some(claim) = claim {
+        provenance(claim.provenance_mut(), refs)?;
+    }
+    Ok(())
+}
+fn validate_set(s: &mut ClaimSet, refs: &BTreeSet<&str>) -> Result<()> {
+    validate_claim(&mut s.applicability, refs)?;
+    validate_claim(&mut s.use_case, refs)?;
+    validate_claim(&mut s.usage_state, refs)?;
+    validate_claim(&mut s.business_critical, refs)?;
+    validate_claim(&mut s.confidential, refs)?;
+    validate_claim(&mut s.historical_ciphertext, refs)?;
+    for c in [
+        &mut s.confidentiality_until,
+        &mut s.signature_verification_until,
+    ] {
+        validate_claim(c, refs)?;
+        if let Some(Claim::Known { value, .. }) = c {
+            *value = normalized(value)?;
+        }
+    }
+    validate_claim(&mut s.migration_lead_seconds, refs)?;
+    if matches!(&s.migration_lead_seconds,Some(Claim::Known{value,..}) if *value>315576000) {
+        return Err(Error::InvalidInput);
+    }
+    validate_claim(&mut s.deadline, refs)?;
+    if let Some(Claim::Known {
+        value: Deadline::At {
+            at, reference_id, ..
+        },
+        ..
+    }) = &mut s.deadline
+    {
+        *at = normalized(at)?;
+        if reference_id.len() > 128 {
+            return Err(Error::ResourceLimit);
+        }
+        if !refs.contains(reference_id.as_str()) {
+            return Err(Error::InvalidReference);
+        }
+    }
+    if let Some(s) = &mut s.support {
+        for c in [
+            &mut s.runtime,
+            &mut s.provider,
+            &mut s.peer,
+            &mut s.protocol,
+            &mut s.parameters,
+            &mut s.jose,
+            &mut s.verifiers,
+            &mut s.pki,
+        ] {
+            validate_claim(c, refs)?;
+        }
+    }
+    Ok(())
+}
+
+fn add<T: Serialize>(
+    claims: &mut BTreeMap<String, ResolvedClaim>,
+    claim: &Option<Claim<T>>,
+    field: &str,
+    pointer: &str,
+    digest: &str,
+    now: i64,
+) -> Result<()> {
+    let Some(claim) = claim else {
+        return Ok(());
+    };
+    let (state, value, p) = match claim {
+        Claim::Known { value, provenance } => (
+            "known",
+            Some(serde_json::to_value(value).map_err(|_| Error::InvalidInput)?),
+            provenance,
+        ),
+        Claim::Unknown { provenance } => ("unknown", None, provenance),
+    };
+    let freshness = if now < instant(&p.asserted_at)? {
+        ClaimFreshness::NotYetEffective
+    } else if let Some(until) = &p.valid_until {
+        if now >= instant(until)? {
+            ClaimFreshness::Stale
+        } else {
+            ClaimFreshness::Active
+        }
+    } else {
+        ClaimFreshness::Unknown
+    };
+    let context_pointer = format!("{pointer}/{}", field.replace('.', "/"));
+    let id = native_id("migration_claim", &[digest, &context_pointer, field]);
+    claims.insert(
+        field.into(),
+        ResolvedClaim {
+            id,
+            context_pointer,
+            field: field.into(),
+            state: state.into(),
+            value,
+            provenance: p.clone(),
+            freshness,
+        },
+    );
+    Ok(())
+}
+fn merge_claims(
+    c: &mut BTreeMap<String, ResolvedClaim>,
+    s: &ClaimSet,
+    pointer: &str,
+    digest: &str,
+    now: i64,
+) -> Result<()> {
+    macro_rules! field {
+        ($name:ident) => {
+            add(c, &s.$name, stringify!($name), pointer, digest, now)?;
+        };
+    }
+    field!(applicability);
+    field!(use_case);
+    field!(usage_state);
+    field!(business_critical);
+    field!(confidential);
+    field!(confidentiality_until);
+    field!(signature_verification_until);
+    field!(historical_ciphertext);
+    field!(migration_lead_seconds);
+    field!(deadline);
+    if let Some(s) = &s.support {
+        for (name, value) in SUPPORT_NAMES.into_iter().zip([
+            &s.runtime,
+            &s.provider,
+            &s.peer,
+            &s.protocol,
+            &s.parameters,
+            &s.jose,
+            &s.verifiers,
+            &s.pki,
+        ]) {
+            add(c, value, &format!("support.{name}"), pointer, digest, now)?;
+        }
+    }
+    Ok(())
+}
+fn purpose_conflict(target: &Target, usage: &str) -> bool {
+    let selected = match usage {
+        "key_establishment" => Purpose::KeyEstablishment,
+        "signature" | "jwt" | "pki" => Purpose::Signature,
+        "encryption" => Purpose::Encryption,
+        "hashing" => Purpose::Hash,
+        _ => return false,
+    };
+    let a = &target.technical.algorithm;
+    if target.source_ref.role.contains("signature") && selected != Purpose::Signature {
+        return true;
+    }
+    if target.source_ref.role.contains("key_establishment") && selected != Purpose::KeyEstablishment
+    {
+        return true;
+    }
+    if a.purpose != Purpose::Unknown {
+        return a.purpose != selected;
+    }
+    matches!(a.identifier.as_str(), "RSA" | "EC")
+        && !matches!(selected, Purpose::Signature | Purpose::KeyEstablishment)
+}
