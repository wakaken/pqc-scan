+  "title": "Saved-evidence local migration decision assessment v1",
+  "description": "Adopted D1/D2/D4 output. Shape is not authenticity, policy usefulness or whole-system safety. Actual input/context/target/claim/source/candidate binding is additionally validated by core.",
+  "$defs": {
+    "algorithm": {
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "identifier": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 1024
+        },
+        "construction": {
