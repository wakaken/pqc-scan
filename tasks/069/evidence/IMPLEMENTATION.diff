+        assert!(bad.validate_for(&e, Some(&c)).is_err());
+        let mut bad = valid.clone();
+        bad.candidates[0].id = native_id("migration_candidate", &["missing"]);
+        assert!(bad.validate_for(&e, Some(&c)).is_err());
+        let mut bad = valid.clone();
+        let peer = bad.candidates[0]
+            .prerequisites
+            .iter_mut()
+            .find(|p| p.name == "peer")
+            .unwrap();
+        peer.claimed_support = Some(true);
