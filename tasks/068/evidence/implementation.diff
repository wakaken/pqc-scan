+//! Opt-in saved-evidence facts. No collectors, network providers or legacy dispatch.
+mod bounded;
+mod context;
+mod native;
+mod runtime;
+mod technical;
+
+use crate::{assessment::AlgorithmAssessment, identity::native_id};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::{fs::File, path::Path, str::FromStr};
+
+pub use context::{
+    parse_as_of, BoundContext, ClaimFreshness, ContextReference, MigrationContext, ResolvedClaim,
+    TargetContext,
+};
+pub use technical::{assess_primitive, source, TechnicalSource, CATALOG_ID, CATALOG_VERSION};
+
+pub type Result<T> = std::result::Result<T, Error>;
+#[derive(Debug, Clone, Copy, PartialEq, Eq, thiserror::Error)]
+pub enum Error {
+    #[error("input_unavailable")]
+    InputUnavailable,
+    #[error("invalid_input")]
+    InvalidInput,
+    #[error("resource_limit")]
+    ResourceLimit,
+    #[error("unsupported_format")]
+    UnsupportedFormat,
+    #[error("unsupported_version")]
+    UnsupportedVersion,
+    #[error("invalid_reference")]
+    InvalidReference,
+    #[error("contradictory_saved_facts")]
+    ContradictorySavedFacts,
+    #[error("invalid_context_binding")]
+    InvalidContextBinding,
+    #[error("ambiguous_context_binding")]
+    AmbiguousContextBinding,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum InputFormat {
+    #[serde(rename = "inventory-v1")]
+    InventoryV1,
+    #[serde(rename = "tls-v1")]
+    TlsV1,
+    #[serde(rename = "ssh-offers-v1")]
+    SshOffersV1,
+    #[serde(rename = "ssh-kex-v1")]
+    SshKexV1,
+}
+impl InputFormat {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::InventoryV1 => "inventory-v1",
+            Self::TlsV1 => "tls-v1",
+            Self::SshOffersV1 => "ssh-offers-v1",
+            Self::SshKexV1 => "ssh-kex-v1",
+        }
+    }
+    pub fn byte_limit(self) -> usize {
+        if self == Self::InventoryV1 {
+            32 * 1024 * 1024
+        } else {
+            1024 * 1024
+        }
+    }
+}
+impl FromStr for InputFormat {
+    type Err = Error;
+    fn from_str(value: &str) -> Result<Self> {
+        match value {
+            "inventory-v1" => Ok(Self::InventoryV1),
+            "tls-v1" => Ok(Self::TlsV1),
+            "ssh-offers-v1" => Ok(Self::SshOffersV1),
+            "ssh-kex-v1" => Ok(Self::SshKexV1),
+            _ => Err(Error::UnsupportedFormat),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct InputReference {
+    pub format: InputFormat,
+    pub sha256: String,
+    pub schema_version: u32,
+    pub collection_time: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub run_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub attempt_id: Option<u32>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub protocol: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, Serialize)]
+pub struct SourceReference {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub run_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub observation_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub root_asset_id: Option<String>,
+    pub role: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub attempt_id: Option<u32>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub detail_path: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub certificate_sha256: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub spki_sha256: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub path: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub line: Option<usize>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub dependency_provenance: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub protocol_version: Option<RegistryFact>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub cipher_suite: Option<RegistryFact>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub key_exchange_group: Option<RegistryFact>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub not_before_unix: Option<i64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub not_after_unix: Option<i64>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct RegistryFact {
+    pub id: u16,
+    pub name: String,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct TechnicalFacts {
+    #[serde(flatten)]
+    pub algorithm: AlgorithmAssessment,
+    pub encoding_assurance: String,
+    pub protocol_ref: Option<String>,
+    pub role: String,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct ObservationFacts {
+    pub method: String,
+    pub assurance: String,
+    pub usage: String,
+    pub collection_outcome: String,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Target {
+    pub id: String,
+    pub source_ref: SourceReference,
+    pub technical: TechnicalFacts,
+    pub observation: ObservationFacts,
+    pub limitations: Vec<String>,
+    /// False for ambiguous native anchors; never inferred from array position.
+    #[serde(skip)]
+    pub(crate) bindable: bool,
+}
+
+/// Validated projection; callers cannot substitute input identity or targets.
+/// Hashes bind saved bytes, not collector authenticity or business identity.
+#[derive(Debug)]
+pub struct SavedEvidence {
+    input: InputReference,
+    targets: Vec<Target>,
+    collection_outcome: String,
+    // Keep the opened identity for input/output alias protection in the CLI.
+    pub(crate) file: Option<File>,
+}
+impl SavedEvidence {
+    pub fn read(path: &Path, format: InputFormat) -> Result<Self> {
+        let (bytes, file) = bounded::read(path, format.byte_limit())?;
+        let mut result = Self::from_bytes(&bytes, format)?;
+        result.file = Some(file);
+        Ok(result)
+    }
+    pub fn from_bytes(bytes: &[u8], format: InputFormat) -> Result<Self> {
+        Self::from_bytes_with_catalog(bytes, format, CATALOG_ID, CATALOG_VERSION)
+    }
+    pub fn from_bytes_with_catalog(
+        bytes: &[u8],
+        format: InputFormat,
+        catalog: &str,
+        version: &str,
+    ) -> Result<Self> {
+        if catalog != CATALOG_ID || version != CATALOG_VERSION {
+            return Err(Error::UnsupportedVersion);
+        }
+        let value = bounded::parse(bytes, format.byte_limit())?;
+        if value["schema_version"] != 1 {
+            return Err(Error::UnsupportedVersion);
+        }
+        let hash = bounded::digest(bytes);
+        let mut result = if format == InputFormat::InventoryV1 {
+            native::project(value, hash)?
+        } else {
+            runtime::project(value, format, hash)?
+        };
+        if result.targets.len() > 65536 {
+            return Err(Error::ResourceLimit);
+        }
+        // Native references define order; runtime adapters preserve list/index order.
+        if format == InputFormat::InventoryV1 {
+            result.targets.sort_by_key(|t| {
+                (
+                    t.source_ref.observation_id.clone(),
+                    t.source_ref.root_asset_id.clone(),
+                    t.source_ref.detail_path.clone(),
+                    t.source_ref.role.clone(),
+                )
+            });
+        }
+        Ok(result)
+    }
+    pub fn input(&self) -> &InputReference {
+        &self.input
+    }
+    pub fn targets(&self) -> &[Target] {
+        &self.targets
+    }
+    pub fn collection_outcome(&self) -> &str {
+        &self.collection_outcome
+    }
+}
+
+fn target(
+    input: &InputReference,
+    source_ref: SourceReference,
+    algorithm: AlgorithmAssessment,
+    observation: ObservationFacts,
+    encoding: &str,
+    protocol_ref: Option<&str>,
+    bindable: bool,
+) -> Target {
+    let anchor = source_ref.observation_id.as_deref().unwrap_or("attempt1");
+    let root = source_ref.root_asset_id.as_deref().unwrap_or("");
+    let role_path = source_ref
+        .detail_path
+        .as_deref()
+        .unwrap_or(&source_ref.role);
+    let id = native_id(
+        "migration_target",
+        &[
+            input.format.as_str(),
+            &input.sha256,
+            anchor,
+            root,
+            role_path,
+        ],
+    );
+    let mut limitations = vec![];
+    if algorithm.identifier == "unknown" {
+        limitations.push("unknown_primitive".into());
+    }
+    if encoding == "unknown" {
+        limitations.push("unknown_parameter_encoding".into());
+    }
+    if observation.collection_outcome != "complete" && observation.collection_outcome != "completed"
+    {
+        limitations.push("collection_incomplete".into());
+    }
+    if observation.assurance == "unauthenticated_advertisement" {
+        limitations.push("unauthenticated_advertisement".into());
+    }
+    if observation.assurance == "unverified_or_incomplete" {
+        limitations.push("verification_not_completed".into());
+    }
+    if algorithm.combiner_assessment.is_some() {
+        limitations.push("combiner_implementation_unverified".into());
+    }
+    if !bindable {
+        limitations.push("unknown_binding".into());
+    }
+    if source_ref.role == "reference-only" {
+        limitations.push("reference_only".into());
+    }
+    let role = source_ref.role.clone();
+    Target {
+        id,
+        source_ref,
+        technical: TechnicalFacts {
+            algorithm,
+            encoding_assurance: encoding.into(),
+            protocol_ref: protocol_ref.map(str::to_owned),
+            role,
+        },
+        observation,
+        limitations,
+        bindable,
+    }
+}
+
+fn schema(
+    value: &Value,
+    body: &str,
+    cache: &std::sync::OnceLock<Result<jsonschema::Validator>>,
+) -> Result<()> {
+    // All schemas are repository constants with local references only. Features
+    // enabling HTTP/file retrieval are disabled; no input selects a schema URI.
+    let validator = cache
+        .get_or_init(|| {
+            let schema: Value = serde_json::from_str(body).map_err(|_| Error::InvalidInput)?;
+            jsonschema::validator_for(&schema).map_err(|_| Error::InvalidInput)
+        })
+        .as_ref()
+        .map_err(|e| *e)?;
+    if !validator.is_valid(value) {
+        return Err(Error::InvalidInput);
+    }
+    Ok(())
+}
diff --git a/crates/pqc_scan_core/src/migration/native.rs b/crates/pqc_scan_core/src/migration/native.rs
new file mode 100644
index 0000000..428f16e
--- /dev/null
+++ b/crates/pqc_scan_core/src/migration/native.rs
@@ -0,0 +1,344 @@
+use super::{
+    assess_primitive, bounded, target, Error, InputFormat, InputReference, ObservationFacts,
+    Result, SavedEvidence, SourceReference,
+};
+use crate::{
+    assessment::AlgorithmAssessment,
+    inventory::{CryptoAsset, NativeScan},
+};
+use serde_json::Value;
+use std::collections::{BTreeMap, BTreeSet};
+
+pub(super) fn project(value: Value, hash: String) -> Result<SavedEvidence> {
+    // The published writer schema is closed; the published Native reader is
+    // extension tolerant. Validate known shape without rejecting future fields.
+    static VALIDATOR: std::sync::OnceLock<Result<jsonschema::Validator>> =
+        std::sync::OnceLock::new();
+    let validator = VALIDATOR
+        .get_or_init(|| {
+            let mut schema: Value = serde_json::from_str(include_str!(
+                "../../../../schemas/native-scan-v1.schema.json"
+            ))
+            .map_err(|_| Error::InvalidInput)?;
+            tolerate_extensions(&mut schema);
+            jsonschema::validator_for(&schema).map_err(|_| Error::InvalidInput)
+        })
+        .as_ref()
+        .map_err(|e| *e)?;
+    if !validator.is_valid(&value) {
+        return Err(Error::InvalidInput);
+    }
+    let native: NativeScan = serde_json::from_value(value).map_err(|_| Error::InvalidInput)?;
+    native.validate().map_err(|_| Error::InvalidReference)?;
+    if !crate::assessment::valid_id(&native.run.id, "scan")
+        || native
+            .assets
+            .iter()
+            .any(|a| !crate::assessment::valid_id(&a.id, "asset"))
+        || native
+            .observations
+            .iter()
+            .any(|o| !crate::assessment::valid_id(&o.id, "observation"))
+    {
+        return Err(Error::InvalidReference);
+    }
+    if native.assets.len() > 16384
+        || native.observations.len() > 32768
+        || native.assets.iter().any(|a| a.relations.len() > 64)
+        || native.observations.iter().any(|o| o.asset_ids.len() > 64)
+    {
+        return Err(Error::ResourceLimit);
+    }
+    bounded::collection_timestamp(&native.run.generated_at)?;
+    let input = InputReference {
+        format: InputFormat::InventoryV1,
+        sha256: hash,
+        schema_version: 1,
+        collection_time: native.run.generated_at.clone(),
+        run_id: Some(native.run.id.clone()),
+        attempt_id: None,
+        protocol: None,
+    };
+    let index: BTreeMap<_, _> = native.assets.iter().map(|a| (a.id.as_str(), a)).collect();
+    let outcome = match native.coverage["status"].as_str() {
+        Some("complete_within_scope") => "complete",
+        Some("partial") => "partial",
+        _ => "unknown",
+    }
+    .to_string();
+    let mut occurrence_counts = BTreeMap::new();
+    for o in &native.observations {
+        if let Some(key) = &o.occurrence_key {
+            *occurrence_counts.entry(key.as_str()).or_insert(0usize) += 1;
+        }
+    }
+    let mut targets = vec![];
+    for observation in &native.observations {
+        let observation_facts = ObservationFacts {
+            method: bounded::vocabulary(
+                &observation.method,
+                &[
+                    "lexical_match",
+                    "ast_pattern",
+                    "configuration_match",
+                    "dependency_report",
+                    "private_key_marker",
+                    "certificate_parse",
+                    "legacy_adapter",
+                ],
+            ),
+            assurance: bounded::vocabulary(
+                &observation.assurance,
+                &["lexical", "syntactic", "parsed", "unknown"],
+            ),
+            usage: bounded::vocabulary(
+                &observation.usage,
+                &["referenced", "configured", "unknown"],
+            ),
+            collection_outcome: outcome.clone(),
+        };
+        let bindable = observation
+            .occurrence_key
+            .as_deref()
+            .is_none_or(|key| occurrence_counts[key] == 1)
+            && matches!(
+                observation.identity_confidence.as_str(),
+                "weak_structural_anchor" | "run_local_only"
+            )
+            && !observation
+                .asset_ids
+                .iter()
+                .any(|id| index[id.as_str()].attributes["ambiguous"] == true);
+        let path = observation
+            .target
+            .path
+            .as_deref()
+            .and_then(|p| crate::identity::relative_path(std::path::Path::new(""), p));
+        if observation.target.path.is_some() && path.is_none() {
+            return Err(Error::InvalidReference);
+        }
+        let base = SourceReference {
+            run_id: Some(native.run.id.clone()),
+            observation_id: Some(observation.id.clone()),
+            path,
+            line: observation.target.line,
+            ..Default::default()
+        };
+        let mut emitted = false;
+        for root_id in observation.asset_ids.iter().collect::<BTreeSet<_>>() {
+            let root = index[root_id.as_str()];
+            let mut roles = vec![];
+            match root.kind.as_str() {
+                "algorithm" => roles.push(("algorithm", Some(root), None)),
+                "public_key" => roles.push((
+                    "public-key.algorithm",
+                    related(root, "algorithm", "algorithm", &index),
+                    Some(root),
+                )),
+                "certificate" => {
+                    roles.push((
+                        "certificate.signature_algorithm",
+                        related(root, "signature_algorithm", "algorithm", &index),
+                        None,
+                    ));
+                    let key = related(root, "subject_key", "public_key", &index);
+                    roles.push((
+                        "certificate.subject_key.algorithm",
+                        key.and_then(|k| related(k, "algorithm", "algorithm", &index)),
+                        key,
+                    ));
+                }
+                _ => continue,
+            }
+            for (role, algorithm, key) in roles {
+                let (mut assessment, encoding) = algorithm
+                    .map(|a| facts(a, key))
+                    .unwrap_or((AlgorithmAssessment::unknown(), "unknown"));
+                if role == "certificate.signature_algorithm" {
+                    use crate::assessment::Purpose;
+                    if matches!(assessment.identifier.as_str(), "RSA" | "EC") {
+                        assessment.purpose = Purpose::Signature;
+                    }
+                    if !matches!(assessment.purpose, Purpose::Signature | Purpose::Unknown) {
+                        assessment
+                            .classical_concerns
+                            .push("certificate_signature_purpose_mismatch".into());
+                    }
+                }
+                let mut reference = base.clone();
+                reference.root_asset_id = Some(root.id.clone());
+                reference.role = role.into();
+                if root.kind == "certificate" {
+                    reference.certificate_sha256 = root.attributes["certificate_sha256"]
+                        .as_str()
+                        .map(str::to_owned);
+                    reference.not_before_unix = root.attributes["not_before_unix"].as_i64();
+                    reference.not_after_unix = root.attributes["not_after_unix"].as_i64();
+                }
+                if let Some(key) = key {
+                    reference.spki_sha256 =
+                        key.attributes["spki_sha256"].as_str().map(str::to_owned);
+                }
+                let mut t = target(
+                    &input,
+                    reference,
+                    assessment,
+                    observation_facts.clone(),
+                    encoding,
+                    None,
+                    bindable,
+                );
+                if algorithm.is_none() {
+                    t.limitations.push("unresolved_role".into());
+                    t.bindable = false;
+                }
+                targets.push(t);
+                emitted = true;
+                if targets.len() > 65536 {
+                    return Err(Error::ResourceLimit);
+                }
+            }
+        }
+        if !emitted {
+            let mut reference = base;
+            reference.role = "reference-only".into();
+            let roots: Vec<_> = observation
+                .asset_ids
+                .iter()
+                .filter_map(|id| index.get(id.as_str()).copied())
+                .filter(|a| a.kind == "dependency")
+                .collect();
+            if roots.len() == 1 {
+                reference.root_asset_id = Some(roots[0].id.clone());
+                reference.dependency_provenance = Some(bounded::vocabulary(
+                    roots[0].attributes["version_provenance"]
+                        .as_str()
+                        .unwrap_or("unknown"),
+                    &[
+                        "manifest_declared",
+                        "manifest_dev_declared",
+                        "manifest_peer_declared",
+                        "manifest_optional_declared",
+                        "workspace_declaration",
+                        "workspace_inherited",
+                        "path_dependency_unresolved",
+                        "git_dependency_unresolved",
+                        "archive_dependency_unresolved",
+                        "lock_resolved",
+                        "lock_record_unverified",
+                        "sbom_reported_unverified",
+                        "heuristic_declared",
+                        "heuristic_lock_unverified",
+                        "source_unresolved",
+                        "legacy_unclassified",
+                        "unavailable_or_unsafe_version_omitted",
+                    ],
+                ));
+            }
+            targets.push(target(
+                &input,
+                reference,
+                AlgorithmAssessment::unknown(),
+                observation_facts,
+                "unknown",
+                None,
+                bindable,
+            ));
+        }
+    }
+    Ok(SavedEvidence {
+        input,
+        targets,
+        collection_outcome: outcome,
+        file: None,
+    })
+}
+
+fn tolerate_extensions(schema: &mut Value) {
+    match schema {
+        Value::Object(map) => {
+            if map.get("additionalProperties") == Some(&Value::Bool(false)) {
+                map.remove("additionalProperties");
+            }
+            for value in map.values_mut() {
+                tolerate_extensions(value);
+            }
+        }
+        Value::Array(values) => {
+            for value in values {
+                tolerate_extensions(value);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn related<'a>(
+    asset: &CryptoAsset,
+    role: &str,
+    kind: &str,
+    index: &BTreeMap<&str, &'a CryptoAsset>,
+) -> Option<&'a CryptoAsset> {
+    let mut matches = asset.relations.iter().filter(|r| r.relationship == role);
+    let first = matches.next()?;
+    if matches.next().is_some() {
+        return None;
+    }
+    index
+        .get(first.target.as_str())
+        .copied()
+        .filter(|a| a.kind == kind)
+}
+
+fn facts(
+    algorithm: &CryptoAsset,
+    key: Option<&CryptoAsset>,
+) -> (AlgorithmAssessment, &'static str) {
+    let id = algorithm.attributes["identifier"].as_str().unwrap_or("");
+    let namespace = algorithm.attributes["namespace"].as_str().unwrap_or("");
+    let numeric = id.contains('.') && id.bytes().all(|b| b.is_ascii_digit() || b == b'.');
+    let draft =
+        id.starts_with("Kyber") || id.starts_with("Dilithium") || id == "X25519Kyber768Draft00";
+    if !((namespace == "oid" && numeric)
+        || (namespace == "draft" && draft)
+        || (namespace == "named" && !numeric && !draft))
+    {
+        return (AlgorithmAssessment::unknown(), "unknown");
+    }
+    let mut parameters: BTreeMap<String, String> = algorithm.attributes["parameters"]
+        .as_object()
+        .into_iter()
+        .flat_map(|m| m.iter())
+        .filter(|(k, _)| {
+            [
+                "key_bits",
+                "named_curve_oid",
+                "parameters_kind",
+                "parameter_interpretation",
+            ]
+            .contains(&k.as_str())
+        })
+        .filter_map(|(k, v)| Some((k.clone(), v.as_str()?.into())))
+        .collect();
+    if let Some(key) = key {
+        if let Some(bits) = key.attributes["key_bits"].as_u64() {
+            parameters.insert("key_bits".into(), bits.to_string());
+        }
+        if let Some(curve) = key.attributes["named_curve_oid"].as_str() {
+            parameters.insert("named_curve_oid".into(), curve.into());
+        }
+    }
+    let encoding = if namespace == "oid"
+        && parameters
+            .get("parameters_kind")
+            .is_some_and(|s| s == "absent" || s == "null" || s == "oid")
+        && parameters
+            .get("parameter_interpretation")
+            .is_none_or(|s| s != "not_available")
+    {
+        "known"
+    } else {
+        "unknown"
+    };
+    (assess_primitive(id, &parameters), encoding)
+}
diff --git a/crates/pqc_scan_core/src/migration/runtime.rs b/crates/pqc_scan_core/src/migration/runtime.rs
new file mode 100644
index 0000000..c516a2d
--- /dev/null
+++ b/crates/pqc_scan_core/src/migration/runtime.rs
@@ -0,0 +1,627 @@
+use super::{
+    assess_primitive, bounded, schema, target, technical, Error, InputFormat, InputReference,
+    ObservationFacts, RegistryFact, Result, SavedEvidence, SourceReference, Target,
+};
+use crate::{
+    assessment::{AlgorithmAssessment, Purpose},
+    target_policy::{ProbeHost, TargetRequest},
+};
+use serde_json::Value;
+use std::{
+    collections::BTreeMap,
+    net::{IpAddr, SocketAddr},
+};
+
+pub(super) fn project(value: Value, format: InputFormat, hash: String) -> Result<SavedEvidence> {
+    use std::sync::OnceLock;
+    static TLS: OnceLock<Result<jsonschema::Validator>> = OnceLock::new();
+    static OFFERS: OnceLock<Result<jsonschema::Validator>> = OnceLock::new();
+    static KEX: OnceLock<Result<jsonschema::Validator>> = OnceLock::new();
+    let (body, cache) = match format {
+        InputFormat::TlsV1 => (
+            include_str!("../../../../schemas/probe-tls-v1.schema.json"),
+            &TLS,
+        ),
+        InputFormat::SshOffersV1 => (
+            include_str!("../../../../schemas/probe-ssh-offers-v1.schema.json"),
+            &OFFERS,
+        ),
+        InputFormat::SshKexV1 => (
+            include_str!("../../../../schemas/probe-ssh-kex-v1.schema.json"),
+            &KEX,
+        ),
+        _ => return Err(Error::UnsupportedFormat),
+    };
+    // Detect contradictory success before shape rejection for a fixed error code.
+    contradiction_preflight(&value, format)?;
+    smaller_limits(&value, format)?;
+    schema(&value, body, cache)?;
+    envelope(&value)?;
+    let collection_time = string(&value["generated_at"])?;
+    bounded::collection_timestamp(collection_time)?;
+    let input = InputReference {
+        format,
+        sha256: hash,
+        schema_version: 1,
+        collection_time: collection_time.into(),
+        run_id: None,
+        attempt_id: Some(1),
+        protocol: Some(string(&value["protocol"])?.into()),
+    };
+    let targets = match format {
+        InputFormat::TlsV1 => tls(&value, &input)?,
+        InputFormat::SshOffersV1 => offers(&value, &input)?,
+        InputFormat::SshKexV1 => kex(&value, &input)?,
+        _ => return Err(Error::UnsupportedFormat),
+    };
+    Ok(SavedEvidence {
+        input,
+        targets,
+        collection_outcome: string(&value["outcome"])?.into(),
+        file: None,
+    })
+}
+
+fn string(value: &Value) -> Result<&str> {
+    value.as_str().ok_or(Error::InvalidInput)
+}
+
+fn smaller_limits(v: &Value, format: InputFormat) -> Result<()> {
+    let mut limits = vec![("/diagnostics", 32)];
+    if format == InputFormat::TlsV1 {
+        limits.extend([
+            ("/details/peer_certificates", 16),
+            ("/details/client_profile/protocol_versions", 2),
+            ("/details/client_profile/cipher_suites", 256),
+            ("/details/client_profile/key_exchange_groups", 64),
+        ]);
+    }
+    if limits.iter().any(|(path, limit)| {
+        v.pointer(path)
+            .and_then(Value::as_array)
+            .is_some_and(|items| items.len() > *limit)
+    }) {
+        return Err(Error::ResourceLimit);
+    }
+    if format == InputFormat::SshOffersV1 {
+        for offers in [
+            &v["details"]["offers"],
+            &v["details"]["client_profile"]["offers"],
+        ] {
+            if let Some(lists) = offers.as_object() {
+                for list in lists.values().filter_map(Value::as_array) {
+                    if list.len() > 256
+                        || list.iter().filter_map(Value::as_str).any(|s| s.len() > 64)
+                    {
+                        return Err(Error::ResourceLimit);
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
+fn contradiction_preflight(v: &Value, format: InputFormat) -> Result<()> {
+    let d = &v["details"];
+    let contradiction = match format {
+        InputFormat::TlsV1 => {
+            (!d["negotiated"].is_null() || d["handshake_complete"] == true)
+                && (v["outcome"] == "failed"
+                    || d["handshake_complete"] != true
+                    || d["verification"]["certificate_chain_and_name"] != "verified"
+                    || !matches!(
+                        d["handshake_kind"].as_str(),
+                        Some("full" | "full_with_hello_retry_request")
+                    ))
+        }
+        InputFormat::SshKexV1 => {
+            (!d["negotiated_kex"].is_null()
+                || !d["host_signature"].is_null()
+                || d["handshake_complete"] == true
+                || d["host_identity_verified"] == true)
+                && (v["outcome"] != "completed"
+                    || d["handshake_complete"] != true
+                    || d["host_identity_verified"] != true
+                    || d["user_authentication_attempted"] != false
+                    || d["host_authentication_pqc"] != false)
+        }
+        _ => false,
+    };
+    if contradiction {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    Ok(())
+}
+
+fn envelope(v: &Value) -> Result<()> {
+    let t = &v["target"];
+    let port = t["port"].as_u64().ok_or(Error::InvalidInput)? as u16;
+    TargetRequest::new(string(&t["host"])?, port).map_err(|_| Error::InvalidInput)?;
+    let answers = if let Some(values) = t["resolved_addresses"].as_array() {
+        values
+            .iter()
+            .map(|v| {
+                string(v)?
+                    .parse::<IpAddr>()
+                    .map_err(|_| Error::InvalidInput)
+            })
+            .collect::<Result<Vec<_>>>()?
+    } else {
+        vec![]
+    };
+    if answers.len()
+        > v["limits"]["max_dns_answers"]
+            .as_u64()
+            .ok_or(Error::InvalidInput)? as usize
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    let socket = |v: &Value| -> Result<Option<SocketAddr>> {
+        if v.is_null() {
+            Ok(None)
+        } else {
+            string(v)?
+                .parse()
+                .map(Some)
+                .map_err(|_| Error::InvalidInput)
+        }
+    };
+    let pinned = socket(&t["pinned_address"])?;
+    let peer = socket(&t["connected_peer"])?;
+    if pinned.is_some_and(|p| p.port() != port || !answers.contains(&p.ip()))
+        || peer.is_some_and(|p| Some(p) != pinned)
+        || (v["outcome"] == "completed" && peer.is_none())
+        || ((v["outcome"] == "completed")
+            != (v["diagnostics"].as_array().is_some_and(Vec::is_empty)))
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    for (traffic, cap) in [
+        ("received_bytes", "max_received_bytes"),
+        ("sent_bytes", "max_sent_bytes"),
+    ] {
+        let count = v["traffic"][traffic].as_u64().ok_or(Error::InvalidInput)?;
+        let limit = v["limits"][cap].as_u64().ok_or(Error::InvalidInput)?;
+        if count > limit || (count != 0 && peer.is_none()) {
+            return Err(Error::ContradictorySavedFacts);
+        }
+    }
+    Ok(())
+}
+
+const VERSIONS: &[(u16, &str)] = &[(771, "TLSv1_2"), (772, "TLSv1_3")];
+const SUITES: &[(u16, &str)] = &[
+    (4865, "TLS13_AES_128_GCM_SHA256"),
+    (4866, "TLS13_AES_256_GCM_SHA384"),
+    (4867, "TLS13_CHACHA20_POLY1305_SHA256"),
+    (0xc02b, "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"),
+    (0xc02c, "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384"),
+    (0xc02f, "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"),
+    (0xc030, "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384"),
+    (0xcca8, "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256"),
+    (0xcca9, "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256"),
+];
+fn registry(v: &Value, table: &[(u16, &str)]) -> Result<RegistryFact> {
+    let id = v["id"]
+        .as_u64()
+        .filter(|n| *n <= 65535)
+        .ok_or(Error::InvalidInput)? as u16;
+    let name = string(&v["name"])?;
+    let expected = table.iter().find(|(n, _)| *n == id).map(|(_, name)| *name);
+    if expected.is_some_and(|expected| name != expected)
+        || table.iter().any(|(n, known)| *known == name && *n != id)
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    Ok(RegistryFact {
+        id,
+        name: expected.unwrap_or("unknown").into(),
+    })
+}
+fn group(v: &Value) -> Result<(RegistryFact, &'static str, AlgorithmAssessment)> {
+    let id = v["id"]
+        .as_u64()
+        .filter(|n| *n <= 65535)
+        .ok_or(Error::InvalidInput)?;
+    let name = string(&v["name"])?;
+    let (expected, class, algorithm) = technical::tls_group(id);
+    if expected.is_some_and(|s| s != name)
+        || [23, 24, 29, 4587, 4588, 4589, 25497, 25498]
+            .iter()
+            .any(|n| *n != id && technical::tls_group(*n).0 == Some(name))
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    Ok((
+        RegistryFact {
+            id: id as u16,
+            name: expected.unwrap_or("unknown").into(),
+        },
+        class,
+        algorithm,
+    ))
+}
+
+fn tls(v: &Value, input: &InputReference) -> Result<Vec<Target>> {
+    let d = &v["details"];
+    let profile = &d["client_profile"];
+    let verification = &d["verification"];
+    let identity = TargetRequest::new(string(&verification["verification_name"])?, 1)
+        .map_err(|_| Error::InvalidInput)?;
+    let normalized = crate::probe::host_name(identity.host());
+    let expected_sni = if matches!(identity.host(), ProbeHost::Dns(_)) {
+        Some(normalized.as_str())
+    } else {
+        None
+    };
+    if verification["verification_name"] != normalized
+        || verification["sent_sni"].as_str() != expected_sni
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    if (verification["trust_source"] == "bundled_mozilla")
+        != (verification["trust_bundle_version"] == "1.0.11")
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+
+    for item in profile["protocol_versions"]
+        .as_array()
+        .ok_or(Error::InvalidInput)?
+    {
+        registry(item, VERSIONS)?;
+    }
+    for item in profile["cipher_suites"]
+        .as_array()
+        .ok_or(Error::InvalidInput)?
+    {
+        registry(item, SUITES)?;
+    }
+    for item in profile["key_exchange_groups"]
+        .as_array()
+        .ok_or(Error::InvalidInput)?
+    {
+        group(item)?;
+    }
+    let verified = d["handshake_complete"] == true
+        && d["verification"]["certificate_chain_and_name"] == "verified"
+        && matches!(
+            d["handshake_kind"].as_str(),
+            Some("full" | "full_with_hello_retry_request")
+        )
+        && !d["negotiated"].is_null()
+        && v["target"]["connected_peer"].is_string()
+        && matches!(v["outcome"].as_str(), Some("completed" | "partial"));
+    if (d["handshake_complete"] == true
+        || !d["negotiated"].is_null()
+        || d["verification"]["certificate_chain_and_name"] == "verified")
+        && !verified
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    if verified
+        && v["diagnostics"]
+            .as_array()
+            .ok_or(Error::InvalidInput)?
+            .iter()
+            .any(|d| {
+                !matches!(
+                    d.as_str(),
+                    Some(
+                        "group_unavailable"
+                            | "certificate_parse_incomplete"
+                            | "certificate_collection_limit"
+                    )
+                )
+            })
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    let mut reference = SourceReference {
+        attempt_id: Some(1),
+        role: "negotiated_key_establishment".into(),
+        detail_path: Some("/details/negotiated/key_exchange_group".into()),
+        ..Default::default()
+    };
+    let mut algorithm = AlgorithmAssessment::unknown();
+    if verified {
+        let n = &d["negotiated"];
+        let version = registry(&n["version"], VERSIONS)?;
+        let suite = registry(&n["cipher_suite"], SUITES)?;
+        if (version.id == 772
+            && SUITES.iter().any(|(id, _)| *id == suite.id)
+            && !(4865..=4867).contains(&suite.id))
+            || (version.id == 771 && (4865..=4867).contains(&suite.id))
+        {
+            return Err(Error::ContradictorySavedFacts);
+        }
+        for (selected, offered) in [
+            ("version", "protocol_versions"),
+            ("cipher_suite", "cipher_suites"),
+            ("key_exchange_group", "key_exchange_groups"),
+        ] {
+            if !n[selected].is_null()
+                && !profile[offered]
+                    .as_array()
+                    .ok_or(Error::InvalidInput)?
+                    .contains(&n[selected])
+            {
+                return Err(Error::ContradictorySavedFacts);
+            }
+        }
+        reference.protocol_version = Some(version);
+        reference.cipher_suite = Some(suite);
+        if !n["key_exchange_group"].is_null() {
+            let (fact, class, a) = group(&n["key_exchange_group"])?;
+            // Original collectors classified obsolete IDs as unknown. Preserve
+            // that saved vocabulary while the new mapping identifies the draft.
+            let legacy_draft_unknown =
+                matches!(fact.id, 25497 | 25498) && n["group_classification"] == "unknown";
+            if n["group_classification"] != class && !legacy_draft_unknown {
+                return Err(Error::ContradictorySavedFacts);
+            }
+            if reference
+                .protocol_version
+                .as_ref()
+                .is_some_and(|v| v.id != 772)
+                && class == "hybrid"
+            {
+                return Err(Error::ContradictorySavedFacts);
+            }
+            reference.key_exchange_group = Some(fact);
+            algorithm = a;
+        } else if n["group_classification"] != "unknown" {
+            return Err(Error::ContradictorySavedFacts);
+        }
+    }
+    let observation = ObservationFacts {
+        method: "tls_saved_observation".into(),
+        assurance: if verified {
+            "collector_reported_verified_session"
+        } else {
+            "unverified_or_incomplete"
+        }
+        .into(),
+        usage: if verified { "negotiated" } else { "unknown" }.into(),
+        collection_outcome: string(&v["outcome"])?.into(),
+    };
+    let mut targets = vec![target(
+        input,
+        reference,
+        algorithm,
+        observation.clone(),
+        "unknown",
+        Some("F07"),
+        true,
+    )];
+    let certificates = d["peer_certificates"]
+        .as_array()
+        .ok_or(Error::InvalidInput)?;
+    let collection = &d["certificate_collection"];
+    let count = certificates.len() as u64;
+    if collection["collected_count"] != count
+        || collection["presented_count"]
+            .as_u64()
+            .is_some_and(|n| n < count)
+        || (collection["status"] == "complete"
+            && (collection["presented_count"] != count || count == 0))
+        || (collection["status"] == "not_available" && count != 0)
+        || (collection["status"] == "complete"
+            && certificates
+                .iter()
+                .any(|c| c["attribute_status"] != "complete"))
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    for (i, cert) in certificates.iter().enumerate() {
+        if cert["attribute_status"] == "complete"
+            && [
+                "signature_oid",
+                "public_key_oid",
+                "spki_sha256",
+                "not_before_unix",
+                "not_after_unix",
+            ]
+            .iter()
+            .any(|k| cert[k].is_null())
+        {
+            return Err(Error::ContradictorySavedFacts);
+        }
+        let start = cert["not_before_unix"].as_i64();
+        let end = cert["not_after_unix"].as_i64();
+        if start.zip(end).is_some_and(|(s, e)| s > e) {
+            return Err(Error::ContradictorySavedFacts);
+        }
+        if cert["attribute_status"] == "unsupported_or_malformed"
+            && [
+                "signature_oid",
+                "public_key_oid",
+                "spki_sha256",
+                "key_bits",
+                "named_curve_oid",
+                "not_before_unix",
+                "not_after_unix",
+            ]
+            .iter()
+            .any(|k| !cert[k].is_null())
+        {
+            return Err(Error::ContradictorySavedFacts);
+        }
+        for (role, field) in [
+            ("certificate_signature", "signature_oid"),
+            ("certificate_subject_key", "public_key_oid"),
+        ] {
+            let mut parameters = BTreeMap::new();
+            if field == "public_key_oid" {
+                if let Some(bits) = cert["key_bits"].as_u64() {
+                    parameters.insert("key_bits".into(), bits.to_string());
+                }
+                if let Some(curve) = cert["named_curve_oid"].as_str() {
+                    parameters.insert("named_curve_oid".into(), curve.into());
+                }
+            }
+            let mut a = assess_primitive(cert[field].as_str().unwrap_or(""), &parameters);
+            if field == "signature_oid" && matches!(a.identifier.as_str(), "RSA" | "EC") {
+                a.purpose = Purpose::Signature;
+            }
+            if field == "signature_oid"
+                && !matches!(a.purpose, Purpose::Signature | Purpose::Unknown)
+            {
+                a.classical_concerns
+                    .push("certificate_signature_purpose_mismatch".into());
+            }
+            a.source_ids.push("F08".into());
+            let reference = SourceReference {
+                attempt_id: Some(1),
+                role: role.into(),
+                detail_path: Some(format!("/details/peer_certificates/{i}/{field}")),
+                certificate_sha256: cert["certificate_der_sha256"].as_str().map(str::to_owned),
+                spki_sha256: cert["spki_sha256"].as_str().map(str::to_owned),
+                not_before_unix: start,
+                not_after_unix: end,
+                ..Default::default()
+            };
+            let mut facts = observation.clone();
+            facts.method = "certificate_parse".into();
+            facts.assurance = if cert["attribute_status"] == "unsupported_or_malformed" {
+                "unknown"
+            } else {
+                "parsed"
+            }
+            .into();
+            facts.usage = "unknown".into();
+            if cert["attribute_status"] != "complete" {
+                facts.collection_outcome = "partial".into();
+            }
+            targets.push(target(
+                input,
+                reference,
+                a,
+                facts,
+                "unknown",
+                Some("F08"),
+                true,
+            ));
+        }
+    }
+    Ok(targets)
+}
+
+fn offers(v: &Value, input: &InputReference) -> Result<Vec<Target>> {
+    let d = &v["details"];
+    let present = !d["offers"].is_null();
+    if present != (d["assurance"] == "unauthenticated_advertisement")
+        || (present && v["target"]["connected_peer"].is_null())
+    {
+        return Err(Error::ContradictorySavedFacts);
+    }
+    let observation = ObservationFacts {
+        method: "ssh_saved_offers".into(),
+        assurance: if present {
+            "unauthenticated_advertisement"
+        } else {
+            "unverified_or_incomplete"
+        }
+        .into(),
+        usage: "unknown".into(),
+        collection_outcome: string(&v["outcome"])?.into(),
+    };
+    let mut targets = vec![];
+    if present {
+        for (field, host) in [
+            ("kex_algorithms", false),
+            ("server_host_key_algorithms", true),
+        ] {
+            for (i, name) in d["offers"][field]
+                .as_array()
+                .ok_or(Error::InvalidInput)?
+                .iter()
+                .enumerate()
+            {
+                let name = string(name)?;
+                if technical::marker(name) {
+                    continue;
+                }
+                let reference = SourceReference {
+                    attempt_id: Some(1),
+                    role: if host {
+                        "advertised_host_signature"
+                    } else {
+                        "advertised_key_establishment"
+                    }
+                    .into(),
+                    detail_path: Some(format!("/details/offers/{field}/{i}")),
+                    ..Default::default()
+                };
+                targets.push(target(
+                    input,
+                    reference,
+                    technical::ssh(name, host),
+                    observation.clone(),
+                    "unknown",
+                    Some("F09"),
+                    true,
+                ));
+            }
+        }
+    }
+    if targets.is_empty() {
+        targets.push(target(
+            input,
+            SourceReference {
+                attempt_id: Some(1),
+                role: "reference-only".into(),
+                detail_path: Some("/details/offers".into()),
+                ..Default::default()
+            },
+            AlgorithmAssessment::unknown(),
+            observation,
+            "unknown",
+            Some("F09"),
+            true,
+        ));
+    }
+    Ok(targets)
+}
+
+fn kex(v: &Value, input: &InputReference) -> Result<Vec<Target>> {
+    let completed = v["outcome"] == "completed";
+    let observation = ObservationFacts {
+        method: "ssh_saved_kex".into(),
+        assurance: if completed {
+            "collector_reported_verified_session"
+        } else {
+            "unverified_or_incomplete"
+        }
+        .into(),
+        usage: if completed { "negotiated" } else { "unknown" }.into(),
+        collection_outcome: string(&v["outcome"])?.into(),
+    };
+    let mut targets = vec![];
+    for (field, role, host) in [
+        ("negotiated_kex", "negotiated_key_establishment", false),
+        ("host_signature", "host_signature", true),
+    ] {
+        let a = if completed {
+            technical::ssh(string(&v["details"][field])?, host)
+        } else {
+            AlgorithmAssessment::unknown()
+        };
+        let reference = SourceReference {
+            attempt_id: Some(1),
+            role: role.into(),
+            detail_path: Some(format!("/details/{field}")),
+            ..Default::default()
+        };
+        targets.push(target(
+            input,
+            reference,
+            a,
+            observation.clone(),
+            "unknown",
+            Some(if host { "F09" } else { "F10" }),
+            true,
+        ));
+    }
+    Ok(targets)
+}
