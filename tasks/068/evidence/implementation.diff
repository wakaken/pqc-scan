+#[test]
+fn native_record_limits_accept_below_and_at_and_reject_above() {
+    for n in [63, 64, 65] {
+        let mut v = inventory("RSA");
+        v["assets"][0]["relations"] = json!(vec![
+            json!({"relationship":"future","target":v["assets"][0]["id"]});
+            n
+        ]);
+        assert_eq!(
+            ingest(&v, InputFormat::InventoryV1).is_ok(),
