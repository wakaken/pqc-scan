+.decision-card header { display:flex;justify-content:space-between;gap:16px;align-items:start; }
+.decision-card h3 { font-size:22px;margin:0;overflow-wrap:anywhere; }
+.role { font-weight:400;color:var(--muted);font-size:13px;margin-left:6px; }
+.migration-badge { flex-shrink:0;display:inline-block;font-size:12px;font-weight:650;padding:5px 10px;border:1px solid var(--border);border-radius:20px;color:var(--text); }
+.migration-badge.urgent { background:#fff1f0;color:#b42318;border-color:#f5b4ae; }
+.migration-badge.plan { background:#fff6e4;color:#7a5500;border-color:#e7cb8a; }
+.migration-location { color:var(--muted);font:12px/1.6 ui-monospace,monospace;overflow-wrap:anywhere;margin:10px 0; }
+.decision-status { display:flex;flex-wrap:wrap;gap:8px;color:var(--muted);font-size:12px;margin:14px 0 18px; }
+.decision-status span { border:1px solid var(--border);padding:4px 8px;border-radius:4px; }
+.response-box { padding:16px 18px;border-radius:6px;background:var(--bg);border-left:3px solid #0969da; }
+.response-box > p:first-child { color:var(--muted);font-size:12px;margin:0 0 6px; }
+.response-box h4 { font-size:20px;margin:0 0 8px; }
+.decision-reason { margin:0;line-height:1.8; }
+.decision-card h4 { margin-top:18px;margin-bottom:8px; }
+.response-box h4 { margin-top:0; }
+.decision-note { border-left:3px solid var(--border);padding:2px 14px;margin:18px 0; }
+.decision-note.blockers { border-left-color:var(--medium); }
+.decision-note ul { margin:8px 0; }
+.migration li { margin:6px 0; }
+.next-checks ol { padding-left:22px; }
+.candidate-section { padding-top:4px; }
+.muted { color:var(--muted); }
+.migration details { border-top:1px solid var(--border);margin-top:14px; }
+.migration summary { padding:14px 0;font-weight:600; }
+.migration summary span { color:var(--muted);font-size:12px;font-weight:400; }
+.detail-body { padding:0 0 12px; }
+.table-scroll { overflow-x:auto;max-width:100%; }
+.migration table { width:100%;border-collapse:collapse;font-size:13px; }
+.migration caption { text-align:left;color:var(--muted);padding:8px 0; }
