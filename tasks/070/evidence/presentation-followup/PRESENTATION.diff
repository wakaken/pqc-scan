+.migration-index a { display:block;padding:11px 0;border-top:1px solid var(--border);text-decoration:none; }
+.migration-index strong,.migration-index span { display:block;overflow-wrap:anywhere; }
+.migration-index span { color:var(--muted);font-size:12px;margin-top:5px; }
+.migration-results { min-width:0; }
+.decision-card { background:var(--card);border:1px solid var(--border);border-top:3px solid var(--info);border-radius:8px;padding:22px;margin-bottom:20px;scroll-margin-top:20px; }
+.decision-card.urgent { border-top-color:var(--critical); }
