{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "CSHARP_CRYPTO_API",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "C# cryptographic API or qualified library reference; effective key use requires verification."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CSHARP_CRYPTO_REFERENCE",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "C# TLS library or OQS wrapper reference; identity and runtime capability require separate checks."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "CSHARP_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "C# PQC or composite/HPKE reference; source alone does not establish platform support or active protection."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CSHARP_CRYPTO_API",
          "level": "warning",
          "message": {
            "text": "C# cryptographic API or qualified library reference; effective key use requires verification. | migration_hint=Review the resolved primitive and purpose, platform and provider. A .NET or Bouncy Castle source reference does not establish effective runtime use. | next_actions=Introduce crypto abstraction boundary for algorithm agility (near-term)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "api.cs"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
