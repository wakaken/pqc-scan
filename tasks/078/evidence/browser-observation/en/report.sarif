{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "PHP_CRYPTO_API",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "PHP cryptographic API or library reference; key type may be unresolved."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PHP_CRYPTO_REFERENCE",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "PHP OQS KEM wrapper reference; installation and selected algorithm are unresolved."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PHP_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "PHP PQC algorithm or X-Wing reference; runtime support requires verification."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PHP_CRYPTO_API",
          "level": "warning",
          "message": {
            "text": "PHP cryptographic API or library reference; key type may be unresolved. | migration_hint=Review the resolved primitive and purpose; PHP source alone does not establish loaded extensions, key type or active use. | next_actions=Introduce crypto abstraction boundary for algorithm agility (near-term)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "api.php"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Review the resolved primitive and purpose; PHP source alone does not establish loaded extensions, key type or active use.",
            "recommended_actions": [
              "Introduce crypto abstraction boundary for algorithm agility (near-term)"
            ]
          }
        },
        {
          "ruleId": "PHP_CRYPTO_REFERENCE",
          "level": "note",
          "message": {
            "text": "PHP OQS KEM wrapper reference; installation and selected algorithm are unresolved. | migration_hint=Identify the specific third-party OQS wrapper and native library. A qualified reference does not establish installation, algorithm selection or enabled functionality. | next_actions=Introduce crypto abstraction boundary for algorithm agility (near-term)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "api.php"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Identify the specific third-party OQS wrapper and native library. A qualified reference does not establish installation, algorithm selection or enabled functionality.",
            "recommended_actions": [
              "Introduce crypto abstraction boundary for algorithm agility (near-term)"
            ]
          }
        },
        {
          "ruleId": "PHP_PQC_API",
          "level": "note",
          "message": {
            "text": "PHP PQC algorithm or X-Wing reference; runtime support requires verification. | migration_hint=Verify the specific Sodium or ParagonIE implementation and version. X-Wing is distinct from standalone ML-KEM and TLS hybrids; source requests prove no runtime protection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "api.php"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Verify the specific Sodium or ParagonIE implementation and version. X-Wing is distinct from standalone ML-KEM and TLS hybrids; source requests prove no runtime protection."
          }
        },
        {
          "ruleId": "PHP_PQC_API",
          "level": "note",
          "message": {
            "text": "PHP PQC algorithm or X-Wing reference; runtime support requires verification. | migration_hint=Verify the specific Sodium or ParagonIE implementation and version. X-Wing is distinct from standalone ML-KEM and TLS hybrids; source requests prove no runtime protection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "api.php"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Verify the specific Sodium or ParagonIE implementation and version. X-Wing is distinct from standalone ML-KEM and TLS hybrids; source requests prove no runtime protection."
          }
        }
      ]
    }
  ]
}