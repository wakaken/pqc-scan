{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "API_JOSE_RSA_ALG",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "RSA-family JOSE algorithm detected."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "JWT_RS256",
              "shortDescription": {
                "text": "JWT"
              },
              "fullDescription": {
                "text": "RS256 algorithm name referenced; active signing and effective policy are not established."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "JWT_RS256",
          "level": "error",
          "message": {
            "text": "RS256 algorithm name referenced; active signing and effective policy are not established. | migration_hint=Confirm whether this reference belongs to active signing, verification, tests or documentation; assess JOSE formats and peer/library support before selecting PQC signatures. | next_actions=Adopt a phased hybrid PQC migration plan (near-term); Review whether the JOSE reference is used for signing, verification, tests or documentation (near-term)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "short.php"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 51
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Confirm whether this reference belongs to active signing, verification, tests or documentation; assess JOSE formats and peer/library support before selecting PQC signatures.",
            "recommended_actions": [
              "Adopt a phased hybrid PQC migration plan (near-term)",
              "Review whether the JOSE reference is used for signing, verification, tests or documentation (near-term)"
            ]
          }
        },
        {
          "ruleId": "API_JOSE_RSA_ALG",
          "level": "error",
          "message": {
            "text": "RSA-family JOSE algorithm detected. | migration_hint=Update JOSE algorithms to PQC-ready alternatives. | next_actions=Adopt a phased hybrid PQC migration plan (near-term); Introduce crypto abstraction boundary for algorithm agility (near-term)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "short.php"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 51
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Update JOSE algorithms to PQC-ready alternatives.",
            "recommended_actions": [
              "Adopt a phased hybrid PQC migration plan (near-term)",
              "Introduce crypto abstraction boundary for algorithm agility (near-term)"
            ]
          }
        }
      ]
    }
  ]
}