{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "PHP_CRYPTO_API",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "Bounded PHP primitive API or opaque signature-wrapper reference; generic keys remain unresolved."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PHP_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "Exact PHP PQC family and local receiver reference; parameters, provider and active use require separate evidence."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "TLS_RSA_CIPHER_SUITE",
              "shortDescription": {
                "text": "TLS"
              },
              "fullDescription": {
                "text": "RSA-based TLS cipher suite detected."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "TLS_RSA_KEY_EXCHANGE",
              "shortDescription": {
                "text": "TLS"
              },
              "fullDescription": {
                "text": "TLS RSA key-exchange suite detected."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "TLS_RSA_CIPHER_SUITE",
          "level": "error",
          "message": {
            "text": "RSA-based TLS cipher suite detected. | migration_hint=Identify static RSA key exchange versus RSA authentication in DHE/ECDHE suites; inspect active use before planning compatible hybrid key agreement and PQC authentication. | next_actions=Adopt a phased hybrid PQC migration plan (near-term); Review the TLS reference before changing effective settings (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "privacy.php"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 51
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Identify static RSA key exchange versus RSA authentication in DHE/ECDHE suites; inspect active use before planning compatible hybrid key agreement and PQC authentication.",
            "recommended_actions": [
              "Adopt a phased hybrid PQC migration plan (near-term)",
              "Review the TLS reference before changing effective settings (planned)"
            ]
          }
        },
        {
          "ruleId": "TLS_RSA_KEY_EXCHANGE",
          "level": "error",
          "message": {
            "text": "TLS RSA key-exchange suite detected. | migration_hint=Evaluate standardized hybrid key exchange such as X25519MLKEM768 with compatible peers; draft Kyber groups have different wire formats. | next_actions=Adopt a phased hybrid PQC migration plan (near-term); Review the TLS reference before changing effective settings (planned)"
          },
          "locations": [
