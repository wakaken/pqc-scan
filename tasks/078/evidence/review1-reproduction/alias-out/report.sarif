{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "PHP_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "Exact PHP PQC family and local receiver reference; parameters, provider and active use require separate evidence."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PHP_PQC_API",
          "level": "note",
          "message": {
            "text": "Exact PHP PQC family and local receiver reference; parameters, provider and active use require separate evidence. | migration_hint=Verify the specific Sodium or ParagonIE implementation and version. X-Wing is distinct from standalone ML-KEM and TLS hybrids; source requests prove no runtime protection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "alias.php"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Verify the specific Sodium or ParagonIE implementation and version. X-Wing is distinct from standalone ML-KEM and TLS hybrids; source requests prove no runtime protection."
          }
        }
      ]
    }
  ]
}