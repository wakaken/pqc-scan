{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "DEP_BOUNCYCASTLE",
              "shortDescription": {
                "text": "TLS"
              },
              "fullDescription": {
                "text": "BouncyCastle dependency detected."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "DEP_NUGET_CRYPTO",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "NuGet cryptographic package assertion; wrapper ownership and runtime support require verification."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "DEP_BOUNCYCASTLE",
          "level": "warning",
          "message": {
            "text": "BouncyCastle dependency detected. | migration_hint=Verify BouncyCastle PQC support status. | next_actions=Verify .NET target, package and operating-system support (planned); Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Directory.Packages.props"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Verify BouncyCastle PQC support status.",
            "recommended_actions": [
              "Verify .NET target, package and operating-system support (planned)",
              "Track PQC readiness of dependent libraries (planned)"
            ]
          }
        },
        {
          "ruleId": "DEP_BOUNCYCASTLE",
          "level": "warning",
          "message": {
            "text": "BouncyCastle dependency detected. | migration_hint=Verify BouncyCastle PQC support status. | next_actions=Verify .NET target, package and operating-system support (planned); Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "a.csproj"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Verify BouncyCastle PQC support status.",
            "recommended_actions": [
              "Verify .NET target, package and operating-system support (planned)",
              "Track PQC readiness of dependent libraries (planned)"
            ]
          }
        },
        {
          "ruleId": "DEP_NUGET_CRYPTO",
          "level": "note",
          "message": {
            "text": "NuGet cryptographic package assertion; wrapper ownership and runtime support require verification. | migration_hint=Check the exact NuGet package, target framework, runtime, OS and native backend. A lock record is not an installed runtime or enabled TLS provider. | next_actions=Verify .NET target, package and operating-system support (planned); Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Directory.Packages.props"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Check the exact NuGet package, target framework, runtime, OS and native backend. A lock record is not an installed runtime or enabled TLS provider.",
            "recommended_actions": [
              "Verify .NET target, package and operating-system support (planned)",
              "Track PQC readiness of dependent libraries (planned)"
            ]
          }
        },
        {
          "ruleId": "DEP_NUGET_CRYPTO",
          "level": "note",
          "message": {
            "text": "NuGet cryptographic package assertion; wrapper ownership and runtime support require verification. | migration_hint=Check the exact NuGet package, target framework, runtime, OS and native backend. A lock record is not an installed runtime or enabled TLS provider. | next_actions=Verify .NET target, package and operating-system support (planned); Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "a.csproj"
                },
                "region": {
