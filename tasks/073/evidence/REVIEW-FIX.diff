+#[path = "../../pqc_scan_core/tests/support/migration/mod.rs"]
+#[allow(dead_code)]
+mod fixture;
+use pqc_scan_core::migration::*;
+use serde_json::{json, Value};
+use std::{
+    path::PathBuf,
+    process::{Command, Output},
+    sync::atomic::{AtomicU64, Ordering},
+};
+const NOW: &str = "2026-11-18T00:00:00Z";
+struct Files(PathBuf);
+impl Files {
+    fn new() -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let p = std::env::temp_dir().join(format!(
+            "pqc-template073-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir_all(&p).unwrap();
+        Self(p)
+    }
+    fn input(&self, value: &Value) -> PathBuf {
+        let p = self.0.join("input.json");
+        std::fs::write(&p, serde_json::to_vec(value).unwrap()).unwrap();
+        p
+    }
+    fn run(&self, input: &std::path::Path, format: &str, extra: &[&str]) -> Output {
+        Command::new(env!("CARGO_BIN_EXE_pqc-scan"))
+            .arg("context-template")
+            .arg(input)
+            .args(["--input-format", format])
+            .args(extra)
+            .output()
+            .unwrap()
+    }
+}
+impl Drop for Files {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+fn ok(o: &Output) {
+    assert!(o.status.success(), "{}", String::from_utf8_lossy(&o.stderr));
+    assert!(o.stderr.is_empty());
+}
+#[test]
+fn actual_headless_cli_list_sparse_template_and_assess_roundtrip() {
+    let f = Files::new();
+    let input = f.input(&fixture::inventory("RSA"));
+    let original = std::fs::read(&input).unwrap();
+    let list = f.run(&input, "inventory-v1", &["--list-targets"]);
+    ok(&list);
+    let text = String::from_utf8(list.stdout).unwrap();
+    assert!(text.starts_with("1\tRSA\t"));
+    assert!(text.contains("app.txt"));
+    assert!(text.contains("selectable"));
+    let out = f.0.join("context.json");
+    ok(&f.run(
+        &input,
+        "inventory-v1",
+        &[
+            "--out",
+            out.to_str().unwrap(),
+            "--as-of",
+            NOW,
+            "--target",
+            "1",
+            "--set",
+            "usage_state=\"active\"",
+            "--set",
+            "business_critical=false",
+            "--unknown",
+            "confidential",
+            "--actor",
+            "owner",
+            "--asserted-at",
+            "2026-11-17T00:00:00Z",
+        ],
+    ));
+    let bytes = std::fs::read(&out).unwrap();
+    let v: Value = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(v["bindings"].as_array().unwrap().len(), 1);
+    assert_eq!(
+        v["bindings"][0]["claims"]["business_critical"]["value"],
+        false
+    );
+    assert_eq!(
+        v["bindings"][0]["claims"]["confidential"]["state"],
+        "unknown"
+    );
+    assert!(v["bindings"][0]["claims"].get("use_case").is_none());
+    let e = SavedEvidence::read(&input, InputFormat::InventoryV1).unwrap();
+    let c = MigrationContext::read(&out).unwrap();
+    let expected = evaluate(&e, Some(&c), NOW).unwrap();
+    let report = f.0.join("report");
+    let run = Command::new(env!("CARGO_BIN_EXE_pqc-scan"))
+        .arg("assess")
+        .arg(&input)
+        .args(["--input-format", "inventory-v1", "--context"])
+        .arg(&out)
+        .args(["--as-of", NOW, "--out-dir"])
+        .arg(&report)
+        .output()
+        .unwrap();
+    ok(&run);
+    let actual: Value = serde_json::from_slice(
+        &std::fs::read(report.join("migration.assessment.v1.json")).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(actual, serde_json::to_value(expected).unwrap());
+    assert_eq!(std::fs::read(input).unwrap(), original);
+}
+#[test]
+fn no_selection_is_unbound_and_each_adopted_format_works() {
+    let f = Files::new();
+    for (i, (v, format)) in [
+        (fixture::inventory("RSA"), "inventory-v1"),
+        (fixture::tls(), "tls-v1"),
+        (fixture::offers(), "ssh-offers-v1"),
+        (fixture::kex(), "ssh-kex-v1"),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let input = f.input(&v);
+        let out = f.0.join(format!("{i}.json"));
+        ok(&f.run(
+            &input,
+            format,
+            &["--out", out.to_str().unwrap(), "--as-of", NOW],
+        ));
+        let c: Value = serde_json::from_slice(&std::fs::read(&out).unwrap()).unwrap();
+        assert_eq!(c["bindings"], json!([]));
+        assert_eq!(c["systems"], json!([]));
+        ok(&f.run(
+            &input,
+            format,
+            &[
+                "--out",
+                out.to_str().unwrap(),
+                "--as-of",
+                NOW,
+                "--target",
+                "1",
+            ],
+        ));
+        let e = SavedEvidence::read(&input, format.parse().unwrap()).unwrap();
+        MigrationContext::read(&out).unwrap().bind(&e, NOW).unwrap();
+    }
+}
+#[test]
+fn invalid_answers_targets_and_times_leave_existing_output_untouched() {
+    let f = Files::new();
+    let input = f.input(&fixture::inventory("RSA"));
+    let out = f.0.join("keep.json");
+    std::fs::write(&out, b"KEEP").unwrap();
+    for args in [
+        vec!["--target", "0"],
+        vec!["--target", "999"],
+        vec!["--target", "1", "--target", "1"],
+        vec![
+            "--target",
+            "1",
+            "--set",
+            "business_critical=\"SECRET_CANARY_073\"",
+            "--actor",
+            "owner",
+            "--asserted-at",
+            NOW,
+        ],
+        vec!["--target", "1", "--unknown", "usage_state"],
+        vec!["--set", "usage_state=\"active\""],
+        vec![
+            "--target",
+            "1",
+            "--set",
+            "confidential=null",
+            "--actor",
+            "owner",
+            "--asserted-at",
+            NOW,
+        ],
+    ] {
+        let mut extra = vec!["--out", out.to_str().unwrap(), "--as-of", NOW];
+        extra.extend(args);
+        let o = f.run(&input, "inventory-v1", &extra);
+        assert_eq!(o.status.code(), Some(1));
+        assert!(!String::from_utf8_lossy(&o.stderr).contains("SECRET_CANARY_073"));
+        assert_eq!(std::fs::read(&out).unwrap(), b"KEEP");
+    }
+}
+#[test]
+fn output_name_inode_and_link_boundaries_preserve_input() {
+    let f = Files::new();
+    let input = f.input(&fixture::inventory("RSA"));
+    let original = std::fs::read(&input).unwrap();
+    let hard = f.0.join("hard.json");
+    std::fs::hard_link(&input, &hard).unwrap();
+    for out in [&input, &hard] {
+        let o = f.run(
+            &input,
+            "inventory-v1",
+            &[
+                "--out",
+                out.to_str().unwrap(),
+                "--as-of",
+                NOW,
+                "--target",
+                "1",
+            ],
+        );
+        assert_eq!(o.status.code(), Some(1));
+        assert!(String::from_utf8_lossy(&o.stderr).contains("unsafe_output"));
+    }
+    #[cfg(unix)]
+    {
+        let linked = f.0.join("link.json");
+        std::os::unix::fs::symlink(&input, &linked).unwrap();
+        assert!(!f
+            .run(
+                &input,
+                "inventory-v1",
+                &["--out", linked.to_str().unwrap(), "--as-of", NOW]
+            )
+            .status
+            .success());
+    }
+    assert_eq!(std::fs::read(&input).unwrap(), original);
+    assert_eq!(std::fs::read(hard).unwrap(), original);
+}
diff --git a/crates/pqc_scan_core/src/migration/generation.rs b/crates/pqc_scan_core/src/migration/generation.rs
new file mode 100644
index 0000000..d7d315f
--- /dev/null
+++ b/crates/pqc_scan_core/src/migration/generation.rs
@@ -0,0 +1,207 @@
+//! Generate the adopted context from explicit selections; never infer claims.
+use super::*;
+
+/// One explicitly supplied answer. `None` means explicit unknown, not omission.
+#[derive(Debug, Clone)]
+pub struct ClaimAnswer {
+    pub field: String,
+    pub value: Option<Value>,
+}
+
+/// Validated existing claim set, shared by headless and local UI callers.
+#[derive(Debug, Clone, Default)]
+pub struct ContextClaims(std::sync::Arc<ClaimSet>);
+impl ContextClaims {
+    pub fn from_answers(answers: &[ClaimAnswer], provenance: Provenance) -> Result<Self> {
+        if answers.len() > 18 {
+            return Err(Error::ResourceLimit);
+        }
+        let mut set = serde_json::Map::new();
+        let mut seen = BTreeSet::new();
+        for answer in answers {
+            if !seen.insert(&answer.field) {
+                return Err(Error::InvalidInput);
+            }
+            let claim = match &answer.value {
+                Some(value) => {
+                    serde_json::json!({"state":"known","value":value,"provenance":provenance})
+                }
+                None => serde_json::json!({"state":"unknown","provenance":provenance}),
+            };
+            if let Some(name) = answer.field.strip_prefix("support.") {
+                if !SUPPORT_NAMES.contains(&name) {
+                    return Err(Error::InvalidInput);
+                }
+                set.entry("support")
+                    .or_insert_with(|| serde_json::json!({}))
+                    .as_object_mut()
+                    .ok_or(Error::InvalidInput)?
+                    .insert(name.to_owned(), claim);
+            } else {
+                if answer.field == "support" {
+                    return Err(Error::InvalidInput);
+                }
+                set.insert(answer.field.clone(), claim);
+            }
+        }
+        Self::from_bytes(&serde_json::to_vec(&set).map_err(|_| Error::InvalidInput)?)
+    }
+
+    pub fn from_bytes(bytes: &[u8]) -> Result<Self> {
+        let value = bounded::parse(bytes, LIMIT)?;
+        reject_null(&value)?;
+        let mut claims: ClaimSet =
+            serde_json::from_value(value).map_err(|_| Error::InvalidInput)?;
+        validate_set(&mut claims, &BTreeSet::new())?;
+        Ok(Self(std::sync::Arc::new(claims)))
+    }
+}
+
+impl Provenance {
+    /// The caller supplies the assertion instant; absence of expiry stays unknown.
+    pub fn operator(actor: &str, asserted_at: &str, valid_until: Option<&str>) -> Result<Self> {
+        let mut result = Self {
+            source_kind: SourceKind::OperatorClaim,
+            actor_id: actor.to_owned(),
+            asserted_at: asserted_at.to_owned(),
+            valid_until: valid_until.map(str::to_owned),
+            reference_id: None,
+        };
+        provenance(&mut result, &BTreeSet::new())?;
+        Ok(result)
+    }
+}
+
+/// Zero-based index into the exact SavedEvidence target list, never an asset-wide match.
+#[derive(Debug, Clone)]
+pub struct ContextSelection {
+    pub target_index: usize,
+    pub system_id: String,
+    pub claims: ContextClaims,
+}
+
+pub fn generate_context(
+    evidence: &SavedEvidence,
+    organization_id: &str,
+    selections: &[ContextSelection],
+    as_of: &str,
+) -> Result<Vec<u8>> {
+    if selections.len() > 4096 {
+        return Err(Error::ResourceLimit);
+    }
+    let mut systems = BTreeSet::new();
+    let mut seen = BTreeSet::new();
+    let mut bindings = Vec::new();
+    let mut minimum_size = 0usize;
+    for selection in selections {
+        let target = evidence
+            .targets()
+            .get(selection.target_index)
+            .ok_or(Error::InvalidReference)?;
+        if !seen.insert(&target.id) {
+            return Err(Error::AmbiguousContextBinding);
+        }
+        if !target.bindable {
+            return Err(Error::AmbiguousContextBinding);
+        }
+        if selection.system_id.len() > 64 {
+            return Err(Error::ResourceLimit);
+        }
+        if !alias(&selection.system_id) {
+            return Err(Error::InvalidInput);
+        }
+        systems.insert(selection.system_id.clone());
+        if systems.len() > 256 {
+            return Err(Error::ResourceLimit);
+        }
+        let mut row = serde_json::to_value(Binding {
+            target_id: target.id.clone(),
+            system_id: selection.system_id.clone(),
+            claims: None,
+        })
+        .map_err(|_| Error::InvalidInput)?;
+        row["claims"] =
+            serde_json::to_value(selection.claims.0.as_ref()).map_err(|_| Error::InvalidInput)?;
+        omit_absent(&mut row);
+        // A lower bound cannot reject any valid final pretty representation.
+        // Check before retaining another row; shared claims never multiply upfront.
+        minimum_size = minimum_size
+            .checked_add(
+                serde_json::to_vec(&row)
+                    .map_err(|_| Error::InvalidInput)?
+                    .len(),
+            )
+            .filter(|n| *n <= LIMIT)
+            .ok_or(Error::ResourceLimit)?;
+        bindings.push(row);
+    }
+
+    let input = Input {
+        format: FORMAT.to_owned(),
+        version: 1,
+        input: InputBinding {
+            format: evidence.input().format,
+            sha256: evidence.input().sha256.clone(),
+        },
+        organization_id: organization_id.to_owned(),
+        systems: systems
+            .into_iter()
+            .map(|id| System { id, defaults: None })
+            .collect(),
+        bindings: Vec::new(),
+        organization_defaults: None,
+        references: Vec::new(),
+    };
+    let mut value = serde_json::to_value(&input).map_err(|_| Error::InvalidInput)?;
+    value["bindings"] = Value::Array(bindings);
+    let bytes = encode_value(value)?;
+    let context = MigrationContext::from_bytes(&bytes)?;
+    context.bind(evidence, as_of)?;
+    Ok(bytes)
+}
+
+fn omit_absent(value: &mut Value) {
+    match value {
+        Value::Object(map) => {
+            map.retain(|_, v| !v.is_null());
+            map.values_mut().for_each(omit_absent);
+        }
+        Value::Array(values) => values.iter_mut().for_each(omit_absent),
+        _ => {}
+    }
+}
+fn encode_value(mut value: Value) -> Result<Vec<u8>> {
+    struct Limited(Vec<u8>);
+    impl std::io::Write for Limited {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if self
+                .0
+                .len()
+                .checked_add(bytes.len())
+                .is_none_or(|n| n > LIMIT)
+            {
+                return Err(std::io::Error::other("resource_limit"));
+            }
+            self.0.extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    omit_absent(&mut value);
+    let mut output = Limited(Vec::new());
+    serde_json::to_writer_pretty(&mut output, &value).map_err(|_| Error::ResourceLimit)?;
+    Ok(output.0)
+}
+fn encode(input: &Input) -> Result<Vec<u8>> {
+    encode_value(serde_json::to_value(input).map_err(|_| Error::InvalidInput)?)
+}
+
+impl MigrationContext {
+    /// Export every supported field; typed validation has normalized timestamps.
+    /// Call bind against the selected evidence before applying imported context.
+    pub fn to_bytes(&self) -> Result<Vec<u8>> {
+        encode(&self.input)
+    }
+}
