+        generate_context(&e, "organization", &[invalid], ctx::AS_OF).unwrap_err(),
+        Error::InvalidReference
+    );
+    assert_eq!(
+        generate_context(&e, "INVALID alias", std::slice::from_ref(&s), ctx::AS_OF).unwrap_err(),
+        Error::InvalidInput
