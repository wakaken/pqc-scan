{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "API_EVP_PKEY_RSA",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "EVP_PKEY configured for RSA detected."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "API_JOSE_RSA_ALG",
              "shortDescription": {
                "text": "CryptoAPI"
              },
