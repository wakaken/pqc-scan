+        }
+    }
+    let hostile = format!("void f(void) {{ {} }}", "CONTROL();".repeat(3000));
+    let o = TreeSitterDetector::with_budget(DetectorBudget {
+        max_ast_nodes: 64,
+        ..Default::default()
+    })
+    .detect_detailed(&file("a.h", &hostile), &r.1)
+    .unwrap();
