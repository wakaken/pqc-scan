+#[test]
+fn large_unicode_header_keeps_locations_without_per_hit_prefix_scans() {
+    let r = Rules::new("c,cpp");
+    let prefix = "/* 💻 */".repeat(50_000);
+    let source = format!("{prefix}\nvoid f(void) {{ {} }}", "CONTROL();".repeat(2000));
