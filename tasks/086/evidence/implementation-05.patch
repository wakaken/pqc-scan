+#[test]
+fn recognized_calls_show_a_public_api_excerpt_without_their_arguments() {
+    for (ext, source, api) in [
+        (
+            "c",
+            "void f(){secp256k1_ecdsa_sign(ctx,sig,hash,key,nonce,data);}",
+            "secp256k1_ecdsa_sign",
+        ),
+        (
+            "cpp",
+            "void f(){EVP_PKEY_CTX_new_from_name(nullptr,\"RSA\",nullptr);}",
+            "EVP_PKEY_CTX_new_from_name",
+        ),
+        (
+            "cs",
+            "using System.Security.Cryptography; class C { void M(){ RSA.Create(); } }",
+            "Create",
+        ),
+        (
+            "php",
+            "<?php openssl_sign($data,$sig,$key);",
+            "openssl_sign",
+        ),
+    ] {
+        let doc = scan(source, ext);
+        let expected = format!("{api}(/* arguments omitted */)");
+        let found = doc
+            .legacy()
+            .findings
+            .iter()
+            .find(|f| f.evidence.r#match == expected)
+            .unwrap_or_else(|| panic!("{ext}: no readable public API excerpt"));
+        assert_eq!(found.evidence.snippet_preview, expected);
+        let snippet = found.source_snippet.as_ref().unwrap();
+        assert_eq!(snippet.lines.len(), 1);
+        assert_eq!(snippet.lines[0].line, found.location.line);
+        assert_eq!(snippet.lines[0].text, expected);
+        assert!(snippet.lines[0].highlighted);
+        assert!(!snippet.lines[0].text.contains("ctx,sig"));
+        assert!(doc.native().unwrap().validate().is_ok());
+    }
+}
