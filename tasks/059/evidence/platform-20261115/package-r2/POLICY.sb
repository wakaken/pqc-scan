(version 1)
(deny default)
(allow process* signal sysctl-read mach-lookup)
(allow file-read* (literal "/"))
(allow file-read-metadata)
(allow file-read* (subpath "/private/tmp/pqc056-native-1zmzv9hj/source") (subpath "/private/tmp/pqc056-native-1zmzv9hj/work") (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/opt/homebrew/Cellar") (subpath "/opt/homebrew/opt") (subpath "/Library/Developer") (subpath "/Applications/Xcode.app") (subpath "/private/etc") (subpath "/dev") (subpath "/Users/waka/.rustup/toolchains/1.93.1-aarch64-apple-darwin") (subpath "/Users/waka/.pyenv/versions/3.12.7") (subpath "/Users/waka/.cargo/registry") (subpath "/Users/waka/.cargo/git") (subpath "/private/var/db/xcode_select_link"))
(allow file-write* (subpath "/private/tmp/pqc056-native-1zmzv9hj/work") (literal "/dev/null"))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))