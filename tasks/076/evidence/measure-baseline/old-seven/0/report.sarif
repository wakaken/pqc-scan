        {
          "ruleId": "PQC_JAVA_API",
          "level": "note",
          "message": {
            "text": "Standard PQC algorithm requested through Java APIs; runtime success is not established. | migration_hint=JDK 24+ provides ML-KEM and ML-DSA; verify provider and protocol support independently."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
