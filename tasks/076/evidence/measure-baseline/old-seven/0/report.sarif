{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "PQC_GO_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "Standard Go PQC package imported; import alone does not prove negotiated protection."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PQC_JAVA_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "Standard PQC algorithm requested through Java APIs; runtime success is not established."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PQC_NODE_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "Node-style PQC key generation call; bindings and actual execution require confirmation."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PQC_PYTHON_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "Python PQC key generation reference; backend support is not established."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PQC_RUBY_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "Ruby PQC algorithm literal referenced; key generation or signing success is not established."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PQC_RUST_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "Rust PQC crate symbol referenced; execution and protocol use require confirmation."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PQC_STANDARD_REFERENCE",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "Standard PQC algorithm or hybrid group name referenced; API execution, enabled state and conformance are not established."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PQC_WEBCRYPTO_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "WebCrypto-style PQC algorithm request; this is not proof of browser support."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
