{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "API_OPENSSL_RSA_NEW",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "OpenSSL low-level RSA API usage detected."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "OPENSSL_RSA_API",
              "shortDescription": {
                "text": "TLS"
              },
              "fullDescription": {
                "text": "OpenSSL RSA API call detected."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "OPENSSL_RSA_API",
          "level": "error",
          "message": {
            "text": "OpenSSL RSA API call detected. | migration_hint=Replace with EVP_PKEY-based implementation suitable for PQC migration. | next_actions=Adopt a phased hybrid PQC migration plan (near-term); Review the TLS reference before changing effective settings (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "c-openssl-rsa_generate_key_ex-negative-comment.c"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 4
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Replace with EVP_PKEY-based implementation suitable for PQC migration.",
