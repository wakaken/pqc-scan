          "level": "warning",
          "message": {
            "text": "OpenSSL dependency detected. | migration_hint=Review the OpenSSL PQC roadmap. | next_actions=Verify C/C++ library, provider and build capabilities (planned); Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "vcpkg.json"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
