{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "columnKind": "unicodeCodePoints",
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "rules": [
            {
              "id": "CSHARP_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "C# PQC or composite/HPKE reference; source alone does not establish platform support or active protection."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "C_FAMILY_CRYPTO_API",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "C/C++ cryptographic API or configuration reference; effective primitive and runtime use require verification."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "C_FAMILY_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "C/C++ PQC source reference; requested parameter sets do not prove enabled mechanisms or active protection."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "DEP_BOUNCYCASTLE",
              "shortDescription": {
                "text": "TLS"
              },
              "fullDescription": {
                "text": "BouncyCastle dependency detected."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "DEP_NATIVE_CRYPTO",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "C/C++ cryptographic dependency or literal build reference; effective configuration is unknown."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "DEP_NUGET_CRYPTO",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "NuGet cryptographic package assertion; wrapper ownership and runtime support require verification."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "DEP_OPENSSL",
              "shortDescription": {
                "text": "TLS"
              },
              "fullDescription": {
                "text": "OpenSSL dependency detected."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "DEP_PHP_CRYPTO",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "PHP cryptographic dependency or platform declaration; installed capability is unknown."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "PHP_CRYPTO_API",
              "shortDescription": {
                "text": "CryptoAPI"
              },
              "fullDescription": {
                "text": "PHP cryptographic API or library reference; key type may be unresolved."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PHP_PQC_API",
              "shortDescription": {
                "text": "PQC"
              },
              "fullDescription": {
                "text": "PHP PQC algorithm or X-Wing reference; runtime support requires verification."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "DEP_BOUNCYCASTLE",
          "level": "warning",
          "message": {
            "text": "BouncyCastle dependency detected. | migration_hint=Verify BouncyCastle PQC support status. | next_actions=Verify .NET target, package and operating-system support (planned); Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages.lock.json"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Verify BouncyCastle PQC support status.",
            "recommended_actions": [
              "Verify .NET target, package and operating-system support (planned)",
              "Track PQC readiness of dependent libraries (planned)"
            ]
          }
        },
        {
          "ruleId": "PHP_CRYPTO_API",
          "level": "warning",
          "message": {
            "text": "PHP cryptographic API or library reference; key type may be unresolved. | migration_hint=Review the resolved primitive and purpose; PHP source alone does not establish loaded extensions, key type or active use. | next_actions=Verify PHP extensions and their native cryptographic backends (planned); Introduce crypto abstraction boundary for algorithm agility (near-term)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "rsa.php"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Review the resolved primitive and purpose; PHP source alone does not establish loaded extensions, key type or active use.",
            "recommended_actions": [
              "Verify PHP extensions and their native cryptographic backends (planned)",
              "Introduce crypto abstraction boundary for algorithm agility (near-term)"
            ]
          }
        },
        {
          "ruleId": "C_FAMILY_CRYPTO_API",
          "level": "warning",
          "message": {
            "text": "C/C++ cryptographic API or configuration reference; effective primitive and runtime use require verification. | migration_hint=Verify the primitive, purpose, linked provider and build configuration. A source request or provider/group setting does not establish runtime capability or negotiation. | next_actions=Verify C/C++ library, provider and build capabilities (planned); Introduce crypto abstraction boundary for algorithm agility (near-term)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "unknown.c"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "migration_hint": "Verify the primitive, purpose, linked provider and build configuration. A source request or provider/group setting does not establish runtime capability or negotiation.",
            "recommended_actions": [
              "Verify C/C++ library, provider and build capabilities (planned)",
              "Introduce crypto abstraction boundary for algorithm agility (near-term)"
            ]
          }
        },
