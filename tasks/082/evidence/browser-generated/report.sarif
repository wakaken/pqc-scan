          "ruleId": "DEP_PHP_CRYPTO",
          "level": "note",
          "message": {
            "text": "PHP cryptographic dependency or platform declaration; installed capability is unknown. | migration_hint=Check the declared PHP package or platform requirement, loaded extension and linked native library separately; platform emulation is not deployment evidence. | next_actions=Verify PHP extensions and their native cryptographic backends (planned); Track PQC readiness of dependent libraries (planned)"
          },
          "locations": [
